page {
  --paper: #F7F1E8;
  --paper-light: #FFFDF8;
  --ink: #2B2825;
  --muted: #817970;
  --line: #DED4C8;
  --red: #BD4E4E;
  --red-soft: #F3DEDA;
  --green: #557263;
  --green-soft: #DCE7DC;
  --gold: #B4813C;
  min-height: 100%;
  color: var(--ink);
  background: var(--paper);
  font-family: "STKaiti", "KaiTi", "PingFang SC", serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, image, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; border-radius: 0; font-family: inherit; }
button::after { border: 0; }

.page { min-height: 100vh; padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.page--plain { background: var(--paper-light); }
.eyebrow { color: var(--red); font: 600 20rpx/1.2 sans-serif; letter-spacing: 5rpx; text-transform: uppercase; }
.display-title { margin-top: 14rpx; font-size: 58rpx; line-height: 1.15; font-weight: 700; letter-spacing: 2rpx; }
.section-title { font-size: 36rpx; font-weight: 700; line-height: 1.3; }
.section-note { margin-top: 10rpx; color: var(--muted); font: 24rpx/1.65 sans-serif; }
.card { background: var(--paper-light); border: 2rpx solid var(--line); border-radius: 28rpx; box-shadow: 0 12rpx 30rpx rgba(70, 53, 40, .06); }
.soft-card { background: rgba(255,253,248,.72); border: 2rpx solid rgba(222,212,200,.9); border-radius: 24rpx; }
.primary-button, .secondary-button, .danger-button {
  display: flex; align-items: center; justify-content: center; width: 100%; min-height: 92rpx;
  border-radius: 46rpx; font: 600 28rpx/1 sans-serif; letter-spacing: 1rpx;
}
.primary-button { color: #FFF; background: var(--red); box-shadow: 0 12rpx 24rpx rgba(189,78,78,.2); }
.secondary-button { color: var(--ink); background: var(--paper-light); border: 2rpx solid var(--line); }
.danger-button { color: #FFF; background: #8F3F3F; }
.text-button { color: var(--red); font: 600 26rpx/1 sans-serif; background: transparent; }
.button-row { display: flex; gap: 20rpx; }
.button-row > button { flex: 1; }
.chip { display: inline-flex; align-items: center; justify-content: center; min-height: 54rpx; padding: 0 24rpx; border: 2rpx solid var(--line); border-radius: 28rpx; color: var(--muted); background: var(--paper-light); font: 24rpx/1 sans-serif; }
.chip--active { color: var(--red); border-color: var(--red); background: var(--red-soft); }
.tag { display: inline-flex; padding: 8rpx 16rpx; border-radius: 20rpx; background: #EEE7DC; color: #6F655C; font: 21rpx/1 sans-serif; }
.form-label { display: block; margin-bottom: 14rpx; font: 600 24rpx/1.2 sans-serif; color: #554E48; }
.input, .textarea { width: 100%; padding: 24rpx 26rpx; border-radius: 20rpx; background: #FFFDF8; border: 2rpx solid var(--line); font: 28rpx/1.6 sans-serif; }
.textarea { min-height: 210rpx; }
.muted { color: var(--muted); }
.divider { height: 2rpx; background: var(--line); }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.press:active { opacity: .72; transform: scale(.985); }
