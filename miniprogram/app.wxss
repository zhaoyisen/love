page {
  --paper: #F7EDE2;
  --paper-deep: #EEDBCD;
  --paper-light: #FFF9F2;
  --surface: rgba(255, 249, 242, .94);
  --surface-soft: rgba(255, 249, 242, .76);
  --ink: #2D2425;
  --ink-soft: #554547;
  --muted: #7D6C69;
  --muted-light: #A18E89;
  --line: #E3CEC2;
  --line-strong: #D3B7A8;
  --red: #B94E5A;
  --red-deep: #923C4A;
  --red-soft: #F4D8D8;
  --green: #6F7B62;
  --green-soft: #E1E6D8;
  --gold: #D88759;
  --sunset: #E49A6A;
  --dusk: #665060;
  --shadow-card: 0 18rpx 42rpx rgba(90, 55, 56, .10);
  --shadow-float: 0 24rpx 52rpx rgba(93, 55, 60, .18);

  min-height: 100%;
  max-width: 100vw;
  overflow-x: hidden;
  color: var(--ink);
  background:
    radial-gradient(circle at 86% -4%, rgba(228, 154, 106, .22), transparent 32%),
    radial-gradient(circle at 8% 12%, rgba(185, 78, 90, .10), transparent 28%),
    linear-gradient(180deg, #FBF2E8 0%, #F5E8DF 52%, #F1E3DC 100%);
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
image,
video,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  min-width: 0;
  border-radius: 0;
  overflow: visible;
  color: inherit;
  background: transparent;
  font-family: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

.page {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  padding: 34rpx 32rpx calc(168rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.page--plain {
  background: var(--paper-light);
}

.eyebrow {
  display: block;
  color: var(--red);
  font: 700 20rpx/1.2 "PingFang SC", sans-serif;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.display-title {
  display: block;
  margin-top: 12rpx;
  color: var(--ink);
  font: 800 54rpx/1.16 "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  letter-spacing: -.8rpx;
}
.display-title > text { display: block; }
.ticket-title > text { display: block; }

.section-title {
  display: block;
  color: var(--ink);
  font: 800 36rpx/1.32 "PingFang SC", sans-serif;
  letter-spacing: -.3rpx;
}

.section-note {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font: 24rpx/1.68 "PingFang SC", sans-serif;
}

.card {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 30rpx;
  box-shadow: var(--shadow-card);
}

.soft-card {
  background: var(--surface-soft);
  border: 2rpx solid rgba(221, 209, 196, .88);
  border-radius: 26rpx;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 94rpx;
  padding: 22rpx 30rpx;
  border-radius: 26rpx;
  font: 700 28rpx/1.3 "PingFang SC", sans-serif;
  letter-spacing: .5rpx;
  text-align: center;
  white-space: nowrap;
}

.primary-button {
  color: #FFF8F1;
  background: linear-gradient(135deg, #C95F62 0%, #A84454 58%, #76505E 100%);
  box-shadow: 0 16rpx 34rpx rgba(155, 58, 73, .24);
}

.secondary-button {
  color: var(--ink);
  background: rgba(255, 253, 248, .92);
  border: 2rpx solid var(--line-strong);
  box-shadow: 0 8rpx 20rpx rgba(73, 55, 40, .05);
}

.danger-button {
  color: #FFF8F1;
  background: #84393A;
}

.primary-button[disabled],
.secondary-button[disabled],
.danger-button[disabled] {
  opacity: .58;
  box-shadow: none;
}

.text-button {
  color: var(--red);
  font: 700 26rpx/1 "PingFang SC", sans-serif;
  background: transparent;
}

.button-row {
  display: flex;
  gap: 18rpx;
  width: 100%;
}

.button-row > button {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--muted);
  background: rgba(255, 253, 248, .86);
  font: 24rpx/1 "PingFang SC", sans-serif;
  white-space: nowrap;
}

.sweet-detail-page .detail-tags { flex-wrap: wrap; }
.sweet-detail-page .comment-delete { display: flex; align-items: center; justify-content: center; min-width: 82rpx; min-height: 72rpx; padding: 0 12rpx; }

.chip--active {
  color: var(--red-deep);
  border-color: rgba(183, 70, 72, .56);
  background: var(--red-soft);
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  color: #655B51;
  background: #EDE5DB;
  font: 21rpx/1 "PingFang SC", sans-serif;
  white-space: nowrap;
}

.form-label {
  display: block;
  margin-bottom: 14rpx;
  color: #554D45;
  font: 700 24rpx/1.2 "PingFang SC", sans-serif;
}

.input,
.textarea {
  width: 100%;
  padding: 24rpx 26rpx;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  color: var(--ink);
  background: rgba(255, 253, 248, .94);
  font: 28rpx/1.6 "PingFang SC", sans-serif;
}

.textarea {
  min-height: 220rpx;
}

.muted {
  color: var(--muted);
}

.divider {
  height: 2rpx;
  background: var(--line);
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.press {
  transition:
    transform 180ms cubic-bezier(.22, 1, .36, 1),
    opacity 180ms ease,
    background-color 180ms ease,
    border-color 180ms ease;
}

.press:active {
  opacity: .82;
  transform: scale(.975);
}

.status-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  width: 100%;
  margin: 22rpx 0;
  padding: 20rpx 22rpx;
  border: 2rpx solid #C4D5C9;
  border-radius: 22rpx;
  color: #3F5E4D;
  background: rgba(238, 246, 238, .88);
  font-size: 24rpx;
  line-height: 1.5;
}

.status-banner > text {
  flex: 1;
  min-width: 0;
}

.status-banner button {
  flex: 0 0 auto;
  min-width: 96rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 2rpx solid #B4C9BA;
  border-radius: 999rpx;
  color: #3F5E4D;
  background: #FAF7EF;
  font-size: 23rpx;
}

.status-banner--error {
  color: #823D3D;
  border-color: #DFC1BC;
  background: #F8E8E4;
}

.status-banner--error button {
  color: #823D3D;
  border-color: #D5AAA4;
}

.couple-skeleton {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 520rpx;
  gap: 18rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.couple-skeleton view {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: linear-gradient(100deg, #E8DFD4 25%, #F8F1E8 45%, #E8DFD4 65%);
  background-size: 300% 100%;
  animation: skeleton-shift 1.4s ease-in-out infinite;
}

.couple-skeleton view + view {
  width: 260rpx;
  height: 28rpx;
  border-radius: 14rpx;
}

.couple-page .memory-prompt {
  border: 2rpx solid #D7C49B !important;
  border-radius: 22rpx !important;
}

.invite-page .confirm-rules {
  border: 2rpx solid #B8CCBD !important;
  border-radius: 22rpx !important;
}

.detail-page .hero video {
  width: 100%;
  height: 100%;
}

.detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  gap: 22rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.detail-loading view {
  width: 84rpx;
  height: 84rpx;
  border: 6rpx solid #E2D7CB;
  border-top-color: var(--red);
  border-radius: 50%;
  animation: detail-spin 1s linear infinite;
}

.processing-cover {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  z-index: 2;
  padding: 22rpx;
  border-radius: 20rpx;
  color: #FFF;
  background: rgba(43, 40, 37, .78);
}

.processing-cover text {
  display: block;
  font-size: 23rpx;
}

.processing-cover text:last-child {
  margin-top: 8rpx;
  color: #EDE5DB;
  font-size: 20rpx;
}

.detail-error {
  padding-top: 60rpx;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin-top: 26rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 999rpx;
  color: var(--green);
  background: rgba(255, 253, 248, .86);
  font-size: 24rpx;
}

@keyframes skeleton-shift {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

@keyframes detail-spin {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .press,
  .press:active {
    transition: none;
    transform: none;
  }

  .couple-skeleton view,
  .detail-loading view {
    animation: none;
  }
}
