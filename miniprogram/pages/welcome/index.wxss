/* Hallmark · genre: editorial · macrostructure: Conversational FAQ · design-system: DESIGN.md · designed-as-app
 * tone: warm, private, lived-in · enrichment: none · nav: custom safe-area · footer: none
 * pre-emit critique: P5 H5 E5 S5 R5 V5 · slop-test: pass (58/58; locked native type) · contrast: pass (40–41)
 * honest: pass (46) · chrome: pass (47) · tokens: pass (48) · responsive: pass (49) · icons: pass (30) · mobile: pass (34, 49–57)
 */

.welcome-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  overflow-x: clip;
  color: var(--color-ink);
  background: var(--color-paper);
}

.welcome-header {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  width: 100%;
  padding-left: var(--page-gutter);
}

.brand-rule {
  flex: 0 0 auto;
  width: var(--rule-strong);
  height: var(--space-xl);
  border-radius: var(--radius-pill);
  background: var(--color-accent);
}

.brand-copy {
  min-width: 0;
}

.brand-name,
.brand-note {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brand-name {
  font-size: var(--text-list-title);
  font-weight: var(--weight-bold);
  line-height: var(--line-list-title);
}

.brand-note {
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.welcome-main {
  width: 100%;
  padding: var(--space-2xl) var(--page-gutter) 0;
}

.welcome-intro {
  min-width: 0;
}

.welcome-kicker {
  display: block;
  color: var(--color-accent-strong);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  line-height: var(--line-meta);
}

.welcome-title {
  min-width: 0;
  margin-top: var(--space-xs);
  font-size: var(--text-page-title);
  font-weight: var(--weight-bold);
  line-height: var(--line-page-title);
  overflow-wrap: anywhere;
}

.welcome-title text {
  display: block;
}

.welcome-note {
  display: block;
  max-width: var(--state-content-max-width);
  margin-top: var(--space-lg);
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  line-height: var(--line-body);
  word-break: break-word;
}

.welcome-questions {
  width: 100%;
  margin-top: var(--space-2xl);
  border-top: var(--rule-thin) solid var(--color-rule);
  border-bottom: var(--rule-thin) solid var(--color-rule);
}

.welcome-question {
  padding: var(--space-lg) 0;
}

.welcome-question + .welcome-question {
  border-top: var(--rule-thin) solid var(--color-rule);
}

.question-copy {
  min-width: 0;
}

.question-title,
.question-answer {
  display: block;
  word-break: break-word;
}

.question-title {
  color: var(--color-ink);
  font-size: var(--text-list-title);
  font-weight: var(--weight-semibold);
  line-height: var(--line-list-title);
}

.question-answer {
  margin-top: var(--space-xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
}

.welcome-actions {
  width: 100%;
  margin-top: auto;
  padding: var(--space-xl) var(--page-gutter) calc(var(--space-lg) + constant(safe-area-inset-bottom));
  padding: var(--space-xl) var(--page-gutter) calc(var(--space-lg) + env(safe-area-inset-bottom));
  border-top: var(--rule-thin) solid var(--color-rule);
  color: var(--color-ink);
  background: var(--color-surface);
}

.welcome-actions .status-banner {
  margin: 0 0 var(--space-md);
  text-align: left;
}

.welcome-actions .status-banner button:active {
  background: var(--color-surface-muted);
}

.welcome-actions .status-banner button.is-pressed {
  background: var(--color-surface-muted);
}

.welcome-actions .status-banner button[disabled] {
  color: var(--color-disabled-ink);
  border-color: var(--color-rule);
  background: var(--color-disabled-bg);
  opacity: var(--opacity-disabled);
}

.agreement {
  display: flex;
  align-items: flex-start;
  gap: var(--space-xs);
  width: 100%;
  min-height: var(--touch-target);
  padding: var(--space-sm) 0;
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.agreement:focus-visible {
  outline: var(--rule-strong) solid var(--color-focus);
  outline-offset: var(--space-3xs);
}

.press.is-pressed {
  opacity: var(--opacity-pressed);
  transform: scale(var(--press-scale));
}

.primary-button.is-pressed {
  background: var(--color-accent-strong);
}

.primary-button[disabled].is-pressed {
  color: var(--color-disabled-ink);
  background: var(--color-disabled-bg);
  opacity: var(--opacity-disabled);
  transform: none;
}

.checkbox {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: var(--space-xl);
  height: var(--space-xl);
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-sm);
  color: var(--color-accent-ink);
  background: var(--color-surface);
  font-size: var(--text-meta);
  font-weight: var(--weight-bold);
  line-height: 1;
}

.checkbox.checked {
  border-color: var(--color-shared);
  background: var(--color-shared);
}

.agreement-copy {
  flex: 1;
  min-width: 0;
  padding-top: var(--space-3xs);
  word-break: break-word;
}

.agreement-link {
  color: var(--color-accent-strong);
  font-weight: var(--weight-semibold);
  white-space: nowrap;
}

.welcome-privacy {
  display: block;
  margin-top: var(--space-sm);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  text-align: left;
  word-break: break-word;
}

@media (max-height: 680px) {
  .welcome-main {
    padding-top: var(--space-xl);
  }

  .welcome-note {
    margin-top: var(--space-sm);
  }

  .welcome-questions {
    margin-top: var(--space-xl);
  }

  .welcome-question {
    padding: var(--space-md) 0;
  }

  .welcome-actions {
    padding-top: var(--space-md);
  }
}

@media (prefers-reduced-motion: reduce) {
  .press.is-pressed {
    transform: none;
  }
}
