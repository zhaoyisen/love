.preview-page{min-height:100vh;background:#EDE2D4}.story-cover{position:relative;height:880rpx;padding:70rpx 46rpx;color:#FFF;background:#496357;overflow:hidden}.story-cover::after{content:'';position:absolute;inset:30rpx;border:2rpx solid rgba(255,255,255,.4)}.story-kicker{position:relative;z-index:2;font:20rpx/1 sans-serif;letter-spacing:4rpx}.story-title{position:relative;z-index:2;display:block;margin-top:250rpx;font-size:65rpx;font-weight:700;line-height:1.25}.story-count{position:absolute;z-index:2;left:48rpx;bottom:70rpx;color:rgba(255,255,255,.75);font:22rpx/1 sans-serif}.story-orbits{position:absolute;width:540rpx;height:500rpx;right:-180rpx;top:50rpx}.story-orbits .decor{position:absolute;inset:30rpx 100rpx;border:3rpx solid rgba(255,255,255,.35);border-radius:50%;transform:rotate(35deg)}.story-orbits .decor:nth-child(2){inset:120rpx 15rpx;transform:rotate(-45deg)}.story-body{padding:60rpx 32rpx calc(45rpx + env(safe-area-inset-bottom));background:#F7F1E8}.story-item{position:relative;margin-bottom:80rpx;padding-top:34rpx;border-top:2rpx solid #CFC2B4}.story-no{position:absolute;right:0;top:-8rpx;color:#BD4E4E;font:30rpx/1 Georgia,serif}.story-photo{position:relative;height:620rpx;padding:20rpx;background:linear-gradient(145deg,#DDB8A1,#766060)}.story-photo image{width:100%;height:100%}.story-photo>text{position:absolute;left:40rpx;bottom:35rpx;color:#FFF;font:20rpx/1 sans-serif;letter-spacing:2rpx}.tone-lake{background:linear-gradient(145deg,#B9D0CB,#59747A)}.item-title{display:block;margin-top:28rpx;font-size:39rpx;font-weight:700}.item-copy{display:block;margin-top:16rpx;color:#5F5851;font:26rpx/1.8 sans-serif}.story-end{padding:55rpx 20rpx;text-align:center;border-top:2rpx solid #CFC2B4;border-bottom:2rpx solid #CFC2B4}.story-end text,.story-end .label{display:block}.story-end text{color:#BD4E4E;font-size:39rpx;font-weight:700}.story-end .label{margin-top:14rpx;color:#817970;font:23rpx/1 sans-serif}.disclosure-button{width:100%;display:flex;align-items:center;justify-content:space-between;margin-top:42rpx;padding:24rpx;border:2rpx solid #D8CCBE;border-radius:22rpx;text-align:left;background:#FFFDF8}.disclosure-button view text,.disclosure-button view .label{display:block}.disclosure-button view text{font:25rpx/1 sans-serif}.disclosure-button view .label{margin-top:8rpx;color:#817970;font:19rpx/1 sans-serif}.disclosure-list{padding:23rpx;border-radius:0 0 20rpx 20rpx;background:#EEF3ED}.disclosure-list text{display:block;margin:8rpx 0;color:#57665D;font:20rpx/1.55 sans-serif}.preview-actions{display:flex;gap:15rpx;margin-top:28rpx}.preview-actions button{flex:1}.preview-actions button:first-child{flex:.7}
