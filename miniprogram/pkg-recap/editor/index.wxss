.editor-page{padding-bottom:calc(150rpx + env(safe-area-inset-bottom))}.display-title{display:block;font-size:46rpx}.title-field{margin-top:38rpx}.safety-note{margin-top:24rpx;padding:23rpx;border-left:6rpx solid #557263;background:#EEF3ED}.safety-note text,.safety-note .label{display:block}.safety-note text{color:#466052;font:23rpx/1 sans-serif}.safety-note .label{margin-top:10rpx;color:#637068;font:21rpx/1.55 sans-serif}.chapter{margin-top:40rpx}.chapter-head{display:flex;align-items:flex-end;justify-content:space-between;padding-bottom:18rpx;border-bottom:2rpx solid #D8CCBE}.chapter-head view{display:flex;align-items:baseline;gap:16rpx}.chapter-head view text{color:#BD4E4E;font:26rpx/1 Georgia,serif}.chapter-head view .label{font-size:34rpx;font-weight:700}.chapter-head>text{color:#817970;font:20rpx/1 sans-serif}.candidate{position:relative;width:100%;display:flex;gap:18rpx;margin-top:18rpx;padding:14rpx;border:2rpx solid #D8CCBE;border-radius:22rpx;text-align:left;background:#FFFDF8}.candidate.selected{border-color:#BD4E4E;background:#FCF0EC}.candidate-art{position:relative;width:155rpx;height:180rpx;flex:none;border-radius:14rpx;overflow:hidden;background:linear-gradient(145deg,#DDB8A1,#7B6664)}.candidate-art image{width:100%;height:100%}.candidate-art>text{position:absolute;left:10rpx;bottom:10rpx;color:#FFF;font:16rpx/1 sans-serif}.tone-lake{background:linear-gradient(145deg,#B9D0CB,#59747A)}.candidate-copy{min-width:0;flex:1;padding:10rpx 30rpx 8rpx 0}.candidate-copy text,.candidate-copy .label,.candidate-copy .small{display:block}.candidate-copy text{font-size:27rpx;font-weight:700;line-height:1.3}.candidate-copy .label{display:-webkit-box;margin-top:10rpx;overflow:hidden;color:#6F675F;font:21rpx/1.5 sans-serif;-webkit-line-clamp:2;-webkit-box-orient:vertical}.candidate-copy .small{margin-top:13rpx;color:#817970;font:18rpx/1 sans-serif}.select-mark{position:absolute;right:13rpx;top:13rpx;display:flex;align-items:center;justify-content:center;width:38rpx;height:38rpx;border-radius:50%;color:#FFF;background:#A99D90;font:21rpx/1 sans-serif}.selected .select-mark{background:#BD4E4E}.preview-button{position:fixed;z-index:20;left:32rpx;right:32rpx;bottom:calc(30rpx + env(safe-area-inset-bottom));width:calc(100% - 64rpx)}
