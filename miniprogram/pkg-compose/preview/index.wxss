.preview-page{padding-bottom:calc(50rpx + env(safe-area-inset-bottom))}.preview-heading .display-title{display:block;margin-top:18rpx;font-size:45rpx}.preview-card{overflow:hidden;margin-top:32rpx;border:2rpx solid #D8CCBE;border-radius:28rpx;background:#FFFDF8;box-shadow:0 18rpx 42rpx rgba(68,50,37,.1)}.preview-media{position:relative;height:470rpx;padding:22rpx;background:#E8D7C1}.preview-media image,.preview-art{width:100%;height:100%;background:linear-gradient(150deg,#D9B39D,#9D706B 58%,#60545C)}.preview-media>text{position:absolute;left:44rpx;bottom:38rpx;color:#FFF;font:20rpx/1 sans-serif;letter-spacing:3rpx}.preview-content{padding:30rpx}.preview-date{color:#BD4E4E;font:20rpx/1 sans-serif;letter-spacing:2rpx}.preview-title{display:block;margin-top:16rpx;font-size:36rpx;font-weight:700;line-height:1.35}.preview-copy{display:block;margin-top:14rpx;color:#625B54;font:26rpx/1.75 sans-serif;white-space:pre-wrap}.preview-tags{display:flex;gap:10rpx;margin-top:22rpx}.disclosure-card{margin:24rpx 0;padding:10rpx 26rpx;border:2rpx solid #D8CCBE;border-radius:22rpx;background:rgba(255,253,248,.72)}.disclosure-card>view{display:flex;align-items:center;gap:18rpx;padding:19rpx 0;border-bottom:2rpx solid #EEE6DB}.disclosure-card>view:last-child{border-bottom:0}.disclosure-icon{color:#557263;font:28rpx/1 Georgia,serif}.disclosure-card view view text,.disclosure-card view view .label{display:block}.disclosure-card view view text{font:24rpx/1 sans-serif}.disclosure-card view view .label{margin-top:7rpx;color:#817970;font:20rpx/1 sans-serif}
.upload-panel{margin:0 0 24rpx;padding:22rpx 24rpx;border:2rpx solid #D8CCBE;border-radius:22rpx;background:#FFFDF8}.upload-heading,.upload-row{display:flex;align-items:center;justify-content:space-between}.upload-heading{padding-bottom:16rpx;border-bottom:2rpx solid #EEE6DB;font-size:23rpx}.upload-heading text:last-child{color:#817970;font-size:20rpx}.upload-row{justify-content:flex-start;gap:16rpx;padding-top:18rpx}.upload-row text{display:block;font-size:23rpx}.upload-row .label{margin-top:7rpx;color:#817970;font-size:20rpx;line-height:1.35}.upload-state{flex:0 0 auto;width:18rpx;height:18rpx;border-radius:50%;background:#B7AA9E}.upload-state.UPLOADING{background:#B4813C}.upload-state.PROCESSING{background:#557263}.upload-state.FAILED{background:#BD4E4E}
