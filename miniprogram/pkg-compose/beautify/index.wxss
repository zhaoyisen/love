.beautify-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.beautify-head{display:flex;align-items:flex-end;justify-content:space-between}.beautify-head .display-title{display:block;font-size:46rpx}.preview-frame{position:relative;height:740rpx;margin-top:34rpx;padding:28rpx;border:16rpx solid #EFD7B9;background:#FCF2E4;box-shadow:0 20rpx 45rpx rgba(67,48,35,.14);overflow:hidden}.preview-frame image,.preview-image{width:100%;height:100%;background:linear-gradient(155deg,#DDB8A1,#AD7770 58%,#68585F)}.sun{position:absolute;width:180rpx;height:180rpx;right:85rpx;top:120rpx;border-radius:50%;background:rgba(255,225,181,.36)}.horizon{position:absolute;left:-30rpx;right:-30rpx;bottom:180rpx;height:120rpx;border-top:3rpx solid rgba(255,255,255,.55);transform:rotate(-8deg)}.frame-line{position:absolute;inset:34rpx;border:2rpx solid rgba(255,255,255,.75)}.frame-kicker{position:absolute;left:50rpx;top:48rpx;color:#FFF;font:20rpx/1 sans-serif;letter-spacing:4rpx}.frame-date{position:absolute;right:50rpx;top:48rpx;color:#FFF;font:20rpx/1 Georgia,serif}.frame-copy{position:absolute;left:54rpx;right:54rpx;bottom:58rpx;color:#FFF;font-size:32rpx;line-height:1.35;text-shadow:0 2rpx 8rpx rgba(0,0,0,.25)}.toggle-row{display:flex;gap:10rpx;margin-top:22rpx}.toggle{padding:17rpx 19rpx;border-radius:25rpx;color:#817970;background:#EEE7DC;font:20rpx/1 sans-serif}.toggle.on{color:#456050;background:#DCE7DC}.template-scroll{width:calc(100% + 64rpx);margin:34rpx -32rpx 0}.template-list{display:inline-flex;gap:16rpx;padding:0 32rpx}.template-item{width:154rpx;text-align:left;background:transparent;color:#625B54;font:21rpx/1 sans-serif}.template-item>text{display:block;margin-top:10rpx}.template-thumb{height:180rpx;padding:10rpx;display:flex;align-items:flex-end;border:5rpx solid #DBC7AB;background:linear-gradient(145deg,#D6A994,#705A5D);color:#FFF;font:15rpx/1 sans-serif;letter-spacing:2rpx}.template-item.active .template-thumb{outline:5rpx solid #BD4E4E;outline-offset:4rpx}.berry{border-color:#E7A8A4}.moon{border-color:#9AAEC0;background:linear-gradient(145deg,#879BAC,#354451)}.retro{border-width:14rpx 14rpx 32rpx;border-color:#F1E7D8}.travel{border-style:dashed;border-color:#B68A64}.minimal{border-color:#FFF;background:linear-gradient(145deg,#CBC7BE,#7B7B75)}.safe-note{display:block;margin-top:26rpx;color:#817970;font:20rpx/1.65 sans-serif}.done-button{margin-top:28rpx}
