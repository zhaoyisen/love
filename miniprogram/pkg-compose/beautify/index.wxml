<view class="page beautify-page">
  <view class="beautify-head"><view><text class="eyebrow">TEMPLATE STUDIO</text><text class="display-title">给照片一点温度</text></view><button class="text-button" bindtap="reset">还原原图</button></view>
  <view class="preview-frame">
    <image wx:if="{{previewPath}}" src="{{previewPath}}" mode="aspectFill"></image><image wx:elif="{{draft.media[0].path}}" src="{{draft.media[0].path}}" mode="aspectFill"></image><view wx:else class="preview-image"><view class="sun"></view><view class="horizon"></view></view>
    <block wx:if="{{!previewPath}}"><view class="frame-wash"></view><view class="frame-line"></view><text class="frame-kicker">{{draft.template}}</text><text wx:if="{{showDate}}" class="frame-date">{{layoutLabel}}</text><text wx:if="{{showCopy}}" class="frame-copy">{{draft.title || '今天也有值得记住的小事'}}</text><text wx:if="{{sticker !== 'none'}}" class="frame-sticker">{{sticker === 'flower' ? '✿' : sticker === 'heart' ? '♡' : '✦'}}</text></block>
  </view>
  <view class="toggle-row"><button class="toggle {{showDate ? 'on' : ''}}" bindtap="toggleDate">日期 {{showDate ? '开' : '关'}}</button><button class="toggle {{showCopy ? 'on' : ''}}" bindtap="toggleCopy">配文 {{showCopy ? '开' : '关'}}</button><button class="toggle" bindtap="cycleSticker">贴纸 · {{sticker === 'flower' ? '小花' : sticker === 'heart' ? '爱心' : sticker === 'star' ? '星星' : '无'}}</button></view>
  <view class="crop-card"><view><text>画面裁剪</text><text class="label">{{cropScale}}% · 发布时按此比例生成</text></view><slider min="80" max="160" value="{{cropScale}}" activeColor="#BD4E4E" backgroundColor="#E5D8C8" bindchange="cropChange" /></view>
  <scroll-view scroll-x class="template-scroll" show-scrollbar="false"><view class="template-list"><button wx:for="{{templates}}" wx:key="id" class="template-item {{selected === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="select"><view class="template-thumb {{item.color}}"><text>{{item.mark}}</text></view><text>{{item.name}}</text></button></view></scroll-view>
  <text class="safe-note">{{layoutLabel}}会在发布时真实导出并上传模板图，原图始终保留。若生成失败，可重试或直接发布原图。</text>
  <canvas id="templateRenderCanvas" type="2d" class="template-render-canvas"></canvas>
  <button class="primary-button done-button press" bindtap="done">使用「{{draft.template}}」</button>
</view>
