.compose-page { padding-bottom: calc(54rpx + env(safe-area-inset-bottom)); }
.compose-head { width:100%;display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx }.compose-head>view{flex:1;min-width:0}.compose-head .display-title{display:block;font-size:50rpx}.draft-status{flex:0 1 auto;width:auto;min-width:0;max-width:48%;padding:16rpx 18rpx;border-radius:20rpx;color:#557263;background:#DCE7DC;font:20rpx/1.25 sans-serif;white-space:nowrap}
.stepper { width:100%;display:flex;align-items:center;margin-top:34rpx;padding:24rpx 0;border-top:2rpx solid #D8CCBE;border-bottom:2rpx solid #D8CCBE;overflow:hidden;box-sizing:border-box }.step{flex:0 0 auto;display:flex;align-items:center;gap:8rpx;color:#A69A8F;font:20rpx/1.2 sans-serif;white-space:nowrap}.step-number{flex:0 0 35rpx;display:flex;align-items:center;justify-content:center;width:35rpx;height:35rpx;border-radius:50%;border:2rpx solid #B9ADA0;font:18rpx/1 Georgia,serif;box-sizing:border-box}.step.active{color:#2B2825}.step.active .step-number{color:#FFF9F4;border-color:#BD4E4E;background:#BD4E4E}.stepper .decor{flex:1 1 auto;min-width:12rpx;height:2rpx;margin:0 10rpx;background:#D8CCBE}
.compose-section{width:100%;margin-top:42rpx;overflow:hidden}.compose-section>.section-title,.compose-section>.section-note{display:block}.media-type-grid{width:100%;display:flex;gap:14rpx;margin-top:26rpx}.media-type{flex:1 1 0;width:0;min-width:0;max-width:none;height:150rpx;padding:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;border:2rpx solid #D8CCBE;border-radius:22rpx;color:#605850;background:#FFFDF8;font:25rpx/1.2 sans-serif;box-sizing:border-box}.media-type.active{border-color:#BD4E4E;background:#F3DEDA;color:#9B3F3F}.media-type .label{color:#948A80;font:19rpx/1.2 sans-serif}.type-icon{font:34rpx/1 Georgia,serif}
.media-picker{width:100%;margin-top:28rpx}.media-grid{width:100%;display:flex;flex-wrap:wrap;gap:12rpx}.media-item,.add-media{position:relative;flex:0 0 calc((100% - 24rpx)/3);width:calc((100% - 24rpx)/3);min-width:0;max-width:none;height:210rpx;border-radius:18rpx;overflow:hidden;box-sizing:border-box}.media-item image,.media-item video,.mock-media{width:100%;height:100%;background:linear-gradient(145deg,#D4B39B,#9A6B64)}.media-item button{position:absolute;right:7rpx;top:7rpx;width:38rpx;min-width:38rpx;height:38rpx;padding:0;border-radius:50%;color:#FFF9F4;background:rgba(43,40,37,.7);font:25rpx/38rpx sans-serif}.media-state{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;min-height:46rpx;color:#FFF9F4;background:rgba(43,40,37,.76);font:20rpx/1 sans-serif}.add-media{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;border:2rpx dashed #BDAE9E;color:#817970;background:rgba(255,253,248,.6)}.add-media text{font:38rpx/1 sans-serif}.add-media .label{font:21rpx/1 sans-serif}.media-tip{display:block;margin-top:16rpx;color:#817970;font:20rpx/1.6 sans-serif}.text-mode-card{position:relative;margin-top:30rpx;padding:52rpx 36rpx;border:2rpx solid #D8CCBE;border-radius:24rpx;background:#FFFDF8;text-align:center}.text-mode-card>text{position:absolute;left:26rpx;top:10rpx;color:#D9B2AA;font:72rpx/1 Georgia,serif}.text-mode-card .label{color:#665E57;font-size:29rpx;line-height:1.8}.next-button{margin-top:38rpx}
.form-field{margin-bottom:38rpx}.label-row{display:flex;justify-content:space-between;color:#958B81;font:21rpx/1 sans-serif}.chip-list{display:flex;flex-wrap:wrap;gap:12rpx}.picker-row{display:flex;justify-content:space-between;padding:25rpx;border:2rpx solid #DED4C8;border-radius:20rpx;background:#FFFDF8;font:25rpx/1 sans-serif}.picker-row text:last-child{color:#BD4E4E}.backfill-note{display:block;margin-top:10rpx;color:#B4813C;font:21rpx/1 sans-serif}.visibility-option{width:100%;display:flex;align-items:center;justify-content:space-between;margin-top:12rpx;padding:24rpx;border:2rpx solid #DED4C8;border-radius:20rpx;text-align:left;background:#FFFDF8}.visibility-option.active{border-color:#557263;background:#EEF3ED}.visibility-option.disabled{opacity:.5}.visibility-option view text,.visibility-option view .label{display:block}.visibility-option view text{font:27rpx/1.2 sans-serif}.visibility-option view .label{margin-top:9rpx;color:#817970;font:20rpx/1.3 sans-serif}.visibility-option>text{color:#557263}.beautify-entry{width:100%;display:flex;align-items:center;gap:18rpx;margin:4rpx 0 36rpx;padding:20rpx;border:2rpx solid #D7C7B8;border-radius:22rpx;text-align:left;background:#FFF8ED}.beautify-entry>view:nth-child(2){flex:1}.beautify-entry text,.beautify-entry .label{display:block}.beautify-entry .label{margin-top:8rpx;color:#817970;font:20rpx/1 sans-serif}.beautify-entry>text{color:#BD4E4E;font:22rpx/1 sans-serif}.template-mini{width:74rpx;height:74rpx;border:9rpx solid #F0D0B3;background:linear-gradient(145deg,#D8A296,#7B7571)}.compose-actions{margin-top:8rpx}.compose-actions button:first-child{flex:.55}
