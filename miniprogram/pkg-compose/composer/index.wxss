/* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V5
 * macrostructure: Narrative Workflow · genre: editorial · theme: 暖昏生活胶片 · enrichment: user media · nav: native · footer: none
 * contrast: pass (40–41) · slop: pass (42–45) · honest: pass (46) · chrome: pass (47) · tokens: pass (48) · responsive: pass (49) · icons: pass (30) · mobile: pass (34, 49, 50–57)
 */

.compose-page {
  padding-top: var(--space-lg);
  padding-bottom: calc(var(--space-2xl) + env(safe-area-inset-bottom));
}

.compose-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-lg);
}

.compose-heading {
  flex: 1;
  min-width: 0;
}

.compose-title,
.compose-copy,
.workflow-step,
.workflow-title,
.workflow-note,
.storage-note-label,
.storage-note-copy,
.media-tip,
.text-mode-title,
.text-mode-copy,
.form-helper,
.backfill-note,
.visibility-title,
.visibility-note,
.optional-tool-title,
.optional-tool-note,
.submit-note {
  display: block;
}

.compose-title {
  color: var(--color-ink);
  font-size: var(--text-page-title);
  font-weight: var(--weight-bold);
  line-height: var(--line-page-title);
  letter-spacing: 0;
  overflow-wrap: anywhere;
}

.compose-copy {
  max-width: var(--state-content-max-width);
  margin-top: var(--space-sm);
  color: var(--color-ink-secondary);
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
}

.draft-status {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: var(--space-2xs);
  min-height: var(--line-secondary);
  max-width: 42%;
  color: var(--color-success);
  font-size: var(--text-meta);
  font-weight: var(--weight-medium);
  line-height: var(--line-meta);
}

.draft-status text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draft-status-dot {
  flex: 0 0 auto;
  width: var(--space-xs);
  height: var(--space-xs);
  border-radius: var(--radius-round);
  background: var(--color-success);
}

.workflow-section {
  margin-top: var(--space-2xl);
  padding-top: var(--space-xl);
  border-top: var(--rule-thin) solid var(--color-rule);
}

.workflow-section--first {
  margin-top: var(--space-2xl);
}

.workflow-head {
  max-width: var(--state-content-max-width);
  margin-bottom: var(--space-xl);
}

.workflow-step {
  color: var(--color-accent-strong);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  line-height: var(--line-meta);
}

.workflow-title {
  margin-top: var(--space-2xs);
  color: var(--color-ink);
  font-size: var(--text-section-title);
  font-weight: var(--weight-bold);
  line-height: var(--line-section-title);
  overflow-wrap: anywhere;
}

.workflow-note {
  margin-top: var(--space-xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
}

.record-type-list,
.media-type-grid {
  display: flex;
  align-items: stretch;
  gap: var(--space-xs);
}

.record-type,
.capture-type {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  min-height: calc(var(--touch-target) + var(--space-lg));
  padding: var(--space-sm) var(--space-2xs);
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-md);
  color: var(--color-ink-secondary);
  background: var(--color-surface);
  text-align: center;
}

.record-type-name,
.record-type-note,
.record-type-state {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-type-name {
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
  line-height: var(--line-body);
}

.record-type-note,
.record-type-state {
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.record-type-state {
  color: var(--color-accent-strong);
  font-weight: var(--weight-semibold);
}

.record-type.is-selected {
  color: var(--color-accent-strong);
  border-color: var(--color-accent-strong);
  background: var(--color-accent-soft);
}

.record-type[disabled] {
  color: var(--color-disabled-ink);
  border-color: var(--color-rule);
  background: var(--color-disabled-bg);
  opacity: var(--opacity-disabled);
}

.storage-note {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  margin-top: var(--space-lg);
  padding: var(--space-md) 0;
  border-top: var(--rule-thin) solid var(--color-rule);
  border-bottom: var(--rule-thin) solid var(--color-rule);
}

.storage-note-label {
  flex: 0 0 auto;
  color: var(--color-info);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  line-height: var(--line-meta);
  white-space: nowrap;
}

.storage-note-copy {
  flex: 1;
  min-width: 0;
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.media-picker {
  margin-top: var(--space-lg);
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.media-item,
.add-media {
  position: relative;
  flex: 0 0 calc((100% - var(--space-xs) - var(--space-xs)) / 3);
  width: calc((100% - var(--space-xs) - var(--space-xs)) / 3);
  min-width: 0;
  height: calc(var(--touch-target) + var(--touch-target) + var(--space-lg));
  overflow: hidden;
  border-radius: var(--radius-lg);
}

.media-item {
  background: var(--color-surface-muted);
}

.media-item image,
.media-item video,
.mock-media {
  width: 100%;
  height: 100%;
  background: var(--color-surface-muted);
}

.remove-media {
  position: absolute;
  top: 0;
  right: 0;
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  padding: 0 var(--space-sm);
  color: var(--color-surface);
  background: var(--color-overlay);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  line-height: var(--line-meta);
  white-space: nowrap;
}

.media-state {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--space-2xl);
  padding: var(--space-2xs) var(--space-xs);
  color: var(--color-surface);
  background: var(--color-overlay);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  text-align: center;
}

.media-state--error {
  color: var(--color-error);
  background: var(--color-error-bg);
}

.add-media {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2xs);
  padding: var(--space-md);
  border: var(--rule-thin) dashed var(--color-ink-secondary);
  color: var(--color-accent-strong);
  background: transparent;
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
  line-height: var(--line-body);
  text-align: center;
}

.add-media > text {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-media-note {
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  font-weight: var(--weight-regular);
  line-height: var(--line-meta);
}

.media-grid.is-empty .add-media {
  flex: 1 1 100%;
  width: 100%;
  height: 142rpx;
  flex-direction: row;
}

.media-tip {
  margin-top: var(--space-sm);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.text-mode-note {
  margin-top: var(--space-lg);
  padding: var(--space-lg) 0;
  border-top: var(--rule-thin) solid var(--color-rule);
  border-bottom: var(--rule-thin) solid var(--color-rule);
}

.text-mode-title {
  color: var(--color-ink);
  font-size: var(--text-list-title);
  font-weight: var(--weight-semibold);
  line-height: var(--line-list-title);
}

.text-mode-copy {
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
}

.form-item {
  margin-bottom: var(--space-xl);
}

.field-count {
  flex: 0 0 auto;
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  white-space: nowrap;
}

.compose-textarea {
  min-height: var(--textarea-min-height);
}

.form-helper--before {
  margin-top: var(--space-2xs);
  margin-bottom: var(--space-sm);
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.date-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-lg);
  min-height: var(--touch-target);
  padding: var(--space-sm) 0;
  border-top: var(--rule-thin) solid var(--color-rule);
  border-bottom: var(--rule-thin) solid var(--color-rule);
}

.date-value {
  min-width: 0;
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: var(--weight-medium);
  line-height: var(--line-body);
  font-variant-numeric: tabular-nums;
}

.date-action {
  flex: 0 0 auto;
  color: var(--color-accent-strong);
  font-size: var(--text-secondary);
  font-weight: var(--weight-semibold);
  line-height: var(--line-secondary);
  white-space: nowrap;
}

.backfill-note {
  margin-top: var(--space-xs);
  color: var(--color-warning);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.visibility-list {
  border-top: var(--rule-thin) solid var(--color-rule);
}

.visibility-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-lg);
  width: 100%;
  min-height: calc(var(--touch-target) + var(--space-lg));
  padding: var(--space-md) 0;
  border-bottom: var(--rule-thin) solid var(--color-rule);
  color: var(--color-ink);
  background: transparent;
  text-align: left;
}

.visibility-row.is-selected {
  background: var(--color-surface-muted);
}

.visibility-row.is-disabled {
  color: var(--color-disabled-ink);
  opacity: var(--opacity-disabled);
}

.visibility-copy {
  flex: 1;
  min-width: 0;
}

.visibility-title {
  color: inherit;
  font-size: var(--text-list-title);
  font-weight: var(--weight-semibold);
  line-height: var(--line-list-title);
}

.visibility-note {
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.visibility-row.is-disabled .visibility-note {
  color: var(--color-disabled-ink);
}

.visibility-state {
  flex: 0 0 auto;
  color: var(--color-accent-strong);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  line-height: var(--line-meta);
  white-space: nowrap;
}

.visibility-row.is-disabled .visibility-state {
  color: var(--color-disabled-ink);
}

.optional-tool {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-lg);
  width: 100%;
  min-height: var(--touch-target);
  margin-top: var(--space-xl);
  padding: var(--space-md) 0;
  border-top: var(--rule-thin) solid var(--color-rule);
  border-bottom: var(--rule-thin) solid var(--color-rule);
  color: var(--color-ink);
  background: transparent;
  text-align: left;
}

.optional-tool-copy {
  flex: 1;
  min-width: 0;
}

.optional-tool-title {
  color: var(--color-ink);
  font-size: var(--text-list-title);
  font-weight: var(--weight-semibold);
  line-height: var(--line-list-title);
}

.optional-tool-note {
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.optional-tool-action {
  flex: 0 0 auto;
  color: var(--color-accent-strong);
  font-size: var(--text-secondary);
  font-weight: var(--weight-semibold);
  line-height: var(--line-secondary);
  white-space: nowrap;
}

.submit-area {
  margin-top: var(--space-2xl);
}

.submit-note {
  margin-bottom: var(--space-sm);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.preview-heart {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: calc(var(--touch-target) + var(--space-2xs));
  overflow: hidden;
  padding: var(--space-md) var(--space-lg);
  border: var(--rule-thin) solid transparent;
  border-radius: var(--radius-md);
  color: var(--color-accent-ink);
  background: var(--color-accent);
  font-size: var(--text-button);
  font-weight: var(--weight-semibold);
  line-height: var(--line-button);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-heart:active {
  background: var(--color-accent-strong);
}

@media (prefers-reduced-motion: reduce) {
  .compose-page .press,
  .compose-page .press:active {
    transition: none;
    transform: none;
  }
}
