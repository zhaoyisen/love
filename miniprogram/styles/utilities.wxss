/* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4 · component foundations */

view,
text,
button,
input,
textarea,
image,
video,
scroll-view {
  box-sizing: border-box;
}

button,
input,
textarea {
  font-family: var(--font-body);
}

button {
  margin: 0;
  padding: 0;
  min-width: 0;
  border-radius: 0;
  overflow: visible;
  color: inherit;
  background: transparent;
  line-height: normal;
}

button::after {
  border: 0;
}

button:focus,
button:focus-visible,
input:focus,
input:focus-visible,
textarea:focus,
textarea:focus-visible {
  outline: var(--rule-strong) solid var(--color-focus);
  outline-offset: var(--space-3xs);
}

.card,
.soft-card {
  min-width: 0;
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-lg);
  word-break: break-word;
}

.card {
  background: var(--color-surface);
}

.soft-card {
  background: var(--color-surface-muted);
}

.card--media,
.is-raised {
  box-shadow: var(--shadow-media);
}

.card--interactive {
  transition:
    transform var(--dur-micro) var(--ease-out),
    border-color var(--dur-short) var(--ease-out),
    box-shadow var(--dur-short) var(--ease-out);
}

.card--interactive:active {
  transform: scale(var(--press-scale));
}

.card--interactive:focus-visible {
  outline: var(--rule-strong) solid var(--color-focus);
  outline-offset: var(--space-3xs);
}

.card.is-loading {
  pointer-events: none;
  opacity: var(--opacity-loading);
}

.card.is-success {
  border-color: var(--color-success);
}

.card.is-error {
  border-color: var(--color-error);
}

.card.is-disabled,
.card[aria-disabled="true"] {
  pointer-events: none;
  opacity: var(--opacity-disabled);
  box-shadow: none;
}

.card.is-disabled:active,
.card[aria-disabled="true"]:active {
  transform: none;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--touch-target);
  overflow: hidden;
  padding: var(--space-md) var(--space-lg);
  border: var(--rule-thin) solid transparent;
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  font-size: var(--text-button);
  font-weight: var(--weight-semibold);
  line-height: var(--line-button);
  letter-spacing: 0;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-button {
  color: var(--color-accent-ink);
  background: var(--color-accent);
}

.primary-button:active {
  background: var(--color-accent-strong);
}

.secondary-button {
  color: var(--color-ink);
  background: var(--color-surface);
  border-color: var(--color-rule);
}

.secondary-button:active {
  border-color: var(--color-ink-secondary);
  background: var(--color-surface-muted);
}

.danger-button {
  color: var(--color-accent-ink);
  background: var(--color-error);
}

.danger-button:active {
  opacity: var(--opacity-pressed);
}

.primary-button[disabled],
.secondary-button[disabled],
.danger-button[disabled] {
  color: var(--color-disabled-ink);
  background: var(--color-disabled-bg);
  border-color: var(--color-rule);
  opacity: var(--opacity-disabled);
  box-shadow: none;
}

.primary-button.is-loading,
.secondary-button.is-loading,
.danger-button.is-loading {
  pointer-events: none;
  opacity: var(--opacity-loading);
}

.primary-button.is-success,
.secondary-button.is-success,
.danger-button.is-success {
  color: var(--color-success);
  background: var(--color-success-bg);
  border-color: var(--color-success);
}

.primary-button.is-error,
.secondary-button.is-error,
.danger-button.is-error {
  color: var(--color-error);
  background: var(--color-error-bg);
  border-color: var(--color-error);
}

.text-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-target);
  padding: var(--space-sm) var(--space-xs);
  color: var(--color-accent-strong);
  background: transparent;
  font-family: var(--font-body);
  font-size: var(--text-secondary);
  font-weight: var(--weight-semibold);
  line-height: 1;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-button:active {
  color: var(--color-accent);
}

.text-button[disabled] {
  color: var(--color-disabled-ink);
  opacity: var(--opacity-disabled);
}

.text-button.is-loading {
  pointer-events: none;
  opacity: var(--opacity-loading);
}

.text-button.is-success { color: var(--color-success); }
.text-button.is-error { color: var(--color-error); }

.button-spinner {
  flex: 0 0 auto;
  width: var(--space-lg);
  height: var(--space-lg);
  margin-right: var(--space-xs);
  border: var(--rule-thin) solid currentColor;
  border-top-color: transparent;
  border-radius: var(--radius-round);
  animation: control-spin var(--dur-loader) linear infinite;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-target);
  padding: 0 var(--space-md);
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-pill);
  color: var(--color-ink-secondary);
  background: var(--color-surface);
  font-family: var(--font-body);
  font-size: var(--text-meta);
  font-weight: var(--weight-medium);
  line-height: 1;
  white-space: nowrap;
}

.chip--active {
  color: var(--color-accent-strong);
  border-color: var(--color-accent-strong);
  background: var(--color-accent-soft);
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--line-meta);
  padding: var(--space-2xs) var(--space-sm);
  border-radius: var(--radius-pill);
  color: var(--color-ink-secondary);
  background: var(--color-surface-muted);
  font-family: var(--font-body);
  font-size: var(--text-meta);
  font-weight: var(--weight-medium);
  line-height: 1;
  white-space: nowrap;
}

.input,
.textarea {
  width: 100%;
  min-height: var(--touch-target);
  padding: var(--space-md);
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-md);
  outline: var(--rule-strong) solid transparent;
  outline-offset: var(--space-3xs);
  color: var(--color-ink);
  background: var(--color-surface);
  font-family: var(--font-body);
  font-size: var(--text-body);
  font-weight: var(--weight-regular);
  line-height: var(--line-body);
}

.form-item {
  min-width: 0;
  margin-bottom: var(--space-lg);
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.form-label,
.form-optional {
  min-width: 0;
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
  word-break: break-word;
}

.form-label {
  color: var(--color-ink);
  font-weight: var(--weight-semibold);
}

.form-optional {
  flex: 0 0 auto;
  color: var(--color-ink-secondary);
}

.form-required {
  margin-left: var(--space-3xs);
  color: var(--color-error);
}

.input:focus,
.input:focus-visible,
.textarea:focus,
.textarea:focus-visible {
  border-color: var(--color-ink);
  outline-color: var(--color-focus);
}

.input[disabled],
.textarea[disabled] {
  color: var(--color-disabled-ink);
  background: var(--color-disabled-bg);
  opacity: var(--opacity-disabled);
}

.input.is-loading,
.textarea.is-loading {
  opacity: var(--opacity-loading);
}

.input.is-success,
.textarea.is-success {
  border-color: var(--color-success);
}

.input.is-error,
.textarea.is-error {
  border-color: var(--color-error);
}

.form-helper {
  min-height: var(--line-meta);
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.form-helper:empty {
  visibility: hidden;
}

.form-helper.is-success {
  color: var(--color-success);
}

.form-helper.is-error {
  color: var(--color-error);
}

.textarea {
  min-height: var(--textarea-min-height);
}

.press {
  transition:
    transform var(--dur-micro) var(--ease-out),
    opacity var(--dur-micro) var(--ease-out),
    background-color var(--dur-short) var(--ease-out),
    border-color var(--dur-short) var(--ease-out);
}

.press:active {
  opacity: var(--opacity-pressed);
  transform: scale(var(--press-scale));
}

.press[disabled]:active,
button[disabled].press:active {
  opacity: var(--opacity-disabled);
  transform: none;
}

@media (hover: hover) and (pointer: fine) {
  .primary-button:hover {
    background: var(--color-accent-strong);
  }

  .secondary-button:hover,
  .chip:hover {
    background: var(--color-surface-muted);
  }

  .card--interactive:hover {
    border-color: var(--color-ink-secondary);
  }

  .text-button:hover {
    color: var(--color-accent);
  }

  .danger-button:hover {
    opacity: var(--opacity-pressed);
  }
}

.status-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  width: 100%;
  margin: var(--space-md) 0;
  padding: var(--space-md);
  border: var(--rule-thin) solid var(--color-info);
  border-radius: var(--radius-md);
  color: var(--color-info);
  background: var(--color-info-bg);
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
}

.status-banner > text {
  flex: 1;
  min-width: 0;
}

.status-banner__copy {
  min-width: 0;
  word-break: break-word;
}

.status-banner button {
  flex: 0 0 auto;
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  padding: 0 var(--space-md);
  border: var(--rule-thin) solid currentColor;
  border-radius: var(--radius-md);
  color: inherit;
  background: var(--color-surface);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  white-space: nowrap;
}

.status-banner--success {
  color: var(--color-success);
  border-color: var(--color-success);
  background: var(--color-success-bg);
}

.status-banner--warning {
  color: var(--color-warning);
  border-color: var(--color-warning);
  background: var(--color-warning-bg);
}

.status-banner--error {
  color: var(--color-error);
  border-color: var(--color-error);
  background: var(--color-error-bg);
}

.couple-skeleton {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 520rpx;
  gap: var(--space-sm);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
}

.couple-skeleton view {
  width: 168rpx;
  height: 168rpx;
  border-radius: var(--radius-round);
  background: var(--color-surface-muted);
  animation: skeleton-pulse var(--dur-loader) var(--ease-in-out) infinite;
}

.couple-skeleton view + view {
  width: 260rpx;
  height: var(--space-lg);
  border-radius: var(--radius-sm);
}

.detail-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  gap: var(--space-md);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
}

.loading-state,
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 320rpx;
  padding: var(--space-2xl) var(--page-gutter);
  text-align: center;
}

.loading-indicator {
  width: var(--state-mark-size);
  height: var(--state-mark-size);
  border: var(--rule-strong) solid var(--color-rule);
  border-top-color: var(--color-accent);
  border-radius: var(--radius-round);
  animation: control-spin var(--dur-loader) linear infinite;
}

.loading-copy,
.error-state__copy {
  max-width: var(--state-content-max-width);
  margin-top: var(--space-md);
  color: var(--color-ink-secondary);
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
  word-break: break-word;
}

.skeleton-block {
  overflow: hidden;
  border-radius: var(--radius-sm);
  background: var(--color-surface-muted);
  animation: skeleton-pulse var(--dur-loader) var(--ease-in-out) infinite;
}

.error-state__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--state-mark-size);
  height: var(--state-mark-size);
  border: var(--rule-thin) solid var(--color-error);
  border-radius: var(--radius-round);
  color: var(--color-error);
  background: var(--color-error-bg);
  font-size: var(--text-section-title);
  font-weight: var(--weight-semibold);
}

.error-state__title {
  max-width: var(--state-content-max-width);
  margin-top: var(--space-lg);
  color: var(--color-ink);
  font-size: var(--text-list-title);
  font-weight: var(--weight-semibold);
  line-height: var(--line-list-title);
  word-break: break-word;
}

.error-state__action {
  width: auto;
  max-width: var(--state-content-max-width);
  margin-top: var(--space-lg);
  padding-right: var(--space-xl);
  padding-left: var(--space-xl);
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: var(--z-modal);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-top: env(safe-area-inset-top);
  background: var(--color-overlay);
}

.modal-panel {
  box-sizing: border-box;
  width: 100%;
  max-height: var(--modal-max-height);
  overflow-y: auto;
  color: var(--color-ink);
  background: var(--color-surface);
  box-shadow: var(--shadow-modal);
}

.modal-sheet {
  padding: var(--space-xl) var(--page-gutter) calc(var(--space-lg) + env(safe-area-inset-bottom));
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}

.modal-actions {
  display: flex;
  gap: var(--space-sm);
  margin-top: var(--space-xl);
}

.modal-actions > button {
  flex: 1 1 0;
  min-width: 0;
}

.detail-loading view {
  width: var(--touch-target);
  height: var(--touch-target);
  border: var(--rule-strong) solid var(--color-rule);
  border-top-color: var(--color-accent);
  border-radius: var(--radius-round);
  animation: detail-spin var(--dur-loader) linear infinite;
}

.processing-cover {
  position: absolute;
  right: var(--page-gutter);
  bottom: var(--page-gutter);
  left: var(--page-gutter);
  z-index: var(--z-raised);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  color: var(--color-accent-ink);
  background: var(--color-overlay);
}

.processing-cover text {
  display: block;
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.processing-cover text:last-child {
  margin-top: var(--space-2xs);
  color: var(--color-accent-ink);
  opacity: .78;
}

.detail-error {
  padding-top: var(--space-2xl);
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--touch-target);
  margin-top: var(--space-lg);
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-md);
  color: var(--color-shared);
  background: var(--color-surface);
  font-size: var(--text-secondary);
  font-weight: var(--weight-semibold);
  white-space: nowrap;
}

.sweet-detail-page .detail-tags {
  flex-wrap: wrap;
}

.sweet-detail-page .comment-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  padding: 0 var(--space-xs);
}

.couple-page .memory-prompt,
.invite-page .confirm-rules {
  border: var(--rule-thin) solid var(--color-rule) !important;
  border-radius: var(--radius-lg) !important;
}

.detail-page .hero video {
  width: 100%;
  height: 100%;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: .55; }
  50% { opacity: 1; }
}

@keyframes detail-spin {
  to { transform: rotate(360deg); }
}

@keyframes control-spin {
  to { transform: rotate(360deg); }
}

@media (max-width: 360px) {
  .modal-actions {
    flex-direction: column-reverse;
  }

  .modal-actions > button {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .press,
  .press:active,
  .card--interactive,
  .card--interactive:active {
    transition: none;
    transform: none;
  }

  .couple-skeleton view,
  .skeleton-block {
    animation: none;
  }

  .detail-loading view,
  .loading-indicator,
  .button-spinner {
    animation-duration: var(--dur-loader-reduced);
  }
}
