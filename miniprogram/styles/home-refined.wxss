/* Hallmark · pre-emit critique: P5 H4 E4 S5 R5 V4 · theme: 清爽精致（已完成页面共用） */
.home-refined {
  /* Custom TabBar is outside page; keep its tokens independent of page inheritance. */
  --color-home-paper: #FCFCFA;
  --color-paper: #FCFCFA;
  --color-surface: #F5F4F1;
  --color-surface-muted: #F2F1EE;
  --color-ink: #292625;
  --color-ink-secondary: #696260;
  --color-rule: #E7E3E0;
  --color-focus: #292625;
  --color-accent: #A55469;
  --color-accent-strong: #8E4356;
  --color-accent-soft: #F5E8ED;
  --color-accent-ink: #FCFCFA;
  --color-shared: #586650;
  --color-success: #586650;
  --color-success-bg: #EEF2EA;
  --font-body: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  --weight-regular: 400;
  --radius-round: 50%;
  --space-3xs: 4rpx;
  --dur-micro: 120ms;
  --ease-out: cubic-bezier(.16, 1, .3, 1);
  --opacity-pressed: .86;
  --z-sticky: 200;
  --text-page-title: 22px;
  --text-section-title: 14px;
  --text-list-title: 18px;
  --text-body: 15px;
  --text-secondary: 14px;
  --text-meta: 12px;
  --line-page-title: 30px;
  --line-section-title: 22px;
  --line-list-title: 26px;
  --line-body: 26px;
  --line-secondary: 22px;
  --line-meta: 18px;
  --touch-target: 44px;
  --tabbar-content-height: 72px;
  --radius-lg: 24rpx;
  --rule-thin: 1px;
  --rule-strong: 2px;
  --home-icon-size: 20px;
  --home-avatar-size: 28px;
  --home-tab-inset: 2px;
  --home-tab-label-gap: 2px;
  --home-tab-padding: 8px;
  --home-content-width: 480px;
  --shadow-media: none;
  --shadow-control: 0 2rpx 8rpx rgba(41, 38, 37, .07);
  --dur-view: 180ms;
  --album-gap: 8px;
  --album-portrait: 125%;
  --album-landscape: 75%;
  --album-square: 100%;
  --album-wide: 60%;
  --album-overscan: 16px;
  --album-info-gap: 10px;
  --album-section-gap: 24px;
  --album-growth-height: 4px;
  --album-media-radius: 12px;
  --album-control-radius: 9px;
}
