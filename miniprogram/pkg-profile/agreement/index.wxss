.agreement-page{padding-bottom:calc(60rpx + env(safe-area-inset-bottom))}.effective-date{display:block;margin-top:16rpx;color:#7d6c69;font-size:22rpx}.legal-section{padding:30rpx 0;border-bottom:2rpx solid #e3cec2}.legal-section text{display:block}.legal-section text:first-child{color:#2d2425;font-size:29rpx;font-weight:700}.legal-section text:last-child{margin-top:14rpx;color:#685d5b;font-size:25rpx;line-height:1.75}.contract-button,.contact-button{width:100%;height:92rpx;margin-top:30rpx;border-radius:22rpx;font-size:25rpx;font-weight:600}.contract-button{color:#fff9f2;background:#a84454}.contact-button{color:#554c4a;background:#eee2d8}.operator-note{display:block;margin-top:22rpx;color:#8b7976;font-size:21rpx;line-height:1.55;text-align:center}
