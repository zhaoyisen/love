.edit-profile-page { background-image: radial-gradient(circle at 88% 8%, rgba(189, 78, 78, .09), transparent 28%); }
.edit-heading .display-title { display: block; margin-top: 16rpx; font-size: 50rpx; }
.edit-heading .section-note { display: block; max-width: 590rpx; }

.profile-preview { display: flex; align-items: center; gap: 24rpx; margin-top: 42rpx; padding: 28rpx; }
.preview-avatar {
  display: flex; flex: 0 0 auto; align-items: center; justify-content: center;
  width: 100rpx; height: 100rpx; border-radius: 50%; color: #FFF;
  background: linear-gradient(145deg, #CC6960, #A93F42); font-size: 40rpx;
}
.preview-copy { min-width: 0; }
.preview-copy text { display: block; }
.preview-name { overflow: hidden; font-size: 32rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.preview-copy text:last-child { margin-top: 10rpx; color: #817970; font: 21rpx/1.3 sans-serif; }

.form-card { margin-top: 24rpx; padding: 30rpx; }
.field-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.field-heading .form-label { margin-bottom: 14rpx; }
.character-count { color: #92877D; font: 20rpx/1 sans-serif; }
.nickname-input { min-height: 92rpx; }
.field-note { display: block; margin-top: 16rpx; color: #817970; font: 20rpx/1.55 sans-serif; }
.form-error { margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 14rpx; color: #823D3D; background: #F8E8E4; font-size: 22rpx; line-height: 1.45; }

.avatar-note { margin: 24rpx 0 42rpx; padding: 24rpx 26rpx; border-left: 6rpx solid #B4813C; color: #756B62; background: rgba(255, 253, 248, .56); font: 22rpx/1.6 sans-serif; }
.avatar-note text { display: block; }
.avatar-note-title { margin-bottom: 6rpx; color: #554E48; font-weight: 600; }
.cancel-button { width: 100%; min-height: 88rpx; margin-top: 14rpx; color: #756B62; background: transparent; font: 600 26rpx/1 sans-serif; }
.cancel-button[disabled] { opacity: .5; }
