/* Hallmark · macrostructure: Native profile editor (document flow) · genre: editorial
 * theme: DESIGN.md 清爽精致 · nav: existing native back · footer: in-flow actions
 * audience: young couples · task: edit avatar and nickname · enrichment: existing avatar
 * motion: press only · pre-emit critique: P5 H5 E4 S5 R5 V4
 */
@import "../../styles/home-refined.wxss";

page { background: var(--color-home-paper); }
.edit-profile-page {
  --profile-avatar-size: 64px;
  --profile-mark-size: 24px;
  --profile-gutter: 20px;
  --profile-section-gap: 24px;
  --profile-field-gap: 12px;
  --profile-input-height: 52px;
  --profile-action-height: 48px;
  --profile-mark-border: 2px;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: var(--home-content-width);
  min-height: 100vh;
  margin: 0 auto;
  padding: var(--profile-section-gap) var(--profile-gutter) var(--profile-gutter);
  padding-bottom: calc(var(--profile-gutter) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--profile-gutter) + env(safe-area-inset-bottom));
  color: var(--color-ink);
  background: var(--color-paper);
  font-family: var(--font-body);
}
.edit-profile-page text { min-width: 0; overflow-wrap: anywhere; }
.profile-kicker { display: block; color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); }
.edit-heading .display-title { display: block; margin-top: var(--space-2xs); font-size: var(--text-page-title); font-weight: var(--weight-semibold); line-height: var(--line-page-title); font-style: normal; }
.edit-heading .section-note { display: block; margin-top: var(--space-sm); color: var(--color-ink-secondary); font-size: var(--text-secondary); line-height: var(--line-secondary); }

.profile-preview { display: flex; align-items: center; gap: var(--profile-gutter); margin-top: var(--profile-section-gap); padding-bottom: var(--profile-section-gap); border-bottom: var(--rule-thin) solid var(--color-rule); }
.edit-profile-page button { box-sizing: border-box; margin: 0; padding: 0; border: 0; background: transparent; font-family: var(--font-body); line-height: var(--line-secondary); white-space: nowrap; }
.edit-profile-page button::after { border: 0; }
.edit-profile-page .avatar-picker { position: relative; display: flex; flex: 0 0 var(--profile-avatar-size); align-items: center; justify-content: center; width: var(--profile-avatar-size); min-width: var(--profile-avatar-size); height: var(--profile-avatar-size); overflow: visible; border-radius: var(--radius-round); color: var(--color-accent-strong); background: var(--color-accent-soft); font-size: var(--text-page-title); font-weight: var(--weight-medium); }
.avatar-picker image { display: block; width: 100%; height: 100%; border-radius: inherit; }
.avatar-edit-mark { position: absolute; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; width: var(--profile-mark-size); height: var(--profile-mark-size); border: var(--profile-mark-border) solid var(--color-paper); border-radius: var(--album-control-radius); color: var(--color-accent-ink); background: var(--color-accent-strong); font-size: var(--text-meta); font-weight: var(--weight-medium); line-height: 1; }
.preview-copy { flex: 1; min-width: 0; }
.preview-copy text { display: block; }
.preview-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--text-list-title); font-weight: var(--weight-medium); line-height: var(--line-list-title); }
.preview-copy text:last-child { margin-top: var(--space-xs); color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); }

.profile-form { margin-top: var(--profile-section-gap); min-width: 0; }
.field-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2xs) var(--profile-field-gap); margin-bottom: var(--profile-field-gap); }
.field-heading .form-label { margin: 0; color: var(--color-ink); font-size: var(--text-body); font-weight: var(--weight-medium); line-height: var(--line-body); }
.character-count { color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); font-variant-numeric: tabular-nums; }
.nickname-input { display: block; box-sizing: border-box; width: 100%; min-width: 0; height: var(--profile-input-height); padding: 0 var(--profile-field-gap); border: var(--rule-thin) solid var(--color-ink-secondary); border-radius: var(--album-control-radius); color: var(--color-ink); background: var(--color-surface); font-family: var(--font-body); font-size: var(--text-body); line-height: var(--line-body); }
.nickname-placeholder { color: var(--color-ink-secondary); }
.field-note { display: block; margin-top: var(--profile-field-gap); color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); }
.form-error { margin-top: var(--profile-field-gap); padding: var(--profile-field-gap); border-left: var(--rule-strong) solid var(--color-error); color: var(--color-error); background: var(--color-error-bg); font-size: var(--text-secondary); line-height: var(--line-secondary); overflow-wrap: anywhere; }

.avatar-note { margin-top: var(--profile-section-gap); color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); }
.avatar-note text { display: block; }
.avatar-note-title { margin-bottom: var(--space-2xs); color: var(--color-ink); font-weight: var(--weight-medium); }
.profile-actions { margin-top: auto; padding-top: var(--profile-section-gap); }
.edit-profile-page .primary-button, .edit-profile-page .cancel-button { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; min-height: var(--profile-action-height); border-radius: var(--album-control-radius); font-size: var(--text-body); font-weight: var(--weight-medium); }
.edit-profile-page .primary-button { color: var(--color-accent-ink); background: var(--color-accent); }
.edit-profile-page .cancel-button { min-height: var(--touch-target); margin-top: var(--space-2xs); color: var(--color-ink-secondary); }
.edit-profile-page button:focus-visible, .nickname-input:focus-visible { outline: var(--rule-strong) solid var(--color-focus); outline-offset: var(--space-3xs); }
.edit-profile-page .primary-button:active:not([disabled]) { background: var(--color-accent-strong); }
.edit-profile-page button[disabled] { opacity: var(--opacity-disabled); transform: none; cursor: not-allowed; }
.edit-profile-page .primary-button[disabled]:not([loading="true"]) { color: var(--color-ink-secondary); background: var(--color-surface-muted); }
.nickname-input[disabled] { color: var(--color-ink-secondary); opacity: var(--opacity-disabled); cursor: not-allowed; }
@media (hover: hover) {
  .edit-profile-page .primary-button:hover:not([disabled]) { background: var(--color-accent-strong); }
  .edit-profile-page .cancel-button:hover:not([disabled]) { color: var(--color-ink); background: var(--color-surface); }
  .nickname-input:hover:not([disabled]) { background: var(--color-surface-muted); }
}
@media (prefers-reduced-motion: reduce) {
  .edit-profile-page .press { transform: none; transition: none; }
}
