<view class="film-moment {{display.mediaType === 'TEXT' ? 'is-text' : ''}} press" bindtap="open">
  <view class="film-strip"><text>FRAME {{display.day}}</text><text>{{display.month}}月 {{display.time}}</text></view>
  <view wx:if="{{display.mediaType !== 'TEXT'}}" class="media-cover tone-{{display.media[0].tone || 'paper'}}">
    <image wx:if="{{(display.media[0].thumbnailPath || display.media[0].path) && display.mediaType === 'IMAGE'}}" class="media-image" src="{{display.media[0].thumbnailPath || display.media[0].path}}" mode="aspectFill"></image>
    <video wx:elif="{{display.media[0].path && display.mediaType === 'VIDEO'}}" class="media-image" src="{{display.media[0].path}}" controls="{{false}}" object-fit="cover"></video>
    <view wx:else class="cover-art">
      <view class="cover-sun"></view>
      <view class="cover-line"></view>
      <text>{{display.mediaType === 'VIDEO' ? '▶ 片刻影像' : display.template || '原始照片'}}</text>
    </view>
    <view class="film-date-stamp"><text>{{display.day}}</text><text>{{display.month}}月</text></view>
    <view wx:if="{{display.status === 'UPLOADING'}}" class="card-processing"><text>正在冲洗</text><text>完成前只给你看</text></view>
  </view>
  <view class="film-copy">
    <view class="author-row">
      <text class="author-dot {{display.author === '我' ? 'mine' : 'partner'}}"></text>
      <text>{{display.author === '我' ? '我留下的' : 'TA 留下的'}}</text>
      <text wx:if="{{display.status === 'UPLOADING'}}" class="lock-label">处理中</text>
      <text wx:elif="{{display.visibility === 'PRIVATE'}}" class="lock-label">只给自己</text>
      <text wx:else class="shared-label">我和 TA</text>
    </view>
    <text class="moment-title">{{display.title}}</text>
    <text class="moment-copy">{{display.body}}</text>
    <view class="tag-row">
      <text wx:if="{{display.mood}}" class="tag">{{display.mood}}</text>
      <text wx:for="{{display.events}}" wx:key="*this" wx:for-item="tag" wx:if="{{index < 2}}" class="tag">{{tag}}</text>
    </view>
    <view wx:if="{{display.reaction || display.commentCount}}" class="sweet-response">
      <view class="response-avatar">TA</view>
      <text wx:if="{{display.reaction}}">{{display.reaction.actor === '我' ? '我回应了：' : 'TA 回应了：'}}{{display.reaction.value}}</text>
      <text wx:if="{{display.commentCount}}">还有 {{display.commentCount}} 句悄悄话</text>
    </view>
  </view>
</view>
