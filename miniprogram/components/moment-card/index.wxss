.moment-card { overflow: hidden; margin-top: 20rpx; background: #FCF9F3; border: 2rpx solid #DDD3C7; border-radius: 22rpx; box-shadow: 0 8rpx 24rpx rgba(62,48,38,.06); animation: card-in 240ms cubic-bezier(.22,1,.36,1) both; }
.moment-card:active { opacity: .86; transform: scale(.985); }
.moment-date { display: flex; align-items: baseline; gap: 12rpx; padding: 20rpx 22rpx 16rpx; border-bottom: 2rpx solid #EAE1D7; }
.date-day { color: #A94444; font: 700 38rpx/1 Georgia, serif; }
.date-meta { color: #817970; font: 22rpx/1 sans-serif; letter-spacing: 1rpx; }
.media-cover { position: relative; height: 260rpx; overflow: hidden; }
.media-image { width: 100%; height: 100%; }
.card-processing { position: absolute; left: 20rpx; right: 20rpx; bottom: 20rpx; z-index: 2; display: flex; align-items: center; justify-content: space-between; padding: 16rpx 18rpx; border-radius: 16rpx; color: #FFF; background: rgba(43,40,37,.76); font-size: 21rpx; }
.card-processing text:last-child { color: #EDE5DB; font-size: 19rpx; }
.tone-sunset { background: linear-gradient(150deg,#E9C5A8,#C9826C 55%,#6E5962); }
.tone-lake { background: linear-gradient(150deg,#CBDCD6,#7D9E9D 58%,#4D6570); }
.tone-berry { background: linear-gradient(150deg,#EAC6C1,#B86569 60%,#69464E); }
.tone-paper { background: linear-gradient(150deg,#EFE3D3,#C9B59B); }
.cover-art { position: absolute; inset: 0; display: flex; align-items: flex-end; padding: 26rpx; color: rgba(255,255,255,.92); font: 22rpx/1 sans-serif; letter-spacing: 2rpx; }
.cover-art::after { content: ''; position: absolute; inset: 18rpx; border: 2rpx solid rgba(255,255,255,.5); }
.cover-sun { position: absolute; width: 118rpx; height: 118rpx; right: 80rpx; top: 54rpx; border-radius: 50%; background: rgba(255,238,205,.5); }
.cover-line { position: absolute; left: -30rpx; right: -30rpx; bottom: 92rpx; height: 80rpx; border-top: 3rpx solid rgba(255,255,255,.55); transform: rotate(-7deg); }
.moment-body { padding: 22rpx 22rpx 24rpx; }
.author-row { display: flex; align-items: center; gap: 10rpx; color: #817970; font: 21rpx/1 sans-serif; }
.author-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #557263; }
.author-dot.partner { background: #BD4E4E; }
.lock-label { margin-left: auto; padding: 7rpx 13rpx; border-radius: 14rpx; color: #766A5F; background: #EEE7DC; }
.moment-title { display: block; margin-top: 16rpx; font-size: 31rpx; font-weight: 700; line-height: 1.4; }
.moment-copy { display: -webkit-box; margin-top: 10rpx; overflow: hidden; color: #665E57; font: 25rpx/1.65 sans-serif; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.tag-row { display: flex; gap: 10rpx; margin-top: 18rpx; }
.tag { display: inline-flex; padding: 8rpx 15rpx; border-radius: 18rpx; background: #EEE7DC; color: #6F655C; font: 20rpx/1 sans-serif; }
.response-row { display: flex; gap: 24rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 2rpx dashed #DED4C8; color: #BD4E4E; font: 22rpx/1 sans-serif; }
@keyframes card-in { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .moment-card { animation: none; } }
