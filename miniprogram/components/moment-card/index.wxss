/* Hallmark · component: timeline moment · genre: editorial · theme: DESIGN.md
 * states: default · hover · focus · active · disabled · loading · error · success
 * pre-emit critique: P5 H4 E4 S5 R5 V4 · design-system: DESIGN.md 首页变体
 */

.timeline-moment {
  width: 100%;
  padding: var(--space-xl) 0;
  border-bottom: var(--rule-thin) solid var(--color-rule);
  color: var(--color-ink);
  background: transparent;
  transition: opacity var(--dur-micro) var(--ease-out);
}

.timeline-moment:active {
  transform: none;
  opacity: var(--opacity-pressed);
}

.moment-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  min-width: 0;
}

.moment-author {
  display: flex;
  align-items: center;
  gap: var(--space-2xs);
  min-width: 0;
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.author-dot {
  flex: 0 0 auto;
  width: var(--space-xs);
  height: var(--space-xs);
  border-radius: var(--radius-round);
  background: var(--color-accent);
}

.author-dot.partner {
  background: var(--color-shared);
}

.author-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.moment-date {
  flex: 0 0 auto;
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  font-weight: var(--weight-medium);
  line-height: var(--line-meta);
  white-space: nowrap;
}

.media-cover {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 125%;
  margin-top: var(--space-md);
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--color-paper);
  box-shadow: var(--shadow-media);
}

.tone-sunset { background: var(--color-warning-bg); }
.tone-dusk { background: var(--color-info-bg); }
.tone-green { background: var(--color-success-bg); }
.tone-paper { background: var(--color-paper); }

.media-image {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.cover-art,
.media-error {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl);
  text-align: center;
}

.cover-art {
  color: var(--color-ink-secondary);
  background: var(--color-surface-muted);
}

.cover-art text {
  display: block;
  max-width: var(--state-content-max-width);
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
  word-break: break-word;
}

.cover-art text:first-child {
  color: var(--color-ink);
  font-weight: var(--weight-semibold);
}

.cover-art text + text {
  margin-top: var(--space-2xs);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.media-error {
  color: var(--color-error);
  background: var(--color-error-bg);
}

.media-error-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--state-mark-size);
  height: var(--state-mark-size);
  border: var(--rule-thin) solid var(--color-error);
  border-radius: var(--radius-round);
  font-size: var(--text-section-title);
  font-weight: var(--weight-semibold);
}

.media-error-title {
  margin-top: var(--space-md);
  color: var(--color-ink);
  font-size: var(--text-list-title);
  font-weight: var(--weight-semibold);
  line-height: var(--line-list-title);
}

.media-error-copy {
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.video-entry,
.card-media-count,
.card-processing {
  position: absolute;
  z-index: var(--z-raised);
}

.video-entry,
.card-media-count {
  top: var(--space-md);
  display: flex;
  align-items: center;
  min-height: var(--touch-target);
  padding: 0 var(--space-md);
  border-radius: var(--radius-pill);
  color: var(--color-surface);
  background: var(--color-overlay);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  line-height: 1;
}

.video-entry {
  left: var(--space-md);
  gap: var(--space-2xs);
}

.card-media-count {
  right: var(--space-md);
}

.card-processing {
  right: var(--space-md);
  bottom: var(--space-md);
  left: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  color: var(--color-surface);
  background: var(--color-overlay);
}

.card-processing text {
  display: block;
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.card-processing text:first-child {
  font-weight: var(--weight-semibold);
}

.moment-copy-area {
  margin-top: var(--space-md);
}

.scope-row {
  display: flex;
  align-items: center;
  min-height: var(--line-meta);
}

.lock-label,
.shared-label {
  display: inline-flex;
  align-items: center;
  min-height: var(--line-meta);
  padding: 0;
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.lock-label {
  color: var(--color-warning);
  background: transparent;
}

.shared-label {
  color: var(--color-success);
  background: transparent;
}

.moment-title,
.moment-copy {
  display: block;
  word-break: break-word;
}

.moment-title {
  margin-top: var(--space-xs);
  color: var(--color-ink);
  font-size: var(--text-list-title);
  font-weight: var(--weight-medium);
  line-height: var(--line-list-title);
}

.moment-copy {
  display: -webkit-box;
  overflow: hidden;
  margin-top: var(--space-xs);
  color: var(--color-ink);
  font-size: var(--text-body);
  line-height: var(--line-body);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2xs);
  margin-top: var(--space-md);
}

.sweet-response {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
  padding: var(--space-lg);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

.response-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: var(--home-avatar-size);
  height: var(--home-avatar-size);
  overflow: hidden;
  border-radius: var(--radius-round);
  color: var(--color-accent-strong);
  background: var(--color-accent-soft);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
}

.response-copy {
  min-width: 0;
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  word-break: break-word;
}

.response-copy text {
  display: block;
}

.moment-card-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(var(--touch-target) + var(--space-2xl));
  padding: var(--space-lg);
  border-top: var(--rule-thin) solid var(--color-error);
  border-bottom: var(--rule-thin) solid var(--color-error);
  color: var(--color-error);
  background: var(--color-error-bg);
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
  text-align: center;
  word-break: break-word;
}

@media (hover: hover) and (pointer: fine) {
  .timeline-moment:hover {
    border-bottom-color: var(--color-ink-secondary);
  }
}

@media (prefers-reduced-motion: reduce) {
  .timeline-moment {
    transition: none;
    transform: none;
  }
}

.response-avatar { overflow: hidden; }
.response-avatar image { display: block; width: 100%; height: 100%; border-radius: inherit; }
