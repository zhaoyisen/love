<view class="empty-state" role="status" aria-live="polite">
  <view class="empty-mark" aria-hidden="true"><view></view></view>
  <text class="empty-title">{{title}}</text>
  <text class="empty-description">{{description}}</text>
  <button wx:if="{{action}}" class="empty-action primary-button press" bindtap="action">{{action}}</button>
</view>
