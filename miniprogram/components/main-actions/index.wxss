/* Hallmark · component: main actions · theme: DESIGN.md 清爽精致 */
@import "../../styles/home-refined.wxss";
:host { display: block; flex: 0 0 auto; }
.main-actions { display: flex; align-items: center; gap: 8px; }
.main-actions .action-button { position: relative; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: var(--touch-target); height: var(--touch-target); min-width: var(--touch-target); margin: 0; padding: 0; border: 0; border-radius: var(--radius-round); color: var(--color-ink); background: var(--color-surface); font-family: var(--font-body); line-height: 1; overflow: visible; transition: opacity var(--dur-micro) var(--ease-out); }
.action-button::after { border: 0; }
.action-button image { display: block; width: var(--home-icon-size); height: var(--home-icon-size); }
.action-button:active { opacity: var(--opacity-pressed); }
.action-button:focus-visible { outline: var(--rule-strong) solid var(--color-focus); outline-offset: 2px; }
.action-badge { position: absolute; top: 0; right: -2px; box-sizing: border-box; min-width: 18px; padding: 0 4px; border: 2px solid var(--color-paper); border-radius: var(--radius-pill); color: var(--color-accent-ink); background: var(--color-accent); font-size: var(--text-meta); line-height: 16px; text-align: center; white-space: nowrap; }
@media (prefers-reduced-motion: reduce) { .action-button { transition: none; } }
