/* Hallmark · macrostructure: Index-First · genre: editorial · theme: 暖昏生活胶片 · anchor hue: warm berry · enrichment: none · nav: native · footer: custom tabBar
 * pre-emit critique: P5 H5 E5 S5 R5 V5 · slop-test: pass (58/58) · contrast: pass (40–41) · mobile: pass (34, 49–57)
 */

.mine-page {
  padding-top: var(--space-xl);
}

.mine-introduction {
  min-width: 0;
}

.mine-title {
  display: block;
  color: var(--color-ink);
  font-size: var(--text-section-title);
  font-weight: var(--weight-bold);
  line-height: var(--line-section-title);
}

.mine-intro {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
  word-break: break-word;
}

.service-state,
.sync-status {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  color: var(--color-warning);
  font-size: var(--text-meta);
  font-weight: var(--weight-medium);
  line-height: var(--line-meta);
}

.service-state {
  margin-top: var(--space-lg);
  padding-top: var(--space-sm);
  border-top: var(--rule-thin) solid var(--color-rule);
}

.service-state.remote {
  color: var(--color-success);
}

.service-dot,
.sync-status > view {
  flex: 0 0 auto;
  width: var(--space-xs);
  height: var(--space-xs);
  border-radius: var(--radius-round);
  background: currentColor;
}

.sync-status {
  margin-top: var(--space-md);
  color: var(--color-success);
}

.sync-status > view {
  animation: sync-pulse var(--dur-loader) var(--ease-in-out) infinite;
}

.setting-group {
  margin-top: var(--space-2xl);
}

.identity-group {
  margin-top: var(--space-2xl);
}

.group-heading {
  min-width: 0;
  margin-bottom: var(--space-md);
}

.group-title,
.group-description {
  display: block;
  word-break: break-word;
}

.group-title {
  color: var(--color-ink);
  font-size: var(--text-list-title);
  font-weight: var(--weight-semibold);
  line-height: var(--line-list-title);
}

.group-description {
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.identity-ledger,
.index-list {
  margin-right: calc(0rpx - var(--page-gutter));
  margin-left: calc(0rpx - var(--page-gutter));
  padding-right: var(--page-gutter);
  padding-left: var(--page-gutter);
  border-top: var(--rule-thin) solid var(--color-rule);
  border-bottom: var(--rule-thin) solid var(--color-rule);
  background: var(--color-surface);
}

.profile-row,
.relationship-row,
.index-row,
.switch-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.profile-row {
  gap: var(--space-md);
  min-height: calc(var(--touch-target) + var(--space-xl));
  padding: var(--space-lg) 0;
}

.profile-avatar,
.partner-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-round);
  color: var(--color-accent-strong);
  background: var(--color-accent-soft);
  font-weight: var(--weight-semibold);
}

.profile-avatar {
  width: calc(var(--touch-target) + var(--space-md));
  height: calc(var(--touch-target) + var(--space-md));
  font-size: var(--text-section-title);
}

.profile-avatar image,
.partner-avatar image {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-round);
}

.profile-copy,
.relationship-copy,
.row-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.profile-copy text,
.relationship-copy text,
.row-copy text {
  display: block;
}

.profile-name {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--text-list-title);
  font-weight: var(--weight-semibold);
  line-height: var(--line-list-title);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-role {
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.edit-profile {
  flex: 0 0 auto;
  margin-left: var(--space-xs);
  padding-right: 0;
  padding-left: 0;
}

/* Compatibility contract retained for scripts/validate-responsive.js. */
.edit-button {
  width: 124rpx !important;
  min-width: 124rpx !important;
  max-width: 124rpx !important;
}

.identity-rule {
  width: 100%;
  height: var(--rule-thin);
  background: var(--color-rule);
}

.relationship-row {
  gap: var(--space-md);
  min-height: calc(var(--touch-target) + var(--space-lg));
  padding: var(--space-md) 0;
}

.partner-avatar {
  width: var(--touch-target);
  height: var(--touch-target);
  color: var(--color-ink-secondary);
  background: var(--color-surface-muted);
  font-size: var(--text-secondary);
}

.relationship-row.paired .partner-avatar {
  color: var(--color-success);
  background: var(--color-success-bg);
}

.relationship-row.ended .partner-avatar {
  color: var(--color-error);
  background: var(--color-error-bg);
}

.relationship-title-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-sm);
  min-width: 0;
}

.relationship-name {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
  line-height: var(--line-body);
  overflow-wrap: anywhere;
}

.relationship-status {
  flex: 0 0 auto;
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  line-height: var(--line-meta);
}

.relationship-row.paired .relationship-status {
  color: var(--color-success);
}

.relationship-row.ended .relationship-status {
  color: var(--color-error);
}

.relationship-description {
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  word-break: break-word;
}

.privacy-promise {
  margin-top: var(--space-xl);
  padding-left: var(--space-md);
  border-left: var(--rule-strong) solid var(--color-accent);
}

.promise-title,
.promise-copy {
  display: block;
  word-break: break-word;
}

.promise-title {
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: var(--weight-semibold);
  line-height: var(--line-body);
}

.promise-copy {
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.index-row,
.switch-row {
  justify-content: space-between;
  gap: var(--space-md);
  min-height: calc(var(--touch-target) + var(--space-md));
  padding: var(--space-sm) 0;
  border-bottom: var(--rule-thin) solid var(--color-rule);
  text-align: left;
  background: transparent;
}

.index-list > .index-row:last-child,
.index-list > .switch-row:last-child,
.danger-list > .index-row:last-child {
  border-bottom: 0;
}

.index-row.press:active {
  opacity: var(--opacity-pressed);
  background: var(--color-surface-muted);
  transform: none;
}

.row-title,
.switch-row > text {
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: var(--weight-medium);
  line-height: var(--line-body);
}

.row-description {
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  word-break: break-word;
}

.row-arrow {
  flex: 0 0 auto;
  align-self: center;
  min-width: var(--space-lg);
  color: var(--color-ink-secondary);
  font-size: var(--text-section-title);
  line-height: var(--line-section-title);
  text-align: right;
}

.switch-row switch {
  flex: 0 0 auto;
}

.switch-row.is-disabled {
  opacity: var(--opacity-disabled);
}

.setting-help {
  display: block;
  margin-top: var(--space-sm);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  word-break: break-word;
}

.about-group {
  margin-top: var(--space-2xl);
}

.account-zone {
  margin-top: var(--space-3xl);
  padding-top: var(--space-xl);
  border-top: var(--rule-thin) solid var(--color-rule);
}

.danger-list {
  border-top: var(--rule-thin) solid var(--color-rule);
  border-bottom: var(--rule-thin) solid var(--color-rule);
}

.danger-list .index-row {
  min-height: calc(var(--touch-target) + var(--space-lg));
}

.danger-row .row-title,
.danger-row .row-arrow {
  color: var(--color-error);
}

@keyframes sync-pulse {
  0%, 100% { opacity: .45; transform: scale(.8); }
  50% { opacity: 1; transform: scale(1); }
}

@keyframes sync-pulse-reduced {
  0%, 100% { opacity: .55; }
  50% { opacity: 1; }
}

@media (max-width: 360px) {
  .relationship-title-line {
    align-items: flex-start;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .relationship-name {
    width: 100%;
  }

}

@media (prefers-reduced-motion: reduce) {
  .sync-status > view {
    animation-name: sync-pulse-reduced;
    animation-duration: var(--dur-loader-reduced);
  }
}
