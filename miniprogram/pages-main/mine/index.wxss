.profile-card{display:flex;align-items:center;gap:20rpx;margin-top:28rpx;padding:30rpx;border:2rpx solid #D8CCBE;border-radius:28rpx;background:#FFFDF8}.profile-avatar{display:flex;align-items:center;justify-content:center;width:94rpx;height:94rpx;border-radius:50%;color:#FFF;background:#BD4E4E;font-size:38rpx}.profile-card>view:nth-child(2){flex:1}.profile-card view:nth-child(2) text,.profile-card view:nth-child(2) .label{display:block}.profile-card view:nth-child(2) text{font-size:34rpx;font-weight:700}.profile-card view:nth-child(2) .label{margin-top:10rpx;color:#817970;font:21rpx/1 sans-serif}.profile-card>button{color:#557263;background:transparent;font:22rpx/1 sans-serif}.setting-group{margin-top:40rpx}.group-title{display:block;margin-bottom:12rpx;color:#817970;font:20rpx/1 sans-serif;letter-spacing:3rpx}.setting-row,.switch-row{width:100%;display:flex;align-items:center;justify-content:space-between;min-height:104rpx;padding:18rpx 2rpx;border-bottom:2rpx solid #E2D7CB;text-align:left;background:transparent}.setting-row view text,.setting-row view .label{display:block}.setting-row view text,.switch-row>text{font:26rpx/1 sans-serif}.setting-row view .label{margin-top:9rpx;color:#817970;font:20rpx/1 sans-serif}.setting-row>text{color:#A09387;font-size:35rpx}.danger-row view text{color:#8F3F3F}.mine-footer{display:block;margin-top:56rpx;text-align:center;color:#A99D90;font:17rpx/1 sans-serif;letter-spacing:3rpx}
