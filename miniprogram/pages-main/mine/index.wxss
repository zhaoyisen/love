/* Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 · theme: DESIGN.md 清爽精致 */
@import "../../styles/home-refined.wxss";
page { background: var(--color-home-paper); }
.mine-page { width: 100%; max-width: var(--home-content-width); margin: 0 auto; padding: 20px 20px calc(var(--tabbar-content-height) + 24px + env(safe-area-inset-bottom)); color: var(--color-ink); background: var(--color-paper); font-family: var(--font-body); }
.mine-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.mine-title { flex: 1; min-width: 0; font-size: var(--text-page-title); font-weight: var(--weight-medium); line-height: var(--line-page-title); }
.mine-page button { display: flex; align-items: center; width: 100%; min-width: 0; min-height: var(--touch-target); margin: 0; padding: 0; border: 0; border-radius: 0; color: var(--color-ink); background: transparent; font-family: var(--font-body); font-size: var(--text-body); font-weight: var(--weight-regular); line-height: var(--line-secondary); text-align: left; }
.mine-page button::after { border: 0; }
.identity-group { margin-top: 12px; }
.mine-page .profile-row { gap: 14px; padding: 22px 0; white-space: normal; }
.profile-avatar, .partner-avatar { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; overflow: hidden; border-radius: var(--radius-round); color: var(--color-ink-secondary); background: var(--color-surface); }
.profile-avatar { width: 56px; height: 56px; font-size: var(--text-page-title); }
.partner-avatar { width: 32px; height: 32px; color: var(--color-accent-strong); background: var(--color-accent-soft); font-size: var(--text-secondary); }
.profile-avatar image, .partner-avatar image { display: block; width: 100%; height: 100%; }
.profile-copy, .relationship-copy { flex: 1; min-width: 0; }
.profile-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--text-list-title); font-weight: var(--weight-medium); line-height: var(--line-list-title); }
.profile-role, .relationship-description { display: block; margin-top: 3px; color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); overflow-wrap: anywhere; }
.relationship-row { display: flex; align-items: center; gap: 12px; padding: 18px 0; border-top: var(--rule-thin) solid var(--color-rule); }
.relationship-name { display: block; font-size: var(--text-secondary); font-weight: var(--weight-medium); line-height: var(--line-secondary); overflow-wrap: anywhere; }
.relationship-status { flex: 0 0 auto; color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); white-space: nowrap; }
.mine-page .settings-entry { gap: 12px; min-height: 60px; margin-top: 20px; border-top: var(--rule-thin) solid var(--color-rule); border-bottom: var(--rule-thin) solid var(--color-rule); }
.settings-entry > text:first-of-type { flex: 1; }
.row-icon { flex: 0 0 auto; width: var(--home-icon-size); height: var(--home-icon-size); }
.row-arrow { flex: 0 0 12px; margin-left: auto; color: var(--color-ink-secondary); font-size: 22px; line-height: 26px; }
.mine-error { display: flex; align-items: center; gap: 12px; margin-top: 16px; padding: 12px; border: var(--rule-thin) solid var(--color-error); border-radius: var(--album-control-radius); color: var(--color-error); background: var(--color-error-bg); font-size: var(--text-secondary); line-height: var(--line-secondary); }
.mine-error > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.mine-page .retry-button { flex: 0 0 52px; width: 52px; justify-content: center; color: var(--color-error); }
.mine-loading { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 48px 0; color: var(--color-ink-secondary); font-size: var(--text-meta); }
