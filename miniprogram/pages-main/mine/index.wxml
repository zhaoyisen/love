<view class="page home-refined mine-page">
  <view class="mine-heading"><text class="mine-title">我的</text><main-actions unread="{{unreadCount}}"></main-actions></view>
  <view wx:if="{{error}}" class="mine-error" role="alert"><text>{{error}}</text><button size="mini" class="retry-button" bindtap="retry">重试</button></view>
  <view wx:if="{{loading && loaded}}" class="sync-status" role="status"><view></view><text>正在同步个人资料，已保存的内容仍可查看</text></view>
  <view wx:if="{{!loaded}}" class="mine-loading" role="status"><view class="loading-indicator"></view><text>正在读取你的身份与设置</text></view>
  <block wx:else>
    <view class="identity-group">
      <button size="mini" class="profile-row press" bindtap="edit" aria-label="编辑个人资料">
        <view class="profile-avatar"><image wx:if="{{myAvatarUrl && !myAvatarError}}" src="{{myAvatarUrl}}" mode="aspectFill" data-avatar="my" binderror="avatarError"></image><text wx:else>{{myInitial}}</text></view>
        <view class="profile-copy"><text class="profile-name">{{state.profile.name || '微信用户'}}</text><text class="profile-role">你的账号</text></view><text class="row-arrow">›</text>
      </button>
      <view class="relationship-row">
        <view class="partner-avatar"><image wx:if="{{partnerAvatarUrl && !partnerAvatarError}}" src="{{partnerAvatarUrl}}" mode="aspectFill" data-avatar="partner" binderror="avatarError"></image><text wx:else>{{partnerInitial}}</text></view>
        <view class="relationship-copy"><text class="relationship-name">{{relationshipName}}</text><text class="relationship-description">{{relationshipDescription}}</text></view><text class="relationship-status">{{relationshipStatusText}}</text>
      </view>
    </view>
    <button size="mini" class="settings-entry press" bindtap="settings"><image class="row-icon" src="/assets/icons/home/sliders.png" mode="aspectFit"></image><text>设置</text><text class="row-arrow">›</text></button>
  </block>
</view>
