/* Hallmark · macrostructure: Long Document (shared photo album) · genre: editorial
 * theme: DESIGN.md 清爽精致 · nav: existing native tabs · enrichment: user photos only
 * pre-emit critique: P5 H5 E4 S5 R5 V4 · motion: scroll-linked images + press
 */
@import "../../styles/home-refined.wxss";

page { background: var(--color-home-paper); }
.couple-page { max-width: var(--home-content-width); margin: 0 auto; padding: var(--page-gutter); padding-bottom: calc(var(--tabbar-content-height) + var(--album-section-gap)); padding-bottom: calc(var(--tabbar-content-height) + var(--album-section-gap) + constant(safe-area-inset-bottom)); padding-bottom: calc(var(--tabbar-content-height) + var(--album-section-gap) + env(safe-area-inset-bottom)); }
.couple-heading, .relationship-topline, .editor-head { display: flex; align-items: center; justify-content: space-between; gap: var(--album-info-gap); }
.heading-copy { flex: 1; min-width: 0; }
.couple-heading .display-title { margin: 0; font-weight: var(--weight-medium); }
.couple-page .section-title { min-width: 0; font-size: var(--text-list-title); font-weight: var(--weight-medium); line-height: var(--line-list-title); overflow-wrap: anywhere; }
.couple-page .section-note { display: block; margin-top: var(--space-2xs); color: var(--color-ink-secondary); font-size: var(--text-meta); font-weight: var(--weight-regular); line-height: var(--line-meta); word-break: break-word; }
.couple-page button { box-sizing: border-box; margin: 0; padding: 0; border: 0; background: transparent; color: inherit; font-family: var(--font-body); line-height: 1; }
.couple-page button::after { border: 0; }
.couple-page button:focus-visible { outline: var(--rule-strong) solid var(--color-focus); outline-offset: var(--space-3xs); }
.couple-page .settings-button, .couple-page .edit-relationship, .couple-page .missing-anniversary, .couple-page .clear-date, .couple-page .text-button { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: auto; min-width: var(--touch-target); min-height: var(--touch-target); padding: 0 var(--space-sm); border-radius: var(--album-control-radius); color: var(--color-ink-secondary); font-size: var(--text-meta); font-weight: var(--weight-medium); line-height: 1; white-space: nowrap; }
.couple-page .settings-button { border: var(--rule-thin) solid var(--color-rule); background: var(--color-paper); }
.couple-page .edit-relationship, .couple-page .missing-anniversary, .couple-page .clear-date, .couple-page .text-button { color: var(--color-accent-strong); }
.couple-page .missing-anniversary { padding-left: 0; }
.couple-page .primary-button, .couple-page .secondary-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: var(--touch-target); padding: 0 var(--space-lg); border: var(--rule-thin) solid var(--color-accent); border-radius: var(--album-control-radius); color: var(--color-accent-ink); background: var(--color-accent); font-size: var(--text-secondary); font-weight: var(--weight-medium); line-height: 1; white-space: nowrap; }
.couple-page .primary-button:active { background: var(--color-accent-strong); }
.couple-page .secondary-button { border-color: var(--color-rule); color: var(--color-ink); background: var(--color-surface); }
.couple-page button[disabled] { color: var(--color-disabled-ink); border-color: var(--color-rule); background: var(--color-disabled-bg); opacity: var(--opacity-disabled); box-shadow: none; }
.couple-page .status-banner button { display: flex; align-items: center; justify-content: center; width: auto; min-width: var(--touch-target); min-height: var(--touch-target); padding: 0 var(--space-sm); border: var(--rule-thin) solid currentColor; border-radius: var(--album-control-radius); color: inherit; background: var(--color-paper); font-size: var(--text-meta); }
.sync-status { display: flex; align-items: center; gap: var(--space-xs); margin-top: var(--space-md); color: var(--color-info); font-size: var(--text-meta); line-height: var(--line-meta); }
.sync-status view { flex: 0 0 auto; width: var(--space-xs); height: var(--space-xs); border-radius: var(--radius-round); background: var(--color-info); }
.sync-status text { min-width: 0; word-break: break-word; }

.album-section, .relationship-skeleton { margin-top: var(--album-section-gap); }
.album-heading, .album-actions { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
.album-pending { display: block; margin-top: var(--space-sm); color: var(--color-ink-secondary); font-size: var(--text-meta); }
.album-grid { display: flex; align-items: flex-start; gap: var(--album-gap); margin-top: var(--space-md); }
.album-column { flex: 1 1 0; min-width: 0; }
.couple-page .album-photo { position: relative; display: block; width: 100%; min-width: 0; height: 0; min-height: 0; margin-bottom: var(--album-gap); padding: 0 0 var(--album-landscape); overflow: hidden; border: 0; border-radius: var(--album-media-radius); background: var(--color-surface); }
.couple-page .album-photo--portrait { padding-bottom: var(--album-portrait); }
.couple-page .album-photo--square { padding-bottom: var(--album-square); }
.couple-page .album-photo--wide { padding-bottom: var(--album-wide); }
.couple-page .album-grid--single .album-photo { padding-bottom: var(--album-landscape); }
.album-image { position: absolute; left: 0; top: calc(0px - var(--album-overscan)); display: block; width: 100%; height: calc(100% + var(--album-overscan) + var(--album-overscan)); transition: transform var(--dur-micro) var(--ease-out); }
.album-photo-error { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-xs); padding: var(--space-sm); color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); text-align: center; }
.album-photo-error text:last-child { color: var(--color-error); }
.album-empty { display: flex; flex-direction: column; justify-content: center; min-height: var(--media-card-min-height); margin-top: var(--space-md); padding: var(--album-section-gap); border-radius: var(--album-media-radius); color: var(--color-ink-secondary); background: var(--color-surface); font-size: var(--text-secondary); line-height: var(--line-secondary); }
.album-empty text:last-child { margin-top: var(--space-xs); font-size: var(--text-meta); line-height: var(--line-meta); }
.skeleton-photo { height: 0; padding-bottom: var(--album-landscape); margin-bottom: var(--album-gap); border-radius: var(--album-media-radius); }
.skeleton-photo--portrait { padding-bottom: var(--album-portrait); }
.relationship-skeleton > text { display: block; margin-top: var(--space-sm); color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); }

.relationship-summary { margin-top: 0; margin-bottom: var(--album-section-gap); }
.relationship-people { display: flex; align-items: center; flex: 0 0 auto; gap: var(--space-3xs); }
.person-avatar, .preview-avatar { display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: var(--radius-round); color: var(--color-accent-strong); background: var(--color-accent-soft); font-size: var(--text-meta); font-weight: var(--weight-medium); }
.person-avatar { flex: 0 0 auto; width: var(--home-avatar-size); height: var(--home-avatar-size); }
.person-avatar.partner { color: var(--color-ink-secondary); background: var(--color-surface); }
.person-avatar image, .preview-avatar image { display: block; width: 100%; height: 100%; }
.people-join { color: var(--color-ink-secondary); font-size: var(--text-meta); }
.relationship-name { flex: 1; min-width: 0; color: var(--color-ink); font-size: var(--text-secondary); font-weight: var(--weight-medium); line-height: var(--line-secondary); overflow-wrap: anywhere; }
.relationship-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-md); margin-top: var(--space-2xs); color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); }
.days-statement, .anniversary-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-3xs); }
.days-number { font-size: var(--text-meta); font-weight: var(--weight-regular); }
.anniversary-line { gap: var(--space-xs); }

.relation-editor { margin-top: var(--space-lg); padding: var(--space-lg); border: var(--rule-thin) solid var(--color-rule); border-radius: var(--album-media-radius); background: var(--color-surface); }
.editor-head { align-items: flex-start; margin-bottom: var(--space-lg); }
.editor-head > view { min-width: 0; }
.editor-title, .editor-note { display: block; word-break: break-word; }
.editor-title { color: var(--color-ink); font-size: var(--text-secondary); font-weight: var(--weight-medium); line-height: var(--line-secondary); }
.editor-note { margin-top: var(--space-2xs); color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); }
.couple-page .form-label { font-size: var(--text-secondary); font-weight: var(--weight-medium); line-height: var(--line-secondary); }
.couple-page .form-helper { font-size: var(--text-meta); line-height: var(--line-meta); }
.date-control { display: block; }
.date-picker { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); min-height: var(--touch-target); padding: var(--space-sm); border: var(--rule-thin) solid var(--color-rule); border-radius: var(--album-control-radius); color: var(--color-ink); background: var(--color-paper); font-size: var(--text-secondary); line-height: var(--line-secondary); }
.date-picker text:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.date-picker text:last-child { flex: 0 0 auto; color: var(--color-accent-strong); font-size: var(--text-meta); white-space: nowrap; }
.date-control:focus-visible .date-picker { outline: var(--rule-strong) solid var(--color-focus); outline-offset: var(--space-3xs); }
.date-helper { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
.date-helper .form-helper { flex: 1; min-width: 0; }
.relation-editor .primary-button { margin-top: var(--space-lg); }

.shared-section { margin-top: var(--album-section-gap); }
.section-heading { display: flex; flex-direction: column; align-items: flex-start; }
.shared-ledger { margin-top: var(--space-md); border-top: var(--rule-thin) solid var(--color-rule); }
.couple-page .ledger-row, .shared-count-row { display: flex; align-items: center; justify-content: space-between; gap: var(--album-info-gap); width: 100%; min-width: 0; min-height: var(--touch-target); padding: var(--space-lg) 0; border-bottom: var(--rule-thin) solid var(--color-rule); color: var(--color-ink); background: transparent; text-align: left; }
.ledger-icon { flex: 0 0 auto; width: var(--home-icon-size); height: var(--home-icon-size); }
.ledger-copy, .pet-copy { flex: 1; min-width: 0; }
.ledger-title, .ledger-description { display: block; min-width: 0; word-break: break-word; }
.ledger-title, .shared-count-line { color: var(--color-ink); font-size: var(--text-secondary); font-weight: var(--weight-medium); line-height: var(--line-secondary); }
.ledger-description { margin-top: var(--space-2xs); color: var(--color-ink-secondary); font-size: var(--text-meta); font-weight: var(--weight-regular); line-height: var(--line-meta); }
.shared-count-line { display: flex; align-items: baseline; gap: var(--space-xs); }
.shared-count { font-size: var(--text-secondary); }
.ledger-action { display: flex; flex: 0 0 auto; align-items: center; gap: var(--space-xs); color: var(--color-ink-secondary); font-size: var(--text-meta); font-weight: var(--weight-regular); line-height: var(--line-meta); white-space: nowrap; }
.ledger-action::after { content: ''; width: var(--space-xs); height: var(--space-xs); border-top: var(--rule-thin) solid currentColor; border-right: var(--rule-thin) solid currentColor; transform: rotate(45deg); }
.unread-count { display: inline-flex; align-items: center; justify-content: center; min-width: var(--line-meta); height: var(--line-meta); padding: 0 var(--space-2xs); border-radius: var(--radius-pill); color: var(--color-accent-ink); background: var(--color-accent); font-size: var(--text-meta); }
.growth-track { height: var(--album-growth-height); margin-top: var(--space-sm); overflow: hidden; border-radius: var(--radius-pill); background: var(--color-surface-muted); }
.growth-value { height: 100%; border-radius: inherit; background: var(--color-shared); }
.couple-closing { margin-top: var(--album-section-gap); }
.couple-closing text { display: block; color: var(--color-ink); font-size: var(--text-secondary); font-weight: var(--weight-medium); line-height: var(--line-secondary); }
.couple-closing text:last-child { margin-top: var(--space-2xs); color: var(--color-ink-secondary); font-size: var(--text-meta); font-weight: var(--weight-regular); line-height: var(--line-meta); }

.relationship-state { margin-top: var(--album-section-gap); padding: var(--space-lg) 0; }
.pair-preview { display: flex; align-items: center; gap: var(--space-md); }
.preview-person { display: flex; flex-direction: column; align-items: center; gap: var(--space-xs); color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); }
.preview-avatar { width: var(--touch-target); height: var(--touch-target); }
.preview-person.waiting .preview-avatar { color: var(--color-ink-secondary); background: var(--color-surface-muted); }
.pair-word { color: var(--color-ink-secondary); font-size: var(--text-secondary); }
.state-copy { margin-top: var(--space-lg); }
.state-title, .state-description { display: block; min-width: 0; word-break: break-word; }
.state-title { color: var(--color-ink); font-size: var(--text-list-title); font-weight: var(--weight-medium); line-height: var(--line-list-title); overflow-wrap: anywhere; }
.state-description { margin-top: var(--space-sm); color: var(--color-ink-secondary); font-size: var(--text-secondary); line-height: var(--line-secondary); }
.state-actions { display: flex; flex-direction: column; gap: var(--space-sm); margin-top: var(--space-lg); }
.state-actions .text-button { align-self: flex-start; }
.state-rule { width: var(--touch-target); height: var(--rule-strong); margin-bottom: var(--space-lg); background: var(--color-error); }
@media (hover: hover) and (pointer: fine) {
  .couple-page .settings-button:hover, .couple-page .ledger-row:hover { background: var(--color-surface); }
  .couple-page .edit-relationship:hover, .couple-page .clear-date:hover { color: var(--color-ink); }
}
@media (prefers-reduced-motion: reduce) {
  .album-image { transform: none !important; transition: none; }
}
