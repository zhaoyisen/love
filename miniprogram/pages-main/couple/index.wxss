.couple-page{background:linear-gradient(180deg,#F7F1E8,#EFE6DA)}.couple-heading{display:flex;align-items:flex-start;justify-content:space-between}.couple-heading .display-title{display:block}.mail-button{position:relative;padding:20rpx 22rpx;border:2rpx solid #D8CCBE;border-radius:30rpx;color:#557263;background:#FFFDF8;font:21rpx/1 sans-serif}.mail-button text{position:absolute;right:-6rpx;top:-8rpx;width:30rpx;height:30rpx;border-radius:50%;color:#FFF;background:#BD4E4E;font:17rpx/30rpx sans-serif}.unpaired-card{display:flex;flex-direction:column;align-items:center;margin-top:42rpx;padding:54rpx 34rpx;border:2rpx solid #D8CCBE;border-radius:30rpx;background:#FFFDF8;text-align:center}.two-orbits{position:relative;width:240rpx;height:170rpx}.two-orbits view{position:absolute;width:130rpx;height:130rpx;top:5rpx;border:3rpx solid #BD4E4E;border-radius:50% 46% 52% 48%}.two-orbits view:first-child{left:20rpx}.two-orbits view:nth-child(2){right:20rpx;border-color:#557263}.two-orbits text{position:absolute;left:50%;top:50%;transform:translate(-50%,-65%);display:flex;align-items:center;justify-content:center;width:55rpx;height:55rpx;border-radius:50%;color:#FFF;background:#2B2825}.unpaired-title{font-size:34rpx;font-weight:700;line-height:1.55}.unpaired-note{margin:20rpx 0 32rpx;color:#817970;font:24rpx/1.75 sans-serif}.unpaired-card .secondary-button{margin-top:16rpx}.ended-card{margin-top:40rpx;padding:42rpx;text-align:center}.ended-mark{display:block;margin-bottom:24rpx;color:#BD4E4E;font:70rpx/1 Georgia,serif}.ended-card .secondary-button{margin-top:30rpx}.relation-card{position:relative;overflow:hidden;margin-top:32rpx;padding:38rpx;border-radius:32rpx;color:#FFF;background:#4E6458;box-shadow:0 18rpx 40rpx rgba(53,73,62,.2)}.relation-card::after{content:'';position:absolute;width:310rpx;height:310rpx;right:-110rpx;top:-130rpx;border:2rpx solid rgba(255,255,255,.2);border-radius:50%}.relation-art{display:flex;align-items:center}.avatar{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border:4rpx solid rgba(255,255,255,.8);border-radius:50%;background:#BD4E4E;font-size:30rpx}.avatar.partner{background:#B4813C}.thread{width:90rpx;height:2rpx;background:rgba(255,255,255,.7)}.relation-kicker{display:block;margin-top:32rpx;color:#DDE7DF;font:20rpx/1 sans-serif;letter-spacing:3rpx}.relation-days{display:block;margin-top:12rpx;font:700 92rpx/.9 Georgia,serif}.relation-unit{display:block;margin-top:12rpx;font:23rpx/1 sans-serif}.anniversary{display:flex;justify-content:space-between;margin-top:34rpx;padding-top:20rpx;border-top:2rpx solid rgba(255,255,255,.25);font:21rpx/1 sans-serif}.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:18rpx}.quick-card{padding:24rpx;border:2rpx solid #D8CCBE;border-radius:24rpx;text-align:left;background:#FFFDF8}.quick-card text{color:#BD4E4E;font:26rpx/1 Georgia,serif}.quick-card .label,.quick-card .small{display:block}.quick-card .label{margin-top:22rpx;font-size:28rpx;font-weight:700}.quick-card .small{margin-top:9rpx;color:#817970;font:20rpx/1 sans-serif}.pet-card{width:100%;display:flex;align-items:center;gap:22rpx;margin-top:18rpx;padding:28rpx;border:2rpx solid #D1C5B7;border-radius:28rpx;text-align:left;background:#FFF8ED}.pet-scene{position:relative;width:150rpx;height:150rpx;display:flex;align-items:center;justify-content:center}.pet-body{position:relative;width:100rpx;height:82rpx;border-radius:48% 52% 45% 45%;background:#F4E5D2;box-shadow:inset -9rpx -8rpx 0 rgba(177,142,103,.16)}.pet-body::before,.pet-body::after{content:'';position:absolute;top:-20rpx;width:39rpx;height:45rpx;background:#F4E5D2;transform:rotate(35deg);border-radius:10rpx}.pet-body::before{left:7rpx}.pet-body::after{right:7rpx;transform:rotate(-35deg)}.pet-body .decor{position:absolute;z-index:2;top:34rpx;width:7rpx;height:9rpx;border-radius:50%;background:#554B43}.pet-body .decor:first-child{left:30rpx}.pet-body .decor:nth-child(2){right:30rpx}.pet-body text{position:absolute;z-index:2;left:44rpx;top:45rpx;color:#BD4E4E}.pet-shadow{position:absolute;width:110rpx;height:20rpx;bottom:15rpx;border-radius:50%;background:rgba(70,55,44,.12)}.pet-copy{flex:1}.pet-name{display:block;margin-top:10rpx;font-size:30rpx;font-weight:700}.pet-copy .label,.pet-copy .small{display:block}.pet-copy .label{margin-top:7rpx;color:#817970;font:20rpx/1 sans-serif}.growth-track{height:10rpx;margin-top:16rpx;border-radius:5rpx;background:#E4D8C9;overflow:hidden}.growth-track .decor{display:block;height:100%;background:#BD4E4E}.pet-copy .small{margin-top:7rpx;color:#817970;font:18rpx/1 sans-serif}.pet-arrow{color:#BD4E4E;font-size:40rpx}.memory-prompt{margin-top:22rpx;padding:25rpx;border-left:6rpx solid #B4813C;background:rgba(255,253,248,.65)}.memory-prompt text,.memory-prompt .label{display:block}.memory-prompt text{color:#B4813C;font:20rpx/1 sans-serif;letter-spacing:2rpx}.memory-prompt .label{margin-top:12rpx;font-size:27rpx}.memory-prompt button{margin-top:16rpx;color:#557263;background:transparent;text-align:left;font:21rpx/1 sans-serif}
