<view class="page couple-page home-refined">
  <view class="couple-heading">
    <view class="heading-copy">
      <text class="display-title">我们</text>
      <text class="section-note">两个人的关系、回应和共同生活</text>
    </view>
    <button size="mini" class="settings-button press" bindtap="settings">设置</button>
  </view>

  <view wx:if="{{error}}" class="status-banner status-banner--error" role="alert">
    <text>{{error}}</text>
    <button size="mini" bindtap="retry">重试</button>
  </view>

  <view wx:if="{{loading && loaded}}" class="sync-status" role="status">
    <view aria-hidden="true"></view>
    <text>正在同步关系空间，已保存的内容仍可查看</text>
  </view>

  <view wx:if="{{loading && !loaded}}" class="relationship-skeleton" role="status" aria-label="正在读取关系空间">
    <view class="album-grid" aria-hidden="true">
      <view class="album-column">
        <view class="skeleton-photo skeleton-photo--portrait skeleton-block"></view>
        <view class="skeleton-photo skeleton-block"></view>
      </view>
      <view class="album-column">
        <view class="skeleton-photo skeleton-block"></view>
        <view class="skeleton-photo skeleton-photo--portrait skeleton-block"></view>
      </view>
    </view>
    <text>正在确认你们的空间</text>
  </view>

  <view wx:elif="{{couple.status === 'UNPAIRED'}}" class="relationship-state invite-state">
    <view class="pair-preview" aria-label="你已加入，正在等待另一半">
      <view class="preview-person">
        <view class="preview-avatar mine">
          <image wx:if="{{myAvatarUrl}}" src="{{myAvatarUrl}}" mode="aspectFill"></image>
          <text wx:else>{{myInitial}}</text>
        </view>
        <text>你</text>
      </view>
      <text class="pair-word">和</text>
      <view class="preview-person waiting">
        <view class="preview-avatar"><text>TA</text></view>
        <text>等待加入</text>
      </view>
    </view>

    <view class="state-copy">
      <text class="state-title">邀请 TA，一起留下生活里的片刻</text>
      <text class="state-description">配对后，你们可以分享记录、回应彼此，也可以随时查看共享范围。</text>
    </view>

    <view class="state-actions">
      <button size="mini" class="primary-button press" bindtap="invite">邀请另一半</button>
      <button size="mini" class="text-button press" bindtap="privacy">了解共享方式</button>
    </view>
  </view>

  <view wx:elif="{{couple.status === 'ENDED'}}" class="relationship-state ended-state">
    <view class="state-rule" aria-hidden="true"></view>
    <text class="state-title">情侣空间已停止访问</text>
    <text class="state-description">你仍可在“甜蜜”中查看自己创建的记录；对方上传的内容和原情侣回顾已隐藏。</text>
    <text class="state-description">重新邀请会建立新的情侣空间，旧空间的记录不会自动共享。</text>
    <view class="state-actions">
      <button size="mini" class="primary-button press" bindtap="invite">重新邀请另一半</button>
      <button size="mini" class="secondary-button press" bindtap="privacy">查看隐私设置</button>
    </view>
  </view>

  <block wx:elif="{{couple.status === 'PAIRED'}}">
    <view class="album-section">
      <text class="section-title">相册</text>
      <view wx:if="{{albumCount}}" class="album-grid {{albumCount === 1 ? 'album-grid--single' : ''}}">
        <view wx:for="{{[0,1]}}" wx:for-item="columnIndex" wx:key="*this" wx:if="{{albumColumns[columnIndex].length}}" class="album-column">
          <button
            wx:for="{{albumColumns[columnIndex]}}" wx:for-item="photo" wx:for-index="photoIndex" wx:key="key"
            size="mini" class="album-photo album-photo--{{photo.aspect}} press"
            data-column="{{columnIndex}}" data-index="{{photoIndex}}" bindtap="openAlbumPhoto"
            aria-label="{{photo.title || '共同照片'}}，打开记录"
          >
            <image
              wx:if="{{!photo.error}}" class="album-image" src="{{photo.path}}" mode="aspectFill"
              lazy-load="{{photoIndex > 0}}" data-column="{{columnIndex}}" data-index="{{photoIndex}}"
              style="transform: translate3d(0, {{columnIndex === 0 ? albumOffset : -albumOffset}}px, 0);"
              bindload="albumPhotoLoaded" binderror="albumPhotoError" aria-hidden="true"
            ></image>
            <view wx:else class="album-photo-error" role="status">
              <text>媒体没有加载完成</text>
              <text>打开记录后可重新尝试</text>
            </view>
          </button>
        </view>
      </view>
      <view wx:else class="album-empty" role="status">
        <text>{{albumLoading ? '正在整理共同照片' : error ? '共同照片暂时无法读取' : '还没有共同照片'}}</text>
        <text wx:if="{{!albumLoading && !error}}">把照片留在共同可见的记录里，就会出现在这里。</text>
      </view>
    </view>

    <view class="relationship-summary">
      <view class="relationship-topline">
        <view class="relationship-people" aria-label="你和另一半">
          <view class="person-avatar mine">
            <image wx:if="{{myAvatarUrl}}" src="{{myAvatarUrl}}" mode="aspectFill"></image>
            <text wx:else>{{myInitial}}</text>
          </view>
          <text class="people-join">和</text>
          <view class="person-avatar partner">
            <image wx:if="{{partnerAvatarUrl}}" src="{{partnerAvatarUrl}}" mode="aspectFill"></image>
            <text wx:else>{{partnerInitial}}</text>
          </view>
        </view>
        <text class="relationship-name">{{couple.relationshipName || '我们的空间'}}</text>
        <button size="mini" class="edit-relationship press" bindtap="openProfileEditor">编辑资料</button>
      </view>

      <view class="relationship-meta">
        <view wx:if="{{days}}" class="days-statement">
          <text>我们一起走过</text>
          <text class="days-number numeric">{{days}}</text>
          <text>天</text>
        </view>
        <button wx:else size="mini" class="missing-anniversary press" bindtap="openProfileEditor">还没有设置在一起的日期</button>
        <view class="anniversary-line">
          <text>纪念日</text>
          <text class="numeric">{{couple.anniversary || '等你们一起定下'}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{editing}}" class="relation-editor" aria-label="编辑关系资料">
      <view class="editor-head">
        <view>
          <text class="editor-title">编辑关系资料</text>
          <text class="editor-note">保存后会同步给对方</text>
        </view>
        <button size="mini" class="text-button" disabled="{{savingProfile}}" bindtap="closeProfileEditor">取消</button>
      </view>

      <view class="form-item">
        <text class="form-label">关系昵称</text>
        <input
          class="input"
          value="{{editName}}"
          maxlength="40"
          placeholder="例如：满屿之间"
          aria-label="关系昵称"
          bindinput="nameInput"
        />
        <text class="form-helper">用于标记你们共同的空间</text>
      </view>

      <view class="form-item">
        <view class="form-label-row">
          <text class="form-label">在一起的日期</text>
          <text class="form-optional">可留空</text>
        </view>
        <picker class="date-control" mode="date" value="{{editAnniversary}}" bindchange="anniversaryChange">
          <view class="date-picker press" role="button" aria-label="选择在一起的日期">
            <text>{{editAnniversary || '选择日期'}}</text>
            <text>更改</text>
          </view>
        </picker>
        <view class="date-helper">
          <text class="form-helper">用于计算在一起的天数</text>
          <button size="mini" class="clear-date" disabled="{{!editAnniversary || savingProfile}}" bindtap="clearAnniversary">清空日期</button>
        </view>
      </view>

      <button size="mini" class="primary-button press" loading="{{savingProfile}}" disabled="{{savingProfile}}" bindtap="saveProfile">
        {{savingProfile ? '正在保存' : '保存资料'}}
      </button>
    </view>

    <view class="shared-section">
      <view class="section-heading">
        <text class="section-title">最近的共同生活</text>
        <text class="section-note">回应、记录和一起养成的日常，都从这里继续</text>
      </view>

      <view class="shared-ledger">
        <button size="mini" class="ledger-row press" bindtap="messages">
          <image class="ledger-icon" src="/assets/icons/home/mail.png" mode="aspectFit" aria-hidden="true"></image>
          <view class="ledger-copy">
            <text class="ledger-title">TA 最近的回应</text>
            <text class="ledger-description">{{unread ? '有新的回应和悄悄话等你查看' : '今天的消息已经读完'}}</text>
          </view>
          <view class="ledger-action">
            <text wx:if="{{unread}}" class="unread-count numeric">{{unread > 99 ? '99+' : unread}}</text>
            <text>{{unread ? '查看' : '已读'}}</text>
          </view>
        </button>

        <view class="shared-count-row">
          <image class="ledger-icon" src="/assets/icons/home/images.png" mode="aspectFit" aria-hidden="true"></image>
          <view class="ledger-copy">
            <view class="shared-count-line"><text class="shared-count numeric">{{sharedCount}}</text><text>个共同瞬间</text></view>
            <text class="ledger-description">只统计你们共同可见的记录</text>
          </view>
        </view>

        <button size="mini" class="ledger-row pet-row press" bindtap="pet">
          <image class="ledger-icon" src="/assets/icons/home/cat.png" mode="aspectFit" aria-hidden="true"></image>
          <view class="pet-copy">
            <text class="ledger-title">{{pet.name}} · Lv.{{pet.level}}</text>
            <text class="ledger-description">{{pet.kind}}也在记录你们一起陪伴的时间</text>
            <view class="growth-track" aria-label="成长进度">
              <view class="growth-value" style="width: {{pet.growthPercent}}%"></view>
            </view>
          </view>
          <view class="ledger-action"><text>查看</text></view>
        </button>
      </view>
    </view>

    <view class="couple-closing">
      <text>今天也值得留下</text>
      <text>想记录什么时，从下方“这一刻”开始。</text>
    </view>
  </block>
</view>
