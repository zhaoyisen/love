.time-page {
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
}

.time-hero {
  position: relative;
  overflow: hidden;
  margin: -6rpx -6rpx 0;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 38rpx;
  color: #FFF8F1;
  background:
    radial-gradient(circle at 80% 16%, rgba(255, 248, 241, .22), transparent 30%),
    linear-gradient(145deg, #B64A4B 0%, #7D3F42 52%, #3E554A 100%);
  box-shadow: 0 26rpx 54rpx rgba(83, 49, 45, .22);
}

.hero-orbit {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, .22);
  border-radius: 50%;
  pointer-events: none;
}

.hero-orbit-a {
  right: -120rpx;
  top: -120rpx;
  width: 330rpx;
  height: 330rpx;
}

.hero-orbit-b {
  right: 42rpx;
  bottom: -150rpx;
  width: 260rpx;
  height: 260rpx;
  transform: rotate(28deg);
}

.top-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 126rpx;
  padding-top: 4rpx;
}

.top-row > view {
  flex: 1 1 auto;
  min-width: 0;
}

.time-hero .eyebrow {
  color: rgba(255, 236, 218, .9);
}

.top-row .display-title {
  margin-top: 12rpx;
  color: #FFF8F1;
  font-size: 52rpx;
  line-height: 1.14;
  white-space: normal;
}

.message-button {
  position: relative;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 136rpx;
  height: 66rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(255, 255, 255, .36);
  border-radius: 22rpx;
  color: #FFF8F1;
  background: rgba(255, 255, 255, .12);
  box-shadow: none;
  font: 700 23rpx/1.2 "PingFang SC", sans-serif;
  white-space: nowrap;
}

.message-icon {
  position: relative;
  flex: 0 0 auto;
  width: 31rpx;
  height: 23rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
}

.message-icon::before,
.message-icon::after {
  content: "";
  position: absolute;
  top: 5rpx;
  width: 17rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.message-icon::before {
  left: 0;
  transform: rotate(34deg);
}

.message-icon::after {
  right: 0;
  transform: rotate(-34deg);
}

.message-label {
  white-space: nowrap;
}

.message-badge {
  position: absolute;
  right: -8rpx;
  top: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border: 4rpx solid #F7F1E8;
  border-radius: 18rpx;
  color: #FFF9F4;
  background: #A94444;
  box-sizing: content-box;
  font: 700 17rpx/28rpx "PingFang SC", sans-serif;
}

.hero-footer {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 54rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(255, 255, 255, .24);
}

.hero-footer view {
  flex: 1 1 auto;
  min-width: 0;
}

.hero-footer view text {
  display: block;
}

.hero-footer view text:first-child {
  color: rgba(255, 236, 218, .92);
  font: 700 19rpx/1 "PingFang SC", sans-serif;
  letter-spacing: 4rpx;
}

.hero-footer view text:last-child {
  margin-top: 10rpx;
  color: rgba(255, 248, 241, .82);
  font: 22rpx/1.45 "PingFang SC", sans-serif;
}

.hero-mark {
  flex: 0 0 auto;
  color: rgba(255, 248, 241, .75);
  font: 56rpx/1 Georgia, serif;
}

.view-tabs {
  width: 100%;
  margin-top: 26rpx;
  padding: 7rpx;
  border: 2rpx solid #D8CDC0;
  border-radius: 24rpx;
  background: rgba(232, 224, 215, .82);
  box-shadow: inset 0 2rpx 8rpx rgba(82, 63, 47, .05);
}

.view-tabs-inner {
  width: 100%;
  display: flex;
  align-items: stretch;
  gap: 5rpx;
}

.view-tab {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  max-width: none;
  height: 64rpx;
  padding: 0;
  border-radius: 18rpx;
  color: #817970;
  background: transparent;
  font: 700 23rpx/1.2 "PingFang SC", sans-serif;
  text-align: center;
  white-space: nowrap;
}

.view-tab.active {
  color: #2D2926;
  background: #FFFDF8;
  box-shadow: 0 7rpx 16rpx rgba(62, 48, 38, .09);
}

.summary-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  margin-top: 22rpx;
  padding: 18rpx;
  border: 0;
  border-radius: 28rpx;
  background: rgba(255, 253, 248, .78);
  box-shadow: 0 16rpx 34rpx rgba(62, 48, 38, .08);
}

.summary-metric {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  flex: 1 1 0;
  min-width: 0;
  min-height: 92rpx;
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: #FFFDF8;
}

.summary-number {
  color: #A94444;
  font: 800 38rpx/1.1 Georgia, serif;
}

.summary-label {
  color: #817970;
  font: 21rpx/1.2 "PingFang SC", sans-serif;
  white-space: nowrap;
}

.summary-divider {
  display: none;
}

.filter-button {
  flex: 1 1 auto;
  min-width: 0;
  max-width: 240rpx;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 92rpx;
  padding: 0 18rpx;
  border: 2rpx solid #C5D4CA;
  border-radius: 18rpx;
  color: #496153;
  background: #E5EEE7;
  font: 700 21rpx/1.2 "PingFang SC", sans-serif;
  white-space: nowrap;
}

.filter-button text:last-child {
  overflow: hidden;
  color: #6E7D72;
  font-weight: 500;
  text-overflow: ellipsis;
}

.filter-sheet {
  margin-top: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #DED4C8;
  border-radius: 22rpx;
  background: rgba(255, 253, 248, .94);
  box-shadow: 0 12rpx 28rpx rgba(62, 48, 38, .06);
  font: 700 24rpx/1 "PingFang SC", sans-serif;
  transform-origin: top center;
  animation: sheet-in 220ms cubic-bezier(.22, 1, .36, 1) both;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.week-strip {
  display: flex;
  margin-top: 24rpx;
  padding: 24rpx 12rpx;
}

.week-day {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: #817970;
  font: 21rpx/1 "PingFang SC", sans-serif;
}

.week-number {
  font: 700 27rpx/1 Georgia, serif;
}

.week-day.active .week-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  color: #FFF8F1;
  background: #BD4E4E;
}

.week-day .decor,
.calendar-day .decor {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #557263;
}

.calendar-card,
.year-card,
.custom-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.calendar-heading,
.year-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.calendar-heading > text:first-child,
.year-heading > text:first-child {
  flex: 0 0 auto;
  font-size: 34rpx;
  font-weight: 800;
}

.calendar-heading > text:last-child,
.year-heading > text:last-child {
  flex: 1;
  min-width: 0;
  color: #817970;
  font: 21rpx/1.35 "PingFang SC", sans-serif;
  text-align: right;
}

.calendar-week,
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  text-align: center;
}

.calendar-week {
  margin-top: 24rpx;
  color: #9C9186;
  font: 20rpx/1 "PingFang SC", sans-serif;
}

.calendar-week > text,
.calendar-day {
  flex: 0 0 14.2857%;
  width: 14.2857%;
  box-sizing: border-box;
}

.calendar-grid {
  margin-top: 12rpx;
}

.calendar-day {
  height: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  font: 700 22rpx/1 Georgia, serif;
}

.calendar-day.muted {
  opacity: .32;
}

.calendar-day.active text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #FFF8F1;
  background: #BD4E4E;
}

.month-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.month-cell {
  flex: 0 0 calc((100% - 24rpx) / 3);
  width: calc((100% - 24rpx) / 3);
  min-width: 0;
  height: 92rpx;
  padding: 16rpx;
  border: 2rpx solid #E5DBCF;
  border-radius: 18rpx;
  color: #91867B;
  font: 21rpx/1 "PingFang SC", sans-serif;
  box-sizing: border-box;
}

.month-cell.has-record {
  color: #4D6659;
  background: #DCE7DC;
  border-color: #B6C9BA;
}

.month-count {
  display: block;
  margin-top: 12rpx;
  font: 700 26rpx/1 Georgia, serif;
}

.date-range {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
}

.date-range picker {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
}

.date-range view {
  width: 100%;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #EEE7DC;
}

.date-range view text {
  display: block;
}

.date-range view text:first-child {
  margin-bottom: 8rpx;
  color: #817970;
  font: 20rpx/1 "PingFang SC", sans-serif;
}

.date-range view text:last-child {
  overflow: hidden;
  font: 22rpx/1 "PingFang SC", sans-serif;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-row {
  margin-top: 40rpx;
}

.section-row .section-note {
  margin-top: 8rpx;
}

.sync-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #6E766F;
  font: 22rpx/1 "PingFang SC", sans-serif;
}

.sync-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #557263;
  animation: sync-pulse 1.2s ease-in-out infinite;
}

@keyframes sync-pulse {
  0%, 100% { opacity: .35; transform: scale(.85); }
  50% { opacity: 1; transform: scale(1); }
}

@keyframes sheet-in {
  from { opacity: 0; transform: translateY(-10rpx) scale(.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes content-in {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: no-preference) {
  .top-row,
  .view-tabs,
  .summary-card,
  .week-strip,
  .calendar-card,
  .year-card,
  .custom-card,
  .section-row {
    animation: content-in 240ms cubic-bezier(.22, 1, .36, 1) both;
  }
}

@media (prefers-reduced-motion: reduce) {
  .filter-sheet,
  .sync-dot {
    animation: none;
  }
}

/* Double-film sweet feed */
.sweet-feed-page { padding: 0 0 calc(170rpx + env(safe-area-inset-bottom)); background: transparent; }
.sunset-hero { position: relative; min-height: 418rpx; padding: 26rpx 34rpx 48rpx; overflow: hidden; color: #FFF8F1; background: linear-gradient(158deg,#795665 0%,#A85660 40%,#D77D67 72%,#E7A16B 100%); }
.sunset-glow { position: absolute; right: -96rpx; top: 104rpx; width: 360rpx; height: 360rpx; border-radius: 50%; background: radial-gradient(circle,rgba(255,224,173,.82) 0%,rgba(255,195,137,.20) 53%,transparent 70%); }
.sunset-hero::after { content: ""; position: absolute; left: -8%; right: -8%; bottom: -44rpx; height: 82rpx; border-radius: 50% 50% 0 0; background: #F7EDE2; }
.feed-topbar,.couple-signature,.sunset-title,.sunset-copy,.capture-button,.film-meta { position: relative; z-index: 1; }
.feed-topbar { display: flex; align-items: flex-start; justify-content: space-between; }
.feed-brand { display: block; font-size: 31rpx; font-weight: 800; letter-spacing: 2rpx; }
.feed-date { display: block; margin-top: 7rpx; color: rgba(255,248,241,.72); font-size: 19rpx; letter-spacing: 2rpx; }
.feed-message { position: relative; flex: 0 0 104rpx; width: 104rpx; min-width: 104rpx; max-width: 104rpx; height: 64rpx; padding: 0; border: 2rpx solid rgba(255,248,241,.58); border-radius: 32rpx; color: #FFF8F1; background: rgba(82,47,58,.18); font-size: 23rpx; white-space: nowrap; }
.feed-message-count { position: absolute; right: -8rpx; top: -10rpx; display: flex; align-items: center; justify-content: center; min-width: 31rpx; height: 31rpx; padding: 0 8rpx; border-radius: 18rpx; color: #A84454; background: #FFF5EA; font-size: 18rpx; font-weight: 800; }
.couple-signature { display: flex; align-items: center; gap: 14rpx; margin-top: 14rpx; color: rgba(255,248,241,.88); font-size: 21rpx; }
.signature-avatars { display: flex; }
.signature-avatar { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border: 3rpx solid rgba(255,248,241,.84); border-radius: 50%; color: #FFF8F1; font-size: 18rpx; font-weight: 800; background: #9A4857; }
.signature-avatar.partner { margin-left: -13rpx; background: #6C5869; }
.sunset-title { display: block; margin-top: 10rpx; max-width: 590rpx; font-size: 44rpx; font-weight: 800; line-height: 1.16; letter-spacing: -1rpx; }
.sunset-title > text { display: block; }
.sunset-copy { display: block; width: 590rpx; max-width: 92%; margin-top: 12rpx; color: rgba(255,248,241,.90); font-size: 23rpx; line-height: 1.5; }
.capture-button { display: flex; align-items: center; gap: 14rpx; width: 310rpx; min-height: 76rpx; margin-top: 13rpx; padding: 10rpx 18rpx; border-radius: 21rpx; color: #8E3D4B; background: #FFF5E9; box-shadow: 0 12rpx 26rpx rgba(88,43,54,.16); text-align: left; }
.capture-plus { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 50%; color: #FFF8F1; background: #B94E5A; font-size: 31rpx; }
.capture-button view text { display: block; font-size: 25rpx; font-weight: 800; }
.capture-button view text:last-child { margin-top: 5rpx; color: #9A7771; font-size: 18rpx; font-weight: 400; }
.film-meta { display: none; }
.memory-toolbar { position: relative; z-index: 3; display: flex; gap: 10rpx; margin: -22rpx 24rpx 0; padding: 10rpx; border: 2rpx solid rgba(227,206,194,.8); border-radius: 24rpx; background: rgba(255,249,242,.98); box-shadow: 0 14rpx 30rpx rgba(96,55,60,.10); }
.memory-tabs { flex: 1; min-width: 0; white-space: nowrap; }
.memory-tabs-inner { display: inline-flex; gap: 5rpx; }
.memory-tab { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 104rpx; width: 104rpx; min-width: 104rpx; height: 62rpx; padding: 0; border-radius: 19rpx; color: #765F5D; font-size: 22rpx; }
.memory-tab.active { color: #FFF8F1; background: #A94856; }
.mood-filter { flex: 0 0 auto; display: flex; align-items: center; gap: 8rpx; padding: 0 16rpx; color: #85505A; font-size: 21rpx; }
.sweet-filter { margin: 18rpx 24rpx 0; padding: 24rpx; border: 2rpx solid #E3CEC2; border-radius: 24rpx; background: rgba(255,249,242,.96); }
.sweet-filter>text { display: block; margin-bottom: 18rpx; font-size: 24rpx; font-weight: 800; }
.filter-chips { display: flex; flex-wrap: wrap; gap: 10rpx; }
.sweet-week,.sweet-calendar,.sweet-year,.sweet-range { margin: 24rpx 24rpx 0; border: 2rpx solid #E3CEC2; border-radius: 26rpx; background: rgba(255,249,242,.92); box-shadow: 0 12rpx 28rpx rgba(90,55,56,.06); }
.sweet-week { display: flex; padding: 18rpx 10rpx; }
.sweet-day { position: relative; flex: 1 1 0; display: flex; flex-direction: column; align-items: center; gap: 9rpx; min-width: 0; padding: 12rpx 0 17rpx; color: #8B7976; font-size: 20rpx; }
.sweet-day text:nth-child(2) { font-size: 28rpx; font-weight: 800; }
.sweet-day>view { position: absolute; bottom: 5rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #B94E5A; }
.sweet-day.active { color: #FFF8F1; border-radius: 19rpx; background: #B94E5A; }
.sweet-calendar,.sweet-year,.sweet-range { padding: 26rpx; }
.sweet-calendar .calendar-heading,.sweet-year .year-heading { display: flex; align-items: baseline; justify-content: space-between; }
.sweet-calendar .calendar-heading text:first-child,.sweet-year .year-heading text:first-child { font-size: 32rpx; font-weight: 900; }
.sweet-calendar .calendar-heading text:last-child,.sweet-year .year-heading text:last-child { color: #9A7771; font-size: 20rpx; }
.sweet-calendar .calendar-week,.sweet-calendar .calendar-grid { display: flex; flex-wrap: wrap; }
.sweet-calendar .calendar-week { margin-top: 24rpx; color: #A18E89; font-size: 18rpx; }
.sweet-calendar .calendar-week text,.sweet-calendar .calendar-day { flex: 0 0 14.285%; width: 14.285%; text-align: center; }
.sweet-calendar .calendar-day { position: relative; display: flex; align-items: center; justify-content: center; height: 64rpx; font-size: 22rpx; }
.sweet-calendar .calendar-day.muted { opacity: .3; }
.sweet-calendar .calendar-day.active text { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border-radius: 50%; color: #FFF8F1; background: #B94E5A; }
.sweet-calendar .calendar-day>view { position: absolute; bottom: 1rpx; width: 6rpx; height: 6rpx; border-radius: 50%; background: #D88759; }
.sweet-year .month-grid { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 24rpx; }
.sweet-year .month-cell { flex: 0 0 calc(25% - 8rpx); width: calc(25% - 8rpx); padding: 16rpx 8rpx; border-radius: 16rpx; color: #8B7976; background: #F5E8DF; text-align: center; }
.sweet-year .month-cell text { display: block; font-size: 19rpx; }
.sweet-year .month-cell text:last-child { margin-top: 8rpx; font-size: 26rpx; font-weight: 900; }
.sweet-year .month-cell.has-record { color: #8D4050; background: #F3D7D5; }
.sweet-range .date-range { display: flex; align-items: center; gap: 12rpx; margin-top: 22rpx; }
.sweet-range picker { flex: 1; }
.sweet-range picker view { padding: 18rpx; border-radius: 18rpx; background: #F4E5DB; }
.sweet-range picker text { display: block; font-size: 19rpx; }
.sweet-range picker text:last-child { margin-top: 6rpx; color: #A84454; font-size: 22rpx; font-weight: 700; }
.feed-section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 32rpx 28rpx 6rpx; }
.feed-section-head view text { display: block; font-size: 33rpx; font-weight: 900; }
.feed-section-head view text:last-child { margin-top: 8rpx; color: #8B7976; font-size: 20rpx; font-weight: 400; }
.film-count { flex: 0 0 auto; color: #A84454; font-size: 20rpx; font-weight: 800; letter-spacing: 0; }
.sweet-feed-page moment-card { display: block; margin: 0 24rpx; }
.sweet-feed-page empty-state { display: block; margin: 18rpx 24rpx; }
.sweet-feed-page .load-more { display: flex; align-items: center; justify-content: center; width: calc(100% - 48rpx); height: 82rpx; margin: 24rpx; border: 2rpx solid #D3B7A8; border-radius: 22rpx; color: #9B4654; background: #FFF9F2; font-size: 24rpx; font-weight: 700; }
@media (prefers-reduced-motion: no-preference) { .sunset-title,.capture-button,.memory-toolbar,.feed-section-head { animation: content-in 260ms cubic-bezier(.22,1,.36,1) both; } }
