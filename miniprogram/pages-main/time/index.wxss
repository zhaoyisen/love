.time-page { background-image: linear-gradient(rgba(176,149,120,.07) 1rpx,transparent 1rpx); background-size: 100% 48rpx; }
.top-row { display: flex; align-items: flex-start; justify-content: space-between; }
.display-title { display: block; font-size: 48rpx; }
.message-button { position: relative; display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border: 2rpx solid #DED4C8; border-radius: 50%; color: #557263; background: #FFFDF8; font-size: 27rpx; }
.message-button text { position: absolute; right: -3rpx; top: -5rpx; min-width: 30rpx; height: 30rpx; padding: 0 7rpx; border-radius: 15rpx; color: #FFF; background: #BD4E4E; font: 18rpx/30rpx sans-serif; }
.view-tabs { margin: 34rpx -32rpx 0; width: calc(100% + 64rpx); white-space: nowrap; }
.view-tabs-inner { display: inline-flex; gap: 8rpx; padding: 0 32rpx; }
.view-tab { min-width: 106rpx; height: 64rpx; border-radius: 32rpx; color: #817970; background: transparent; font: 25rpx/1 sans-serif; }
.view-tab.active { color: #FFF; background: #2B2825; }
.summary-card { display: flex; align-items: center; margin-top: 26rpx; padding: 24rpx; border: 2rpx solid #D5C8BA; border-radius: 24rpx; background: rgba(255,253,248,.7); }
.summary-card > view { display: flex; align-items: baseline; gap: 8rpx; }
.summary-number { color: #BD4E4E; font: 700 40rpx/1 Georgia,serif; }.summary-label{color:#817970;font:21rpx/1 sans-serif}.summary-divider{width:2rpx;height:38rpx;margin:0 22rpx;background:#D5C8BA}.filter-button{margin-left:auto;padding:18rpx 20rpx;border-radius:28rpx;color:#557263;background:#DCE7DC;font:21rpx/1 sans-serif}
.filter-sheet { margin-top: 16rpx; padding: 24rpx; border-radius: 24rpx; background: #FFFDF8; border: 2rpx solid #DED4C8; font: 23rpx/1 sans-serif; }
.filter-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.week-strip { display: grid; grid-template-columns: repeat(7,1fr); margin-top: 24rpx; padding: 24rpx 10rpx; }
.week-day { display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #817970; font: 20rpx/1 sans-serif; }.week-number{font:26rpx/1 Georgia,serif}.week-day.active .week-number{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:50%;color:#FFF;background:#BD4E4E}.week-day .decor,.calendar-day .decor{width:8rpx;height:8rpx;border-radius:50%;background:#557263}
.calendar-card,.year-card,.custom-card { margin-top: 24rpx; padding: 26rpx; }
.calendar-heading,.year-heading { display:flex;align-items:baseline;justify-content:space-between }.calendar-heading>text:first-child,.year-heading>text:first-child{font-size:34rpx;font-weight:700}.calendar-heading>text:last-child,.year-heading>text:last-child{color:#817970;font:20rpx/1 sans-serif}.calendar-week,.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);text-align:center}.calendar-week{margin-top:24rpx;color:#9C9186;font:19rpx/1 sans-serif}.calendar-grid{margin-top:12rpx}.calendar-day{height:58rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;font:22rpx/1 Georgia,serif}.calendar-day.muted{opacity:.3}.calendar-day.active text{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:50%;color:#FFF;background:#BD4E4E}
.month-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; margin-top: 24rpx; }.month-cell{height:90rpx;padding:16rpx;border:2rpx solid #E5DBCF;border-radius:16rpx;color:#91867B;font:20rpx/1 sans-serif}.month-cell.has-record{color:#4D6659;background:#DCE7DC;border-color:#B6C9BA}.month-count{display:block;margin-top:12rpx;font:26rpx/1 Georgia,serif}
.date-range { display:flex;align-items:center;gap:14rpx;margin-top:24rpx }.date-range view{flex:1;padding:18rpx;border-radius:16rpx;background:#EEE7DC}.date-range view text{display:block}.date-range view text:first-child{margin-bottom:8rpx;color:#817970;font:19rpx/1 sans-serif}.date-range view text:last-child{font:22rpx/1 sans-serif}
.section-row { margin-top: 42rpx; }
.sync-status { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; color: #6E766F; font: 22rpx/1 sans-serif; }
.sync-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #557263; animation: sync-pulse 1.2s ease-in-out infinite; }
@keyframes sync-pulse { 0%,100% { opacity: .35; transform: scale(.85); } 50% { opacity: 1; transform: scale(1); } }
