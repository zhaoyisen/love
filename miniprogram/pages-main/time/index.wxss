.time-page { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); background: #F7F1E8; }
.top-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 112rpx; }
.top-row > view { flex: 1; min-width: 0; }
.display-title { display: block; margin-top: 10rpx; font-size: 44rpx; line-height: 1.25; white-space: nowrap; }
.message-button { position: relative; flex: 0 0 132rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; width: 132rpx; min-width: 132rpx; max-width: 132rpx; height: 66rpx; padding: 0 18rpx; border: 2rpx solid #D9CEC2; border-radius: 20rpx; color: #4E6658; background: #FCF9F3; font: 600 23rpx/1.2 "PingFang SC",sans-serif; box-shadow: 0 5rpx 14rpx rgba(62,48,38,.06); }
.message-icon { position: relative; width: 31rpx; height: 23rpx; border: 3rpx solid currentColor; border-radius: 4rpx; box-sizing: border-box; }
.message-icon::before,.message-icon::after { content: ""; position: absolute; top: 5rpx; width: 17rpx; height: 3rpx; border-radius: 2rpx; background: currentColor; }
.message-icon::before { left: 0; transform: rotate(34deg); }
.message-icon::after { right: 0; transform: rotate(-34deg); }
.message-label { white-space: nowrap; }
.message-badge { position: absolute; right: -8rpx; top: -10rpx; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border: 4rpx solid #F7F1E8; border-radius: 18rpx; color: #FFF9F4; background: #A94444; font: 600 17rpx/28rpx sans-serif; box-sizing: content-box; }
.view-tabs { width: 100%; margin-top: 28rpx; padding: 6rpx; border: 2rpx solid #DDD3C7; border-radius: 22rpx; background: #ECE5DC; box-sizing: border-box; }
.view-tabs-inner { width: 100%; display: flex; align-items: stretch; gap: 4rpx; }
.view-tab { flex: 1 1 0; width: 0; min-width: 0; max-width: none; height: 62rpx; padding: 0; border-radius: 16rpx; color: #817970; background: transparent; font: 500 23rpx/1.2 "PingFang SC",sans-serif; text-align: center; white-space: nowrap; box-sizing: border-box; }
.view-tab.active { color: #2D2926; background: #FCF9F3; box-shadow: 0 4rpx 12rpx rgba(62,48,38,.08); font-weight: 600; }
.summary-card { display: flex; align-items: center; margin-top: 22rpx; padding: 22rpx 20rpx; border: 2rpx solid #D9CEC2; border-radius: 20rpx; background: #FCF9F3; box-shadow: 0 6rpx 18rpx rgba(62,48,38,.05); }
.summary-card > view { display: flex; align-items: baseline; gap: 8rpx; }
.summary-number { color: #A94444; font: 700 36rpx/1.1 Georgia,serif; }.summary-label{color:#817970;font:21rpx/1.2 sans-serif}.summary-divider{width:2rpx;height:34rpx;margin:0 18rpx;background:#DDD3C7}.filter-button{margin-left:auto;min-width:0;display:flex;align-items:center;gap:10rpx;padding:14rpx 18rpx;border:2rpx solid #C7D5CA;border-radius:16rpx;color:#496153;background:#E5EEE7;font:600 20rpx/1.2 sans-serif;white-space:nowrap}.filter-button text:last-child{font-weight:400;color:#6E7D72}
.filter-sheet { margin-top: 16rpx; padding: 24rpx; border-radius: 20rpx; background: #FCF9F3; border: 2rpx solid #DED4C8; font: 23rpx/1 sans-serif; animation: sheet-in 220ms cubic-bezier(.22,1,.36,1) both; transform-origin: top center; }
.filter-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.week-strip { display: flex; margin-top: 24rpx; padding: 24rpx 10rpx; }
.week-day { flex:1 1 0;width:0;display:flex;flex-direction:column;align-items:center;gap:12rpx;color:#817970;font:20rpx/1 sans-serif; }.week-number{font:26rpx/1 Georgia,serif}.week-day.active .week-number{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:50%;color:#FFF;background:#BD4E4E}.week-day .decor,.calendar-day .decor{width:8rpx;height:8rpx;border-radius:50%;background:#557263}
.calendar-card,.year-card,.custom-card { margin-top: 24rpx; padding: 26rpx; }
.calendar-heading,.year-heading { display:flex;align-items:baseline;justify-content:space-between }.calendar-heading>text:first-child,.year-heading>text:first-child{font-size:34rpx;font-weight:700}.calendar-heading>text:last-child,.year-heading>text:last-child{color:#817970;font:20rpx/1 sans-serif}.calendar-week,.calendar-grid{display:flex;flex-wrap:wrap;text-align:center}.calendar-week{margin-top:24rpx;color:#9C9186;font:19rpx/1 sans-serif}.calendar-week>text,.calendar-day{flex:0 0 14.2857%;width:14.2857%;box-sizing:border-box}.calendar-grid{margin-top:12rpx}.calendar-day{height:58rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;font:22rpx/1 Georgia,serif}.calendar-day.muted{opacity:.3}.calendar-day.active text{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:50%;color:#FFF;background:#BD4E4E}
.month-grid { display:flex;flex-wrap:wrap;gap:12rpx;margin-top:24rpx; }.month-cell{flex:0 0 calc((100% - 24rpx)/3);width:calc((100% - 24rpx)/3);height:90rpx;padding:16rpx;border:2rpx solid #E5DBCF;border-radius:16rpx;color:#91867B;font:20rpx/1 sans-serif;box-sizing:border-box}.month-cell.has-record{color:#4D6659;background:#DCE7DC;border-color:#B6C9BA}.month-count{display:block;margin-top:12rpx;font:26rpx/1 Georgia,serif}
.date-range { display:flex;align-items:center;gap:14rpx;margin-top:24rpx }.date-range view{flex:1;padding:18rpx;border-radius:16rpx;background:#EEE7DC}.date-range view text{display:block}.date-range view text:first-child{margin-bottom:8rpx;color:#817970;font:19rpx/1 sans-serif}.date-range view text:last-child{font:22rpx/1 sans-serif}
.section-row { margin-top: 38rpx; }
.sync-status { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; color: #6E766F; font: 22rpx/1 sans-serif; }
.sync-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #557263; animation: sync-pulse 1.2s ease-in-out infinite; }
@keyframes sync-pulse { 0%,100% { opacity: .35; transform: scale(.85); } 50% { opacity: 1; transform: scale(1); } }
@keyframes sheet-in { from { opacity: 0; transform: translateY(-10rpx) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes content-in { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: no-preference) { .top-row,.view-tabs,.summary-card { animation: content-in 220ms cubic-bezier(.22,1,.36,1) both; } }
@media (prefers-reduced-motion: reduce) { .filter-sheet,.sync-dot { animation: none; } }
