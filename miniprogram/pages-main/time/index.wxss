/* Hallmark · macrostructure: Long Document (chronological ledger) · genre: editorial · tone: warm, private, lived-in
 * theme: DESIGN.md · palette: berry on warm paper · pre-emit critique: P5 H5 E5 S5 R5 V5 · enrichment: user media only · motion: press + sync
 */

.time-page {
  padding-top: var(--space-xl);
}

.feed-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-lg);
  width: 100%;
}

.feed-heading {
  flex: 1;
  min-width: 0;
}

.feed-date {
  display: block;
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  font-weight: var(--weight-medium);
  line-height: var(--line-meta);
}

.feed-header .display-title {
  min-width: 0;
  margin-top: var(--space-3xs);
  overflow-wrap: anywhere;
}

.couple-signature {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-width: 0;
  margin-top: var(--space-md);
  color: var(--color-ink-secondary);
  font-size: var(--text-secondary);
  line-height: var(--line-secondary);
}

.couple-signature > text {
  min-width: 0;
  word-break: break-word;
}

.signature-avatars {
  display: flex;
  flex: 0 0 auto;
}

.signature-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--space-2xl);
  height: var(--space-2xl);
  overflow: hidden;
  border: var(--rule-thin) solid var(--color-surface);
  border-radius: var(--radius-round);
  color: var(--color-accent-strong);
  background: var(--color-accent-soft);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
}

.signature-avatar image {
  width: 100%;
  height: 100%;
}

.signature-avatar.partner {
  margin-left: calc(0rpx - var(--space-xs));
  color: var(--color-success);
  background: var(--color-success-bg);
}

.message-button {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: var(--touch-target);
  min-width: var(--touch-target);
  height: var(--touch-target);
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-md);
  color: var(--color-ink);
  background: var(--color-surface);
}

.message-envelope {
  position: relative;
  width: var(--space-xl);
  height: var(--space-lg);
  border: var(--rule-thin) solid currentColor;
  border-radius: var(--radius-sm);
}

.message-envelope::before,
.message-envelope::after {
  content: '';
  position: absolute;
  top: var(--space-2xs);
  width: var(--space-md);
  height: var(--rule-thin);
  background: currentColor;
}

.message-envelope::before {
  left: 0;
  transform: rotate(32deg);
  transform-origin: left center;
}

.message-envelope::after {
  right: 0;
  transform: rotate(-32deg);
  transform-origin: right center;
}

.message-badge {
  position: absolute;
  top: calc(0rpx - var(--space-2xs));
  right: calc(0rpx - var(--space-2xs));
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--line-meta);
  height: var(--line-meta);
  padding: 0 var(--space-2xs);
  border: var(--rule-thin) solid var(--color-paper);
  border-radius: var(--radius-pill);
  color: var(--color-accent-ink);
  background: var(--color-accent);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  line-height: 1;
}

.memory-toolbar {
  position: sticky;
  top: 0;
  z-index: var(--z-sticky);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  width: auto;
  margin: var(--space-xl) calc(0rpx - var(--page-gutter)) 0;
  padding: var(--space-sm) var(--page-gutter);
  border-top: var(--rule-thin) solid var(--color-rule);
  border-bottom: var(--rule-thin) solid var(--color-rule);
  background: var(--color-paper);
}

.memory-tabs {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.memory-tabs-inner {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2xs);
}

.memory-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  padding: 0 var(--space-sm);
  border-radius: var(--radius-sm);
  color: var(--color-ink-secondary);
  background: transparent;
  font-size: var(--text-meta);
  font-weight: var(--weight-medium);
  line-height: 1;
  white-space: nowrap;
}

.memory-tab.active {
  color: var(--color-accent-strong);
  background: var(--color-accent-soft);
  font-weight: var(--weight-semibold);
}

.mood-filter {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: var(--space-2xs);
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  padding: 0 var(--space-sm);
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-md);
  color: var(--color-ink-secondary);
  background: var(--color-surface);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  line-height: 1;
  white-space: nowrap;
}

.mood-filter.active {
  color: var(--color-accent-strong);
  border-color: var(--color-accent-strong);
}

.mood-panel {
  margin-top: var(--space-md);
  padding: var(--space-lg);
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-md);
  background: var(--color-surface-muted);
}

.mood-panel-title {
  display: block;
  color: var(--color-ink);
  font-size: var(--text-secondary);
  font-weight: var(--weight-semibold);
  line-height: var(--line-secondary);
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-top: var(--space-sm);
}

.sync-status {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-top: var(--space-md);
  color: var(--color-info);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.sync-status text {
  min-width: 0;
  word-break: break-word;
}

.sync-dot {
  flex: 0 0 auto;
  width: var(--space-xs);
  height: var(--space-xs);
  border-radius: var(--radius-round);
  background: var(--color-info);
  animation: sync-pulse var(--dur-loader) var(--ease-in-out) infinite;
}

.period-panel {
  margin-top: var(--space-xl);
}

.week-strip {
  display: flex;
  padding: var(--space-md) 0;
  border-top: var(--rule-thin) solid var(--color-rule);
  border-bottom: var(--rule-thin) solid var(--color-rule);
}

.week-day {
  position: relative;
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2xs);
  min-width: 0;
  min-height: var(--touch-target);
  padding: var(--space-2xs) 0 var(--space-sm);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.week-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--space-2xl);
  height: var(--space-2xl);
  border-radius: var(--radius-round);
  color: var(--color-ink);
  font-size: var(--text-secondary);
  font-weight: var(--weight-semibold);
}

.week-day.active .week-number {
  color: var(--color-accent-ink);
  background: var(--color-accent);
}

.record-dot {
  position: absolute;
  bottom: var(--space-3xs);
  width: var(--space-2xs);
  height: var(--space-2xs);
  border-radius: var(--radius-round);
  background: var(--color-shared);
}

.calendar-panel,
.year-panel,
.range-panel {
  padding: var(--space-lg);
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
}

.period-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-lg);
}

.period-heading text:first-child {
  color: var(--color-ink);
  font-size: var(--text-list-title);
  font-weight: var(--weight-semibold);
  line-height: var(--line-list-title);
}

.period-heading text:last-child {
  min-width: 0;
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  text-align: right;
  word-break: break-word;
}

.calendar-week,
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  text-align: center;
}

.calendar-week {
  margin-top: var(--space-lg);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.calendar-week > text,
.calendar-day {
  flex: 0 0 14.2857%;
  width: 14.2857%;
}

.calendar-grid {
  margin-top: var(--space-2xs);
}

.calendar-day {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-target);
  color: var(--color-ink);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.calendar-day.muted {
  color: var(--color-disabled-ink);
}

.calendar-day.active text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--space-2xl);
  height: var(--space-2xl);
  border-radius: var(--radius-round);
  color: var(--color-accent-ink);
  background: var(--color-accent);
}

.calendar-day .record-dot {
  bottom: var(--space-2xs);
}

.month-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--space-lg);
  border-top: var(--rule-thin) solid var(--color-rule);
  border-left: var(--rule-thin) solid var(--color-rule);
}

.month-cell {
  flex: 0 0 25%;
  width: 25%;
  min-width: 0;
  min-height: var(--touch-target);
  padding: var(--space-sm) var(--space-2xs);
  border-right: var(--rule-thin) solid var(--color-rule);
  border-bottom: var(--rule-thin) solid var(--color-rule);
  color: var(--color-ink-secondary);
  background: var(--color-surface);
  text-align: center;
}

.month-cell text {
  display: block;
  overflow: hidden;
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.month-cell text:last-child {
  margin-top: var(--space-3xs);
  font-weight: var(--weight-semibold);
}

.month-cell.has-record {
  color: var(--color-success);
  background: var(--color-success-bg);
}

.month-cell.is-current {
  box-shadow: inset 0 0 0 var(--rule-thin) var(--color-accent-strong);
}

.summary-note {
  display: block;
  margin-top: var(--space-md);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  text-align: center;
}

.range-panel .section-title {
  font-size: var(--text-list-title);
  line-height: var(--line-list-title);
}

.date-range {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.date-range picker {
  flex: 1 1 0;
  min-width: 0;
}

.date-range picker > view {
  min-height: var(--touch-target);
  padding: var(--space-sm);
  border: var(--rule-thin) solid var(--color-rule);
  border-radius: var(--radius-md);
  background: var(--color-surface-muted);
}

.date-range picker text {
  display: block;
  overflow: hidden;
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-range picker text:last-child {
  margin-top: var(--space-3xs);
  color: var(--color-ink);
  font-weight: var(--weight-semibold);
}

.feed-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-lg);
  margin-top: var(--space-2xl);
  padding-bottom: var(--space-sm);
  border-bottom: var(--rule-thin) solid var(--color-rule);
}

.feed-section-head > view {
  min-width: 0;
}

.feed-section-head view text {
  display: block;
  word-break: break-word;
}

.feed-section-head view text:first-child {
  color: var(--color-ink);
  font-size: var(--text-section-title);
  font-weight: var(--weight-bold);
  line-height: var(--line-section-title);
}

.feed-section-head view text:last-child {
  margin-top: var(--space-2xs);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.moment-count {
  flex: 0 0 auto;
  color: var(--color-accent-strong);
  font-size: var(--text-meta);
  font-weight: var(--weight-semibold);
  line-height: var(--line-meta);
  white-space: nowrap;
}

.timeline-list {
  width: 100%;
}

.timeline-list moment-card {
  display: block;
}

.timeline-list moment-card + moment-card {
  margin-top: var(--space-xl);
}

.time-page empty-state {
  display: block;
}

.time-page .load-more {
  margin-top: var(--space-xl);
}

.time-page button[disabled] {
  color: var(--color-disabled-ink);
  border-color: var(--color-rule);
  background: var(--color-disabled-bg);
  opacity: var(--opacity-disabled);
  box-shadow: none;
}

.timeline-skeleton {
  width: 100%;
  margin-top: var(--space-xl);
  color: var(--color-ink-secondary);
  font-size: var(--text-meta);
  line-height: var(--line-meta);
}

.skeleton-entry {
  padding: var(--space-xl) 0;
  border-bottom: var(--rule-thin) solid var(--color-rule);
}

.skeleton-meta {
  width: 44%;
  height: var(--line-meta);
}

.skeleton-media {
  width: 100%;
  height: var(--media-card-min-height);
  margin-top: var(--space-md);
  border-radius: var(--radius-lg);
}

.skeleton-copy {
  width: 72%;
  height: var(--line-body);
  margin-top: var(--space-md);
}

@keyframes sync-pulse {
  0%, 100% { opacity: .45; transform: scale(.9); }
  50% { opacity: 1; transform: scale(1); }
}

@media (max-width: 360px) {
  .period-heading,
  .feed-section-head {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .period-heading text:last-child {
    text-align: left;
  }

  .date-range {
    flex-direction: column;
    align-items: stretch;
  }

  .date-range > text {
    text-align: center;
  }
}

@media (hover: hover) and (pointer: fine) {
  .message-button:hover,
  .mood-filter:hover,
  .load-more:hover {
    border-color: var(--color-ink-secondary);
    background: var(--color-surface-muted);
  }

  .memory-tab:hover {
    color: var(--color-ink);
    background: var(--color-surface-muted);
  }
}

@media (prefers-reduced-motion: reduce) {
  .sync-dot {
    animation: none;
  }
}
