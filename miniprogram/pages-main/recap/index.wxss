.recap-page{background-image:radial-gradient(rgba(132,105,80,.11) 1rpx,transparent 1rpx);background-size:18rpx 18rpx}.display-title{display:block;font-size:49rpx}.year-cover{position:relative;overflow:hidden;height:720rpx;margin-top:36rpx;padding:34rpx;border-radius:8rpx;color:#F8F1E6;background:#984B4C;box-shadow:14rpx 17rpx 0 #D8C8B6,0 25rpx 50rpx rgba(84,49,46,.18)}.year-cover.ready{background:#496357}.year-cover::before{content:'';position:absolute;left:32rpx;top:92rpx;bottom:110rpx;width:2rpx;background:rgba(255,255,255,.35)}.cover-top{display:flex;justify-content:space-between;font:18rpx/1 sans-serif;letter-spacing:3rpx}.cover-year{display:block;margin-top:40rpx;font:700 112rpx/.9 Georgia,serif}.cover-orbit{position:absolute;width:380rpx;height:320rpx;right:-70rpx;top:180rpx}.cover-orbit .decor{position:absolute;inset:10rpx 60rpx;border:3rpx solid rgba(255,255,255,.45);border-radius:50%;transform:rotate(35deg)}.cover-orbit .decor:nth-child(2){inset:60rpx 10rpx;transform:rotate(-50deg)}.cover-title{position:absolute;left:58rpx;bottom:180rpx;font-size:44rpx;font-weight:700}.cover-meta{position:absolute;left:58rpx;bottom:133rpx;color:rgba(255,255,255,.72);font:20rpx/1 sans-serif}.cover-action{position:absolute;left:58rpx;bottom:52rpx;padding:19rpx 25rpx;border:2rpx solid rgba(255,255,255,.65);border-radius:35rpx;color:#FFF;background:transparent;font:22rpx/1 sans-serif}.recap-section{margin-top:60rpx}.new-recap{width:100%;display:flex;align-items:center;gap:20rpx;margin-top:24rpx;padding:27rpx;border:2rpx solid #D8CCBE;border-radius:24rpx;text-align:left;background:#FFFDF8}.new-recap>text{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:50%;color:#FFF;background:#BD4E4E;font-size:33rpx}.new-recap view text,.new-recap view .label{display:block}.new-recap view text{font-size:27rpx;font-weight:700}.new-recap view .label{margin-top:9rpx;color:#817970;font:20rpx/1 sans-serif}.recap-principles{margin-top:32rpx;padding:26rpx;border-top:2rpx solid #D8CCBE;border-bottom:2rpx solid #D8CCBE}.recap-principles>text{color:#BD4E4E;font:20rpx/1 sans-serif;letter-spacing:3rpx}.recap-principles view{display:flex;align-items:center;gap:14rpx;margin-top:19rpx;color:#665E57;font:23rpx/1 sans-serif}.recap-principles .decor{display:flex;align-items:center;justify-content:center;width:33rpx;height:33rpx;border-radius:50%;color:#FFF;background:#557263;font:17rpx/1 Georgia,serif}
