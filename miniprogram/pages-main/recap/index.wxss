.memory-room-page { background: transparent; }
.memory-kicker { display: block; color: #A84454; font-size: 18rpx; font-weight: 800; letter-spacing: 3rpx; }
.memory-title { display: block; margin-top: 12rpx; color: #2D2425; font-size: 48rpx; font-weight: 900; line-height: 1.28; }
.memory-title text { display: block; }
.memory-note { display: block; margin-top: 16rpx; color: #7D6C69; font-size: 23rpx; line-height: 1.65; }
.love-film-cover { position: relative; overflow: hidden; height: 720rpx; margin-top: 34rpx; padding: 38rpx 36rpx; border: 16rpx solid #42343C; border-radius: 20rpx; color: #FFF8F1; background: linear-gradient(155deg,#735568 0%,#B25B65 42%,#E08D69 74%,#F0B275 100%); box-shadow: 0 24rpx 48rpx rgba(85,43,55,.22); }
.love-film-cover.ready { background: linear-gradient(155deg,#5D5364,#8F5364 45%,#D47A68 78%,#EFA56E); }
.film-holes { position: absolute; left: 14rpx; right: 14rpx; top: 8rpx; display: flex; justify-content: space-between; }
.film-holes text { width: 28rpx; height: 10rpx; border-radius: 3rpx; background: rgba(255,233,207,.62); }
.cover-top { position: relative; z-index: 2; display: flex; justify-content: space-between; color: rgba(255,248,241,.76); font-size: 17rpx; letter-spacing: 3rpx; }
.cover-year { position: relative; z-index: 2; display: block; margin-top: 58rpx; color: #FFF4E7; font-size: 106rpx; font-weight: 900; line-height: 1; }
.cover-sunset { position: absolute; right: -80rpx; top: 150rpx; width: 390rpx; height: 390rpx; border-radius: 50%; background: radial-gradient(circle,rgba(255,226,178,.72),rgba(255,187,128,.12) 55%,transparent 70%); }
.cover-title { position: absolute; left: 38rpx; right: 38rpx; bottom: 180rpx; z-index: 2; display: -webkit-box; max-height: 108rpx; overflow: hidden; font-size: 43rpx; font-weight: 900; line-height: 1.25; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.cover-meta { position: absolute; left: 38rpx; right: 38rpx; bottom: 132rpx; z-index: 2; overflow: hidden; color: rgba(255,248,241,.90); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.cover-action { position: absolute; left: 38rpx; bottom: 42rpx; z-index: 2; min-width: 180rpx; height: 66rpx; padding: 0 22rpx; border: 2rpx solid rgba(255,248,241,.58); border-radius: 22rpx; color: #FFF8F1; background: rgba(74,42,52,.14); font-size: 22rpx; }
.recap-section { margin-top: 48rpx; }
.new-recap { display: flex; align-items: center; gap: 20rpx; width: 100%; margin-top: 22rpx; padding: 25rpx; border: 2rpx solid #DFC6BA; border-radius: 24rpx; text-align: left; background: #FFF9F2; box-shadow: 0 12rpx 26rpx rgba(90,55,56,.06); }
.new-recap>text { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 50%; color: #FFF8F1; background: #B94E5A; font-size: 32rpx; }
.new-recap view { flex: 1; min-width: 0; }
.new-recap view text { display: block; color: #2D2425; font-size: 27rpx; font-weight: 800; }
.new-recap view .label { margin-top: 8rpx; color: #7D6C69; font-size: 20rpx; font-weight: 400; }
.recap-principles { margin-top: 30rpx; padding: 25rpx; border-top: 2rpx solid #DFC6BA; border-bottom: 2rpx solid #DFC6BA; }
.recap-principles>text { color: #A84454; font-size: 19rpx; font-weight: 800; letter-spacing: 2rpx; }
.recap-principles>view { display: flex; align-items: center; gap: 14rpx; margin-top: 18rpx; color: #6E5C5B; font-size: 22rpx; }
.recap-principles .decor { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border-radius: 50%; color: #FFF8F1; background: #75515F; font-size: 17rpx; }
