<view class="page recap-page home-refined">
  <view class="recap-heading"><main-actions unread="{{unread}}"></main-actions></view>

  <view wx:if="{{loading && recap.year}}" class="sync-status" aria-live="polite">
    <view class="sync-dot"></view>
    <text>正在同步最近一次回顾</text>
  </view>

  <view wx:if="{{error}}" class="status-banner status-banner--error" role="alert">
    <text>{{error}}</text>
    <button size="mini" bindtap="onShow">重试</button>
  </view>

  <view wx:if="{{loading && !recap.year}}" class="recap-skeleton" role="status" aria-live="polite" aria-label="正在读取年度回顾">
    <view class="skeleton-visual"></view>
    <view class="skeleton-copy">
      <view class="skeleton-line skeleton-line--short"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line skeleton-line--medium"></view>
    </view>
  </view>

  <empty-state
    wx:elif="{{!paired}}"
    title="先和 TA 完成配对"
    description="配对后，才能从共同可见的记录里一起制作回顾。"
    action="去邀请 TA"
    bind:action="invite"
  ></empty-state>

  <empty-state
    wx:elif="{{count === 0}}"
    title="还没有可用于回顾的共同记录"
    description="先记下一个双方可见的时刻，之后就能把它选进回顾。"
    action="记下这一刻"
    bind:action="compose"
  ></empty-state>

  <block wx:else>
    <view class="recap-feature">
      <view class="feature-visual {{coverPath ? 'has-photo' : 'is-text'}}">
        <image wx:if="{{coverPath}}" src="{{coverPath}}" mode="aspectFill" aria-label="年度回顾封面照片"></image>
        <view wx:else class="feature-fallback">
          <text class="feature-year">{{recap.year}}</text>
          <text>这份回顾从文字开始</text>
        </view>
        <text class="feature-status">{{recap.status === 'READY' ? '已生成 · 版本 ' + recap.version : '正在整理'}}</text>
      </view>

      <view class="feature-copy">
        <text class="feature-meta">{{recap.year}} 年 · 已选 {{selectedCount}} 段 · 共 {{count}} 条可用</text>
        <text class="feature-title">{{recap.title}}</text>
        <text class="feature-note">{{recap.status === 'READY' ? '已经可以重温；重新选片后，可以再生成一个版本。' : selectedCount ? '草稿已经保留，继续选择或调整想放进故事里的片段。' : '还没有选择片段，可以从共同记录里慢慢挑。'}}</text>
        <button size="mini" class="primary-button feature-action press" bindtap="openCover">{{recap.status === 'READY' ? '一起重温' : selectedCount ? '继续选片' : '开始选片'}}</button>
        <button wx:if="{{recap.status === 'READY'}}" size="mini" class="text-button edit-action press" bindtap="create">重新选择片段</button>
      </view>
    </view>

  </block>
</view>
