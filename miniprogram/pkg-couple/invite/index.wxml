<view class="page invite-page">
  <view wx:if="{{error}}" class="status-banner status-banner--error" role="alert"><text>{{error}}</text></view>
  <view wx:if="{{stage === 'create'}}">
    <text class="eyebrow">ONE-TIME INVITATION</text>
    <view class="display-title"><text>邀请 TA，</text><text>一起拥有这本笔记</text></view>
    <view class="rule-card"><view><text>01</text><text class="label">邀请 24 小时内有效，使用后自动失效</text></view><view><text>02</text><text class="label">旧记录不会自动共享，由各自决定</text></view><view><text>03</text><text class="label">一个账号同时只能加入一个情侣空间</text></view></view>
    <button class="primary-button press" loading="{{loading}}" disabled="{{loading}}" bindtap="create">生成专属邀请</button>
  </view>
  <view wx:elif="{{stage === 'waiting'}}" class="invite-center">
    <view class="invite-ticket"><text class="ticket-kicker">FOR · TA</text><view class="ticket-heart">∞</view><view class="ticket-title"><text>要不要和我一起，</text><text>记录普通日子？</text></view><view class="ticket-code"><view class="decor"></view><view class="decor"></view><view class="decor"></view><view class="decor"></view><view class="decor"></view><view class="decor"></view><view class="decor"></view><view class="decor"></view><view class="decor"></view></view><text class="ticket-time">有效期剩余 {{hours}} 小时 {{minutes}} 分</text></view>
    <button class="primary-button press" open-type="share">发送给 TA</button><button wx:if="{{!isRemote}}" class="demo-button" bindtap="simulateAccept">模拟 TA 打开邀请</button>
  </view>
  <view wx:elif="{{stage === 'confirm'}}">
    <text class="eyebrow">BEFORE WE BEGIN</text><text class="display-title">确认建立情侣空间</text>
    <view class="identity-card"><view class="identity-avatar">{{inviterInitial}}</view><view><text>{{inviterName || 'TA'}} 邀请你</text><text class="label">邀请未展示任何历史记录</text></view></view>
    <view class="confirm-rules"><text class="section-title">请一起确认共享规则</text><text class="label">· 仅“共同可见”的记录会向对方展示</text><text class="label">· 私密记录永远不会进入双人回顾</text><text class="label">· 任一方都可以单独解绑，确认后立即停止互访</text><text class="label">· 宠物与情侣回顾属于共同空间，解绑后会冻结</text></view>
    <button class="primary-button press" loading="{{loading}}" disabled="{{loading}}" bindtap="confirm">我已了解并接受邀请</button>
  </view>
  <view wx:else class="success-state"><view class="success-orbits"><view></view><view></view><text>✓</text></view><view class="display-title"><text>欢迎来到</text><text>{{relationshipName}}</text></view><text class="section-note">你们的情侣空间已经建立。旧记录仍保持原可见范围。</text><button class="primary-button press" bindtap="home">去看看“我们”</button></view>
</view>
