.invite-page{padding-bottom:calc(50rpx + env(safe-area-inset-bottom))}.display-title{display:block}.rule-card{margin:40rpx 0 32rpx;border-top:2rpx solid #D8CCBE;border-bottom:2rpx solid #D8CCBE}.rule-card view{display:flex;gap:20rpx;padding:24rpx 0;border-bottom:2rpx solid #E8DED2}.rule-card view:last-child{border-bottom:0}.rule-card text{color:#BD4E4E;font:21rpx/1 Georgia,serif}.rule-card .label{color:#625B54;font:24rpx/1.5 sans-serif}.invite-center{text-align:center}.invite-ticket{position:relative;margin:18rpx 0 30rpx;padding:48rpx 38rpx;border:3rpx solid #2B2825;border-radius:28rpx;background:#FFFDF8;box-shadow:10rpx 10rpx 0 #2B2825}.ticket-kicker{font:20rpx/1 sans-serif;letter-spacing:4rpx;color:#BD4E4E}.ticket-heart{margin-top:25rpx;color:#BD4E4E;font:70rpx/1 Georgia,serif}.ticket-title{display:block;margin-top:22rpx;font-size:38rpx;font-weight:700;line-height:1.55}.ticket-code{width:260rpx;height:260rpx;display:grid;grid-template-columns:repeat(3,1fr);gap:11rpx;margin:34rpx auto;padding:16rpx;background:#2B2825}.ticket-code .decor{background:#FFFDF8}.ticket-code .decor:nth-child(2),.ticket-code .decor:nth-child(4),.ticket-code .decor:nth-child(8){background:#BD4E4E}.ticket-time{color:#817970;font:21rpx/1 sans-serif}.demo-button{margin:24rpx auto 0;color:#817970;background:transparent;font:21rpx/1 sans-serif;text-decoration:underline}.identity-card{display:flex;align-items:center;gap:20rpx;margin-top:40rpx;padding:25rpx;border:2rpx solid #D8CCBE;border-radius:22rpx;background:#FFFDF8}.identity-avatar{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border-radius:50%;color:#FFF;background:#BD4E4E}.identity-card view:nth-child(2) text,.identity-card view:nth-child(2) .label{display:block}.identity-card view:nth-child(2) .label{margin-top:9rpx;color:#817970;font:20rpx/1 sans-serif}.confirm-rules{margin:30rpx 0;padding:30rpx;border-left:6rpx solid #557263;background:#EEF3ED}.confirm-rules text,.confirm-rules .label{display:block}.confirm-rules .label{margin-top:17rpx;color:#5E6862;font:23rpx/1.5 sans-serif}.success-state{display:flex;flex-direction:column;align-items:center;padding-top:70rpx;text-align:center}.success-orbits{position:relative;width:260rpx;height:200rpx}.success-orbits view{position:absolute;width:150rpx;height:150rpx;border:4rpx solid #BD4E4E;border-radius:50%}.success-orbits view:first-child{left:16rpx}.success-orbits view:nth-child(2){right:16rpx;border-color:#557263}.success-orbits text{position:absolute;left:50%;top:50%;transform:translate(-50%,-70%);display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;border-radius:50%;color:#FFF;background:#2B2825}.success-state .primary-button{margin-top:40rpx}
