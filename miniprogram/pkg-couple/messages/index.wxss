.messages-head{display:flex;align-items:flex-end;justify-content:space-between}.messages-head .display-title{display:block}.message-list{margin-top:34rpx;border-top:2rpx solid #D8CCBE}.message-item{position:relative;width:100%;display:flex;align-items:center;gap:18rpx;padding:25rpx 4rpx;border-bottom:2rpx solid #E4DACE;text-align:left;background:transparent}.message-item.unread{background:linear-gradient(90deg,rgba(243,222,218,.55),transparent)}.message-mark{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;border-radius:50%;color:#BD4E4E;background:#F3DEDA;font:28rpx/1 Georgia,serif}.message-copy{flex:1}.message-copy view{display:flex;justify-content:space-between}.message-copy view text{font:25rpx/1.2 sans-serif}.message-copy .time{color:#9A9087;font:19rpx/1 sans-serif}.message-copy .label{display:block;margin-top:9rpx;color:#817970;font:21rpx/1.45 sans-serif}.message-item>.decor{width:10rpx;height:10rpx;border-radius:50%;background:#BD4E4E}
