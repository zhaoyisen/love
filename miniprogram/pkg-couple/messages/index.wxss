.messages-page { padding-top: 42rpx; background: #F7F1E8; }
.messages-head { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.messages-head > view { flex: 1; min-width: 0; }
.messages-head .display-title { display: block; margin-top: 8rpx; font-size: 48rpx; }
.read-button { flex: 0 0 auto; width: 154rpx; min-width: 154rpx; max-width: 154rpx; height: 62rpx; padding: 0 18rpx; border: 2rpx solid #D5C8BB; border-radius: 18rpx; color: #A94444; background: #FCF9F3; font: 600 22rpx/1.2 "PingFang SC",sans-serif; white-space: nowrap; }
.read-button[disabled] { color: #9A9188; background: #EEE7DE; opacity: 1; }
.message-list { width: 100%; margin-top: 30rpx; border-top: 2rpx solid #D8CCBE; }
.message-item { position: relative; width: 100%; min-height: 118rpx; display: flex; align-items: center; gap: 20rpx; padding: 22rpx 4rpx; border-bottom: 2rpx solid #E2D8CC; text-align: left; box-sizing: border-box; animation: message-in 220ms cubic-bezier(.22,1,.36,1) both; transition: background-color 160ms ease,transform 160ms cubic-bezier(.22,1,.36,1); }
.message-item.unread { background: #F6E8E4; }
.message-item--pressed { background: #EDE4DA; transform: scale(.985); }
.message-mark { flex: 0 0 68rpx; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 20rpx; color: #A94444; background: #F2DCD7; font: 28rpx/1 Georgia,serif; }
.message-copy { flex: 1; min-width: 0; }
.message-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 14rpx; }
.message-title { overflow: hidden; color: #2B2825; font: 600 27rpx/1.35 "PingFang SC",sans-serif; text-overflow: ellipsis; white-space: nowrap; }
.time { flex: 0 0 auto; color: #9A9087; font: 19rpx/1 sans-serif; }
.message-summary { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: #756D65; font: 22rpx/1.5 "PingFang SC",sans-serif; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.unread-dot { flex: 0 0 12rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: #A94444; box-shadow: 0 0 0 7rpx rgba(169,68,68,.09); }
.message-arrow { flex: 0 0 20rpx; color: #9B9188; font: 34rpx/1 sans-serif; }
.message-empty { min-height: 620rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.message-empty > text:first-of-type { margin-top: 26rpx; font-size: 30rpx; font-weight: 600; }
.message-empty > text:last-child { margin-top: 12rpx; color: #817970; font-size: 23rpx; }
.empty-icon { position: relative; width: 84rpx; height: 62rpx; border: 3rpx solid #9A8E82; border-radius: 10rpx; }
.empty-icon::before,.empty-icon::after { content: ""; position: absolute; top: 18rpx; width: 49rpx; height: 3rpx; background: #9A8E82; }
.empty-icon::before { left: 0; transform: rotate(34deg); }
.empty-icon::after { right: 0; transform: rotate(-34deg); }
@keyframes message-in { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .message-item { animation: none; transition: none; } }
