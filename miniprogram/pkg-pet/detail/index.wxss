.pet-page{min-height:100vh;background:#F7F1E8}.pet-room{position:relative;height:580rpx;overflow:hidden;background:linear-gradient(180deg,#CBDCD6 0,#E6ECE3 68%,#C9B69D 68%,#B89D7E 100%)}.window{position:absolute;left:55rpx;top:80rpx;width:210rpx;height:170rpx;border:12rpx solid #FFF8ED;background:#AFCED1}.window::before,.window::after{content:'';position:absolute;background:#FFF8ED}.window::before{left:50%;top:0;bottom:0;width:8rpx}.window::after{left:0;right:0;top:50%;height:8rpx}.cloud{position:absolute;left:35rpx;top:35rpx;width:90rpx;height:35rpx;border-radius:30rpx;background:rgba(255,255,255,.65)}.plant{position:absolute;right:65rpx;bottom:120rpx;width:70rpx;height:100rpx;border-radius:12rpx 12rpx 35rpx 35rpx;background:#B4813C}.plant .decor{position:absolute;width:70rpx;height:35rpx;border-radius:50%;background:#557263;transform:rotate(35deg)}.plant .decor:first-child{top:-45rpx;left:-30rpx}.plant .decor:nth-child(2){top:-70rpx;left:20rpx;transform:rotate(-45deg)}.plant .decor:nth-child(3){top:-20rpx;left:12rpx}.big-pet{position:absolute;left:50%;bottom:90rpx;transform:translateX(-50%);width:230rpx;height:190rpx;border-radius:48% 52% 45% 45%;background:#F8EAD5;box-shadow:inset -20rpx -15rpx 0 rgba(164,127,91,.15),0 20rpx 30rpx rgba(74,56,41,.12)}.ear{position:absolute;top:-47rpx;width:86rpx;height:100rpx;border-radius:20rpx;background:#F8EAD5;transform:rotate(35deg)}.ear.left{left:5rpx}.ear.right{right:5rpx;transform:rotate(-35deg)}.eye{position:absolute;top:78rpx;width:14rpx;height:19rpx;border-radius:50%;background:#514940}.eye.left{left:67rpx}.eye.right{right:67rpx}.big-pet>text{position:absolute;left:103rpx;top:104rpx;color:#BD4E4E;font-size:25rpx}.floor-shadow{position:absolute;left:50%;bottom:60rpx;transform:translateX(-50%);width:280rpx;height:38rpx;border-radius:50%;background:rgba(74,56,41,.13)}.pet-speech{position:absolute;right:38rpx;top:48rpx;padding:16rpx 20rpx;border-radius:24rpx 24rpx 6rpx 24rpx;background:#FFFDF8;color:#557263;font:20rpx/1.4 sans-serif}.pet-panel{position:relative;margin-top:-20rpx;padding:38rpx 32rpx calc(50rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#F7F1E8}.pet-title{display:flex;align-items:flex-end;justify-content:space-between;margin-top:16rpx}.pet-title view text,.pet-title view .label{display:block}.pet-title view text{font-size:44rpx;font-weight:700}.pet-title view .label{margin-top:8rpx;color:#817970;font:21rpx/1 sans-serif}.pet-title>text{color:#BD4E4E;font:24rpx/1 Georgia,serif}.pet-progress{height:15rpx;margin-top:20rpx;border-radius:8rpx;background:#DED4C8;overflow:hidden}.pet-progress .decor{display:block;height:100%;background:linear-gradient(90deg,#557263,#BD4E4E)}.pet-actions{display:grid;grid-template-columns:1fr 1fr;gap:15rpx;margin-top:30rpx}.pet-actions button{padding:26rpx;border:2rpx solid #D8CCBE;border-radius:22rpx;text-align:left;background:#FFFDF8}.pet-actions button.done{opacity:.6;background:#EEE7DC}.pet-actions text,.pet-actions .label{display:block}.pet-actions text{font-size:27rpx;font-weight:700}.pet-actions .label{margin-top:9rpx;color:#817970;font:20rpx/1 sans-serif}.pet-log{margin-top:42rpx}.pet-log>view{display:flex;align-items:center;gap:15rpx;padding:20rpx 0;border-bottom:2rpx solid #E3D8CB;color:#675F58;font:22rpx/1.4 sans-serif}.pet-log .decor{width:10rpx;height:10rpx;border-radius:50%;background:#557263}.pet-note{display:block;margin-top:28rpx;padding:20rpx;border-left:5rpx solid #B4813C;color:#817970;background:#FFF8ED;font:20rpx/1.6 sans-serif}
.pet-actions{display:flex}.pet-actions button{flex:1 1 0;width:0;min-width:0;max-width:none;box-sizing:border-box}
