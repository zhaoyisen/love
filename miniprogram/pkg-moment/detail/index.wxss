.detail-page{min-height:100vh;padding-bottom:calc(50rpx + env(safe-area-inset-bottom));background:#F7F1E8}.hero{position:relative;height:670rpx;overflow:hidden}.hero image,.hero video{display:block;width:100%;height:100%}.tone-sunset{background:linear-gradient(150deg,#E9C5A8,#C9826C 55%,#6E5962)}.tone-lake{background:linear-gradient(150deg,#CBDCD6,#7D9E9D 58%,#4D6570)}.tone-paper{background:linear-gradient(150deg,#EFE3D3,#C9B59B)}.hero-art{position:absolute;inset:0}.hero-sun{position:absolute;width:210rpx;height:210rpx;right:110rpx;top:120rpx;border-radius:50%;background:rgba(255,238,205,.4)}.hero-hill{position:absolute;left:-100rpx;right:-100rpx;bottom:-50rpx;height:310rpx;border-radius:50% 50% 0 0;background:rgba(61,70,71,.18);transform:rotate(-8deg)}.hero-frame{position:absolute;inset:30rpx;display:flex;align-items:flex-end;justify-content:space-between;padding:24rpx;border:2rpx solid rgba(255,255,255,.7);color:#FFF;font:20rpx/1 sans-serif;letter-spacing:2rpx;pointer-events:none}.detail-content{position:relative;margin-top:-28rpx;padding:38rpx 32rpx;background:#F7F1E8;border-radius:34rpx 34rpx 0 0}.detail-meta{display:flex;align-items:center}.author-avatar,.comment-avatar{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;margin-right:16rpx;border-radius:50%;color:#FFF;background:#557263;font-size:27rpx}.detail-meta view:nth-child(2) text,.detail-meta view:nth-child(2) .label{display:block}.detail-meta view:nth-child(2) text{font:25rpx/1 sans-serif}.detail-meta view:nth-child(2) .label{margin-top:8rpx;color:#817970;font:20rpx/1 sans-serif}.more-button{margin-left:auto;width:70rpx;height:60rpx;color:#817970;background:transparent;font:26rpx/1 sans-serif;letter-spacing:3rpx}.detail-title{display:block;margin-top:34rpx;font-size:44rpx;font-weight:700;line-height:1.35}.detail-copy{display:block;margin-top:20rpx;color:#5E5751;font:28rpx/1.9 sans-serif;white-space:pre-wrap}.detail-tags{display:flex;gap:10rpx;margin-top:24rpx}.visibility-banner{display:flex;gap:16rpx;margin-top:30rpx;padding:22rpx;border:2rpx solid #D8CCBE;border-radius:20rpx;background:rgba(255,253,248,.7)}.visibility-banner>text{color:#557263}.visibility-banner view text,.visibility-banner view .label{display:block}.visibility-banner view text{font:23rpx/1 sans-serif}.visibility-banner view .label{margin-top:8rpx;color:#817970;font:19rpx/1.4 sans-serif}.interaction-section{margin-top:48rpx;padding-top:38rpx;border-top:2rpx solid #D8CCBE}.reaction-scroll{width:calc(100% + 64rpx);margin:24rpx -32rpx 0}.reaction-list{display:inline-flex;gap:12rpx;padding:0 32rpx}.reaction{width:112rpx;height:116rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;border:2rpx solid #D8CCBE;border-radius:22rpx;background:#FFFDF8}.reaction[disabled]{opacity:.68}.reaction text{color:#BD4E4E;font:32rpx/1 Georgia,serif}.reaction .label{color:#6E665F;font:20rpx/1 sans-serif}.reaction.active{border-color:#BD4E4E;background:#F3DEDA}.comments-head{display:flex;align-items:center;justify-content:space-between;margin-top:44rpx}.comments-head>text:last-child{color:#817970;font:21rpx/1 sans-serif}.comment{display:flex;align-items:flex-start;margin-top:22rpx}.comment-avatar{width:52rpx;height:52rpx;font-size:22rpx}.comment>view:nth-child(2){flex:1}.comment view text,.comment view .label{display:block}.comment view text{color:#817970;font:19rpx/1 sans-serif}.comment view .label{margin-top:10rpx;font:25rpx/1.6 sans-serif}.comment-delete{margin-left:12rpx;padding:8rpx 2rpx;color:#B06A61;background:transparent;font:19rpx/1 sans-serif}.no-comment{margin-top:20rpx;padding:30rpx;border-radius:18rpx;color:#817970;background:#EEE7DC;font:23rpx/1.5 sans-serif}.comment-box{display:flex;gap:12rpx;margin-top:24rpx;padding:10rpx;border:2rpx solid #D8CCBE;border-radius:44rpx;background:#FFFDF8}.comment-box input{flex:1;height:66rpx;padding-left:20rpx;font:25rpx/1 sans-serif}.comment-box button{width:110rpx;border-radius:34rpx;color:#FFF;background:#557263;font:23rpx/1 sans-serif}.comment-box button[disabled]{background:#9AA99F}

.sheet-mask{position:fixed;z-index:120;inset:0;display:flex;align-items:flex-end;background:rgba(40,32,28,.46);animation:sheet-mask-in 180ms ease-out both}.detail-action-sheet,.trash-confirm-sheet{box-sizing:border-box;width:100%;padding:16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#fffaf3;box-shadow:0 -20rpx 60rpx rgba(54,38,31,.16);animation:sheet-rise 220ms cubic-bezier(.2,.8,.2,1) both}.sheet-handle{width:72rpx;height:8rpx;margin:0 auto 22rpx;border-radius:999rpx;background:#d8ccbe}.sheet-title{display:block;padding:0 8rpx 18rpx;color:#302b28;font-size:30rpx;font-weight:700}.sheet-row{display:flex;align-items:center;width:100%;min-height:112rpx;padding:20rpx 8rpx;border-top:2rpx solid #eee4d8;border-radius:0;text-align:left;background:transparent}.sheet-row::after,.sheet-cancel::after,.trash-actions button::after{border:0}.sheet-row view{flex:1}.sheet-row view text{display:block;color:#302b28;font-size:28rpx;line-height:1.35}.sheet-row view text+text{margin-top:8rpx;color:#8a8179;font-size:21rpx;font-weight:400}.sheet-row>text{margin-left:20rpx;color:#9a9087;font-size:40rpx;font-weight:300}.sheet-row--danger view text:first-child,.sheet-row--danger>text{color:#a54444}.sheet-cancel{width:100%;height:88rpx;margin-top:14rpx;border-radius:22rpx;color:#5d554f;background:#f0e8dd;font-size:26rpx}.trash-confirm-sheet{padding:38rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));text-align:center}.trash-symbol{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;margin:0 auto 22rpx;border-radius:50%;color:#a54444;background:#f4ded9;font-size:40rpx}.trash-title{display:block;color:#302b28;font-size:36rpx;font-weight:700}.trash-copy{display:block;max-width:560rpx;margin:16rpx auto 0;color:#756c65;font-size:25rpx;line-height:1.65}.trash-error{display:block;margin:20rpx 0 0;padding:18rpx;border-radius:16rpx;color:#8f3434;background:#f8e3df;font-size:22rpx;line-height:1.45}.trash-actions{display:flex;gap:18rpx;margin-top:32rpx}.trash-actions button{flex:1;height:92rpx;border-radius:24rpx;color:#5d554f;background:#eee6db;font-size:26rpx;font-weight:600}.trash-actions .trash-submit{color:#fff;background:#a54444}.trash-actions button[disabled]{opacity:.62}.trash-submit[loading]{padding-left:20rpx}@keyframes sheet-mask-in{from{opacity:0}to{opacity:1}}@keyframes sheet-rise{from{transform:translateY(40rpx)}to{transform:translateY(0)}}@media (prefers-reduced-motion:reduce){.sheet-mask,.detail-action-sheet,.trash-confirm-sheet{animation:none}}

.hero-swiper{width:100%;height:100%}.hero-swiper swiper-item,.hero-swiper image{width:100%;height:100%}.hero-count{position:absolute;z-index:4;right:30rpx;top:30rpx;padding:10rpx 15rpx;border-radius:14rpx;color:#fff9f2;background:rgba(45,36,37,.62);font-size:20rpx;line-height:1}

.media-retry-banner{display:flex;align-items:center;gap:18rpx;margin-top:28rpx;padding:22rpx;border:2rpx solid #e2b4aa;border-radius:20rpx;background:#f8e5df}.media-retry-banner>view{flex:1;min-width:0}.media-retry-banner text{display:block;color:#7f3d38;font-size:24rpx;font-weight:700}.media-retry-banner text+text{margin-top:8rpx;color:#8a625d;font-size:20rpx;font-weight:400;line-height:1.45}.media-retry-banner button{flex:0 0 auto;width:142rpx;height:68rpx;border-radius:18rpx;color:#fff;background:#a84454;font-size:22rpx;font-weight:700}.media-retry-banner button+button{margin-top:8rpx}
