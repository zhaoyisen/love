/* Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V4 · theme: DESIGN.md 清爽精致 */
@import "../../styles/home-refined.wxss";
page { background: var(--color-home-paper); }
.detail-page {
  --detail-gutter: 16px;
  --detail-gap: 12px;
  --detail-tight-gap: 8px;
  --detail-media-min: 80px;
  --detail-media-max: 340px;
  --detail-content-reserve: 400px;
  --detail-composer-space: 65px;
  --detail-avatar: 32px;
  --detail-reaction-size: 28px;
  --detail-reaction-height: 64px;
  --detail-sheet-radius: 16px;
  --detail-overlay: rgba(41, 38, 37, .46);
  --detail-media-overlay: rgba(41, 38, 37, .66);
  box-sizing: border-box;
  min-height: 100vh;
  max-width: var(--home-content-width);
  margin: 0 auto;
  padding-bottom: var(--detail-gutter);
  overflow-x: clip;
  color: var(--color-ink);
  background: var(--color-paper);
  font-family: var(--font-body);
}
.detail-page.has-composer { padding-bottom: calc(var(--detail-composer-space) + env(safe-area-inset-bottom)); }
.detail-page.is-own { --detail-content-reserve: 336px; }
.detail-page button { box-sizing: border-box; margin: 0; min-height: var(--touch-target); padding: 0; border: 0; border-radius: 0; font-family: var(--font-body); font-weight: var(--weight-regular); line-height: var(--line-secondary); white-space: nowrap; }
.detail-page button::after { border: 0; }
.detail-page button[disabled] { opacity: var(--opacity-disabled); }
.detail-page button:focus-visible, .comment-input:focus-visible { outline: var(--rule-strong) solid var(--color-focus); outline-offset: 2px; }
.hero { position: relative; height: calc(100vh - var(--detail-content-reserve)); min-height: var(--detail-media-min); max-height: var(--detail-media-max); overflow: hidden; background: var(--color-surface); }
.hero-swiper, .hero-swiper swiper-item, .hero image, .hero video { display: block; width: 100%; height: 100%; }
.media-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; padding: var(--detail-gutter); box-sizing: border-box; color: var(--color-ink-secondary); font-size: var(--text-secondary); text-align: center; }
.hero-count { position: absolute; right: var(--detail-gap); bottom: var(--detail-gap); padding: 4px var(--detail-tight-gap); border-radius: var(--album-control-radius); color: var(--color-accent-ink); background: var(--detail-media-overlay); font-size: var(--text-meta); line-height: var(--line-meta); pointer-events: none; }
.processing-cover { right: var(--detail-gap); bottom: var(--detail-gap); left: var(--detail-gap); padding: var(--detail-gap); border-radius: var(--album-control-radius); background: var(--detail-media-overlay); }
.detail-content { padding: var(--detail-gap) var(--detail-gutter) var(--detail-gap); }
.detail-meta { display: flex; align-items: center; min-height: var(--touch-target); gap: var(--detail-gap); }
.author-avatar, .comment-avatar { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: var(--detail-avatar); height: var(--detail-avatar); border-radius: var(--radius-round); color: var(--color-accent-strong); background: var(--color-accent-soft); font-size: var(--text-secondary); }
.author-copy { flex: 1; min-width: 0; }
.author-copy > text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--text-secondary); line-height: var(--line-secondary); }
.author-copy .detail-date { color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); }
.detail-page .more-button { display: flex; flex: 0 0 var(--touch-target); align-items: center; justify-content: center; width: var(--touch-target); height: var(--touch-target); color: var(--color-ink-secondary); background: transparent; font-size: var(--text-secondary); letter-spacing: 2px; }
.detail-title { display: block; min-width: 0; margin-top: var(--detail-gap); overflow-wrap: anywhere; font-size: var(--text-page-title); font-weight: var(--weight-medium); line-height: var(--line-page-title); }
.detail-copy { display: block; margin-top: var(--detail-tight-gap); color: var(--color-ink); font-size: var(--text-body); line-height: 24px; white-space: pre-wrap; overflow-wrap: anywhere; }
.detail-tags { display: flex; flex-wrap: wrap; gap: var(--detail-tight-gap); margin-top: var(--detail-gap); }
.detail-tag { max-width: 100%; padding: 1px var(--detail-tight-gap); border-radius: var(--radius-pill); color: var(--color-ink-secondary); background: var(--color-surface); font-size: var(--text-meta); line-height: var(--line-meta); overflow-wrap: anywhere; }
.reaction-list { display: flex; gap: 0; margin-top: var(--detail-gap); }
.detail-page .reaction { display: flex; flex: 1 1 0; flex-direction: column; align-items: center; justify-content: center; gap: 2px; width: 0; min-width: var(--touch-target); height: var(--detail-reaction-height); color: var(--color-ink-secondary); background: transparent; font-size: var(--text-meta); line-height: var(--line-meta); transition: opacity var(--dur-micro) var(--ease-out); }
.reaction-symbol { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: var(--touch-target); height: var(--touch-target); border-radius: var(--radius-round); background: transparent; transition: background-color var(--dur-view) var(--ease-out); }
.reaction-symbol image { display: block; width: var(--detail-reaction-size); height: var(--detail-reaction-size); }
.reaction.active { color: var(--color-accent-strong); }
.reaction.active .reaction-symbol { background: var(--color-accent-soft); }
.comments-section { margin-top: var(--detail-gap); padding-top: var(--detail-gutter); border-top: var(--rule-thin) solid var(--color-rule); }
.comments-head { display: flex; align-items: center; justify-content: space-between; gap: var(--detail-tight-gap); font-size: var(--text-body); line-height: var(--line-body); }
.comments-head > text:last-child { color: var(--color-ink-secondary); font-size: var(--text-meta); }
.comment { display: flex; align-items: flex-start; gap: var(--detail-tight-gap); padding-top: var(--detail-gap); }
.comment-content { flex: 1; min-width: 0; padding: 2px 0; }
.comment-meta { display: flex; flex-wrap: wrap; gap: 4px var(--detail-tight-gap); color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); overflow-wrap: anywhere; }
.comment-body { display: block; margin-top: 4px; font-size: var(--text-body); line-height: 24px; white-space: pre-wrap; overflow-wrap: anywhere; }
.detail-page .comment-delete { display: flex; flex: 0 0 var(--touch-target); align-items: center; justify-content: center; width: var(--touch-target); min-height: var(--touch-target); padding: 0; color: var(--color-ink-secondary); background: transparent; font-size: var(--text-meta); }
.comment-box { position: fixed; z-index: var(--z-sticky); left: 0; right: 0; box-sizing: border-box; padding: 10px 0 calc(10px + env(safe-area-inset-bottom)); border-top: var(--rule-thin) solid var(--color-rule); background: var(--color-paper); }
.comment-box-inner { display: flex; align-items: center; gap: var(--detail-tight-gap); box-sizing: border-box; max-width: var(--home-content-width); margin: 0 auto; padding: 0 var(--detail-gutter); }
.comment-input { display: block; flex: 1; width: 0; min-width: 0; height: var(--touch-target); padding: 0 var(--detail-gap); border-radius: var(--album-control-radius); color: var(--color-ink); background: var(--color-surface); font-size: var(--text-body); line-height: var(--line-body); }
.comment-placeholder { color: var(--color-ink-secondary); }
.detail-page .comment-send { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; min-width: 64px; height: var(--touch-target); padding: 0 var(--detail-gap); border-radius: var(--album-control-radius); color: var(--color-accent-ink); background: var(--color-accent); font-size: var(--text-secondary); }
.has-keyboard .comment-box { padding-bottom: 10px; }
.media-retry-banner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--detail-gap); margin-top: var(--detail-gap); padding: var(--detail-gap); border: var(--rule-thin) solid var(--color-error); border-radius: var(--album-control-radius); color: var(--color-error); background: var(--color-error-bg); }
.media-retry-banner > view:first-child { flex: 1; min-width: 150px; }
.media-retry-banner text { display: block; font-size: var(--text-secondary); line-height: var(--line-secondary); }
.media-retry-banner text + text { margin-top: 4px; font-size: var(--text-meta); line-height: var(--line-meta); }
.media-retry-actions { display: flex; flex-wrap: wrap; gap: var(--detail-tight-gap); }
.detail-page .media-retry-actions button { padding: 0 var(--detail-gap); border-radius: var(--album-control-radius); color: var(--color-error); background: var(--color-paper); font-size: var(--text-meta); }
.detail-error { padding: var(--detail-gutter); }
.detail-error .status-banner { margin: 0; }
.detail-error button { padding: 0 var(--detail-gap); }
.sheet-mask { position: fixed; z-index: var(--z-modal); inset: 0; display: flex; align-items: flex-end; justify-content: center; box-sizing: border-box; padding-top: var(--detail-gutter); background: var(--detail-overlay); animation: detail-fade var(--dur-view) var(--ease-out) both; }
.detail-action-sheet, .trash-confirm-sheet { box-sizing: border-box; width: 100%; max-width: var(--home-content-width); max-height: 100%; padding: var(--detail-gap) var(--detail-gutter) calc(var(--detail-gutter) + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: var(--detail-sheet-radius) var(--detail-sheet-radius) 0 0; background: var(--color-paper); animation: detail-rise var(--dur-view) var(--ease-out) both; }
.sheet-handle { width: 32px; height: 4px; margin: 0 auto var(--detail-gutter); border-radius: var(--radius-pill); background: var(--color-rule); }
.sheet-title { display: block; margin-bottom: var(--detail-tight-gap); font-size: var(--text-list-title); font-weight: var(--weight-medium); line-height: var(--line-list-title); }
.detail-page .sheet-row { display: flex; align-items: center; gap: var(--detail-gap); width: 100%; min-height: 70px; padding: var(--detail-gap) 0; border-top: var(--rule-thin) solid var(--color-rule); color: var(--color-ink); background: transparent; text-align: left; white-space: normal; }
.sheet-row > view { flex: 1; min-width: 0; }
.sheet-row view text { display: block; font-size: var(--text-body); line-height: var(--line-secondary); }
.sheet-row view text + text { margin-top: 4px; color: var(--color-ink-secondary); font-size: var(--text-meta); line-height: var(--line-meta); }
.sheet-row > text { flex: 0 0 auto; color: var(--color-ink-secondary); font-size: var(--text-page-title); }
.sheet-row--danger view text:first-child { color: var(--color-error); }
.detail-page .sheet-cancel { width: 100%; margin-top: var(--detail-tight-gap); border-radius: var(--album-control-radius); color: var(--color-ink-secondary); background: var(--color-surface); font-size: var(--text-secondary); }
.trash-confirm-sheet { padding-top: 24px; text-align: center; }
.trash-symbol { display: flex; align-items: center; justify-content: center; width: var(--touch-target); height: var(--touch-target); margin: 0 auto var(--detail-gap); border-radius: var(--radius-round); background: var(--color-accent-soft); }
.trash-symbol image { width: var(--home-icon-size); height: var(--home-icon-size); }
.trash-title { display: block; font-size: var(--text-page-title); font-weight: var(--weight-medium); line-height: var(--line-page-title); }
.trash-copy { display: block; margin-top: var(--detail-gap); color: var(--color-ink-secondary); font-size: var(--text-secondary); line-height: var(--line-body); overflow-wrap: anywhere; }
.trash-error { display: block; margin-top: var(--detail-gap); padding: var(--detail-gap); border-radius: var(--album-control-radius); color: var(--color-error); background: var(--color-error-bg); font-size: var(--text-meta); line-height: var(--line-meta); }
.trash-actions { display: flex; gap: var(--detail-gap); margin-top: 24px; }
.detail-page .trash-actions button { flex: 1; width: 0; min-width: 0; padding: 0 var(--detail-tight-gap); border-radius: var(--album-control-radius); color: var(--color-ink-secondary); background: var(--color-surface); font-size: var(--text-secondary); }
.detail-page .trash-actions .trash-submit { color: var(--color-accent-ink); background: var(--color-error); }
@keyframes detail-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes detail-rise { from { transform: translateY(4px); } to { transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .sheet-mask, .detail-action-sheet, .trash-confirm-sheet { animation: none; } .reaction-symbol, .detail-page .reaction { transition: none; } }

.author-avatar, .comment-avatar { overflow: hidden; }
.author-avatar image, .comment-avatar image { display: block; width: 100%; height: 100%; border-radius: inherit; }
