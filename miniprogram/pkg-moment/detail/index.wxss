.detail-page{min-height:100vh;padding-bottom:calc(50rpx + env(safe-area-inset-bottom));background:#F7F1E8}.hero{position:relative;height:670rpx;overflow:hidden}.hero image{width:100%;height:100%}.tone-sunset{background:linear-gradient(150deg,#E9C5A8,#C9826C 55%,#6E5962)}.tone-lake{background:linear-gradient(150deg,#CBDCD6,#7D9E9D 58%,#4D6570)}.tone-paper{background:linear-gradient(150deg,#EFE3D3,#C9B59B)}.hero-art{position:absolute;inset:0}.hero-sun{position:absolute;width:210rpx;height:210rpx;right:110rpx;top:120rpx;border-radius:50%;background:rgba(255,238,205,.4)}.hero-hill{position:absolute;left:-100rpx;right:-100rpx;bottom:-50rpx;height:310rpx;border-radius:50% 50% 0 0;background:rgba(61,70,71,.18);transform:rotate(-8deg)}.hero-frame{position:absolute;inset:30rpx;display:flex;align-items:flex-end;justify-content:space-between;padding:24rpx;border:2rpx solid rgba(255,255,255,.7);color:#FFF;font:20rpx/1 sans-serif;letter-spacing:2rpx}.detail-content{position:relative;margin-top:-28rpx;padding:38rpx 32rpx;background:#F7F1E8;border-radius:34rpx 34rpx 0 0}.detail-meta{display:flex;align-items:center}.author-avatar,.comment-avatar{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;margin-right:16rpx;border-radius:50%;color:#FFF;background:#557263;font-size:27rpx}.detail-meta view:nth-child(2) text,.detail-meta view:nth-child(2) .label{display:block}.detail-meta view:nth-child(2) text{font:25rpx/1 sans-serif}.detail-meta view:nth-child(2) .label{margin-top:8rpx;color:#817970;font:20rpx/1 sans-serif}.more-button{margin-left:auto;width:70rpx;height:60rpx;color:#817970;background:transparent;font:26rpx/1 sans-serif;letter-spacing:3rpx}.detail-title{display:block;margin-top:34rpx;font-size:44rpx;font-weight:700;line-height:1.35}.detail-copy{display:block;margin-top:20rpx;color:#5E5751;font:28rpx/1.9 sans-serif;white-space:pre-wrap}.detail-tags{display:flex;gap:10rpx;margin-top:24rpx}.visibility-banner{display:flex;gap:16rpx;margin-top:30rpx;padding:22rpx;border:2rpx solid #D8CCBE;border-radius:20rpx;background:rgba(255,253,248,.7)}.visibility-banner>text{color:#557263}.visibility-banner view text,.visibility-banner view .label{display:block}.visibility-banner view text{font:23rpx/1 sans-serif}.visibility-banner view .label{margin-top:8rpx;color:#817970;font:19rpx/1.4 sans-serif}.interaction-section{margin-top:48rpx;padding-top:38rpx;border-top:2rpx solid #D8CCBE}.reaction-scroll{width:calc(100% + 64rpx);margin:24rpx -32rpx 0}.reaction-list{display:inline-flex;gap:12rpx;padding:0 32rpx}.reaction{width:112rpx;height:116rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;border:2rpx solid #D8CCBE;border-radius:22rpx;background:#FFFDF8}.reaction[disabled]{opacity:.68}.reaction text{color:#BD4E4E;font:32rpx/1 Georgia,serif}.reaction .label{color:#6E665F;font:20rpx/1 sans-serif}.reaction.active{border-color:#BD4E4E;background:#F3DEDA}.comments-head{display:flex;align-items:center;justify-content:space-between;margin-top:44rpx}.comments-head>text:last-child{color:#817970;font:21rpx/1 sans-serif}.comment{display:flex;margin-top:22rpx}.comment-avatar{width:52rpx;height:52rpx;font-size:22rpx}.comment>view:nth-child(2){flex:1}.comment view text,.comment view .label{display:block}.comment view text{color:#817970;font:19rpx/1 sans-serif}.comment view .label{margin-top:10rpx;font:25rpx/1.6 sans-serif}.no-comment{margin-top:20rpx;padding:30rpx;border-radius:18rpx;color:#817970;background:#EEE7DC;font:23rpx/1.5 sans-serif}.comment-box{display:flex;gap:12rpx;margin-top:24rpx;padding:10rpx;border:2rpx solid #D8CCBE;border-radius:44rpx;background:#FFFDF8}.comment-box input{flex:1;height:66rpx;padding-left:20rpx;font:25rpx/1 sans-serif}.comment-box button{width:110rpx;border-radius:34rpx;color:#FFF;background:#557263;font:23rpx/1 sans-serif}.comment-box button[disabled]{background:#9AA99F}
