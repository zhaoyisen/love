.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  height: calc(124rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 253, 248, .96);
  box-shadow: 0 -12rpx 34rpx rgba(58, 43, 31, .10);
  box-sizing: border-box;
}

.tab-rule {
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #E1D5C8 20%, #E1D5C8 80%, transparent);
  pointer-events: none;
}

.tab-list {
  width: 100%;
  height: 124rpx;
  display: flex;
  align-items: center;
  overflow: visible;
}

.tab-item {
  position: relative;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  max-width: none;
  height: 112rpx;
  margin: 0;
  padding: 10rpx 0 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #8A8178;
  background: transparent;
  font: 600 20rpx/1.2 "PingFang SC", sans-serif;
}

.tab-item::after,
.compose-button::after {
  border: 0;
}

.tab-item.is-selected {
  color: #A94444;
}

.tab-item.is-selected::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #A94444;
  transform: translateX(-50%);
}

.tab-glyph {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  color: currentColor;
  box-sizing: border-box;
}

.glyph-time {
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.glyph-time::before {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 7rpx;
  width: 3rpx;
  height: 11rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: rotate(-8deg);
  transform-origin: bottom center;
}

.glyph-time::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: rotate(24deg);
  transform-origin: left center;
}

.glyph-couple::before,
.glyph-couple::after {
  content: "";
  position: absolute;
  top: 7rpx;
  width: 22rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.glyph-couple::before {
  left: 1rpx;
  transform: rotate(-12deg);
}

.glyph-couple::after {
  right: 1rpx;
  transform: rotate(12deg);
}

.glyph-recap {
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
}

.glyph-recap::before,
.glyph-recap::after {
  content: "";
  position: absolute;
  left: 7rpx;
  right: 7rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.glyph-recap::before { top: 10rpx; }
.glyph-recap::after { top: 20rpx; }

.glyph-mine::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 2rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.glyph-mine::after {
  content: "";
  position: absolute;
  left: 6rpx;
  bottom: 1rpx;
  width: 27rpx;
  height: 17rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
  box-sizing: border-box;
}

.compose-button {
  position: absolute;
  left: 50%;
  top: 10rpx;
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  height: 96rpx;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  border-radius: 30rpx;
  color: #FFF8F1;
  background: linear-gradient(145deg, #C85353 0%, #9F3E41 100%);
  box-shadow: 0 16rpx 34rpx rgba(159, 62, 65, .28);
  line-height: 1;
  transform: translateX(-50%);
  box-sizing: border-box;
}

.compose-slot {
  position: relative;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 112rpx;
  overflow: visible;
}

.compose-button:active {
  opacity: .88;
  transform: translateX(-50%) scale(.95);
}

.compose-plus {
  font: 500 36rpx/.8 system-ui, sans-serif;
}

.compose-label {
  font: 700 18rpx/1.1 "PingFang SC", sans-serif;
  letter-spacing: 1rpx;
}

@media (prefers-reduced-motion: no-preference) {
  .tab-item,
  .tab-glyph,
  .compose-button {
    transition:
      transform 180ms cubic-bezier(.22, 1, .36, 1),
      color 180ms ease,
      opacity 180ms ease;
  }

  .tab-item.is-selected .tab-glyph {
    transform: translateY(-2rpx);
  }
}

/* Warm sunset, five stable Flex slots with a dedicated center action. */
.tab-shell {
  height: calc(122rpx + env(safe-area-inset-bottom));
  background: rgba(255, 249, 242, .98);
  border-top-color: rgba(211, 183, 168, .8);
  box-shadow: 0 -16rpx 42rpx rgba(78, 45, 48, .10);
}

.tab-list {
  height: 112rpx;
  padding: 0;
}

.tab-item {
  height: 112rpx;
  padding: 22rpx 0 10rpx;
  color: #8B7976;
}

.tab-item.is-selected {
  color: #A84454;
}

.tab-glyph {
  width: 34rpx;
  height: 34rpx;
}

.glyph-recap::before {
  content: "";
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  top: 5rpx;
  bottom: 5rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  transform: rotate(-5deg);
}

.glyph-recap::after {
  content: "";
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 11rpx;
  height: 3rpx;
  background: currentColor;
  box-shadow: 0 -8rpx 0 currentColor;
}

.glyph-mine::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.glyph-mine::after {
  content: "";
  position: absolute;
  left: 6rpx;
  bottom: 2rpx;
  width: 22rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
}

.compose-button {
  left: 50%;
  top: 10rpx;
  width: 92rpx;
  min-width: 92rpx;
  max-width: 92rpx;
  height: 92rpx;
  border: 4rpx solid #FFF9F2;
  color: #FFF8F2;
  background-color: #B94E5A;
  background-image: linear-gradient(145deg, #D36E65 0%, #B64D5C 62%, #75515F 100%);
  box-shadow: 0 10rpx 24rpx rgba(139, 55, 69, .22);
  transform: translateX(-50%);
}

.compose-button:active {
  transform: translateX(-50%) scale(.96);
}

.compose-plus { font-size: 32rpx; }

.compose-label {
  margin-top: 1rpx;
  font-size: 16rpx;
  letter-spacing: 0;
}
