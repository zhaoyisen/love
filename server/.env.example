# 唯一生产配置：服务器 /opt/love-notes/.env。Jenkins 只读，禁止提交真实值。
# 不要添加 IMAGE_TAG 或 APP_ENV_FILE；版本由发布流程控制。
# 含 $、# 或空格的值使用单引号；不要 source 此文件。
# Docker Compose 项目名称；生产环境保持 love-notes，与发布脚本一致。
COMPOSE_PROJECT_NAME=love-notes
# Spring 运行环境；生产使用 prod，连接真实数据库、Redis 和对象存储。
SPRING_PROFILES_ACTIVE=prod
# API 在容器内监听的端口；修改时需与 Compose 容器端口保持一致。
SERVER_PORT=8080
# 宿主机端口绑定地址；127.0.0.1 仅允许本机访问，通常由本机 Nginx 转发。
SERVER_BIND_ADDRESS=127.0.0.1
# 宿主机对外映射的 API 端口；修改时同步调整反向代理的上游端口。
SERVER_HTTP_PORT=8080
# API 容器内存上限，支持 768m、1g 等容量写法。
APP_MEMORY_LIMIT=768m
# API 容器 CPU 配额；1.0 相当于最多使用一个 CPU 核心的计算能力。
APP_CPU_LIMIT=1.0
# Docker 单个日志文件的轮转大小上限，20m 表示约 20 MB。
LOG_MAX_SIZE=20m
# Docker 日志文件最多保留数量，配合 LOG_MAX_SIZE 控制日志占用。
LOG_MAX_FILES=5
# 应用根日志级别，可选 DEBUG、INFO、WARN、ERROR；生产通常使用 INFO。
LOG_LEVEL_ROOT=INFO
# JVM 启动参数；当前限制最大堆为容器可用内存的 75%，使用 UTF-8 编码和 UTC 时区。
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8 -Duser.timezone=UTC

# MySQL JDBC 连接地址，包含主机、端口、库名及连接参数。
MYSQL_URL=jdbc:mysql://mysql.internal:3306/love_notes?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
# MySQL 登录用户名，需具有应用数据库的读写及迁移权限。
MYSQL_USERNAME=love_notes
# MySQL 登录密码；填写真实值并妥善保管，禁止提交到代码仓库。
MYSQL_PASSWORD=replace_me
# 数据库连接池允许的最大连接数，需结合 MySQL 连接上限调整。
MYSQL_POOL_SIZE=20
# 数据库连接池保持的最小空闲连接数，不应超过最大连接数。
MYSQL_MIN_IDLE=4
# 从数据库连接池获取连接的最长等待时间，单位毫秒；5000 为 5 秒。
MYSQL_CONNECTION_TIMEOUT_MS=5000

# Redis 服务主机名或 IP，必须能从 API 容器访问。
REDIS_HOST=redis.internal
# Redis 服务端口，通常为 6379。
REDIS_PORT=6379
# Redis ACL 用户名；未配置独立用户时可留空。
REDIS_USERNAME=
# Redis 认证密码；无密码时留空，生产建议启用认证。
REDIS_PASSWORD=replace_me
# 是否通过 TLS 连接 Redis；仅在 Redis 服务已启用 TLS 时设为 true。
REDIS_SSL=false
# 是否启用接口限流；生产保持 true。
RATE_LIMIT_ENABLED=true

# 微信小程序 AppID，需与当前发布的小程序一致。
WECHAT_APP_ID=replace_me
# 微信小程序 AppSecret，用于服务端换取登录身份；禁止泄露。
WECHAT_APP_SECRET=replace_me
# 微信登录凭证校验接口地址，通常保持官方 jscode2session 地址。
WECHAT_SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# 腾讯云 COS 存储桶完整名称，包含 APPID 后缀，需与现有媒体所在桶一致。
COS_BUCKET=replace_with_bucket_name
# COS 存储桶所属地域，例如 ap-chengdu，必须与存储桶实际地域一致。
COS_REGION=ap-chengdu
# 腾讯云 API 密钥 SecretId，用于服务端访问 COS 和媒体处理服务。
COS_SECRET_ID=replace_with_tencent_cloud_api_secret_id
# 腾讯云 API 密钥 SecretKey；与 SecretId 配套，禁止泄露。
COS_SECRET_KEY=replace_with_tencent_cloud_api_secret_key
# 列表分页游标的签名密钥，使用至少 32 位随机字符；更换后已有游标失效。
TIMELINE_CURSOR_SECRET=replace_with_at_least_32_random_characters
# 管理端及内部运维凭证原文的 SHA-256 哈希；登录时输入原文，留空则禁用内部运维授权。
INTERNAL_OPERATION_TOKEN_HASH=replace_with_sha256_of_internal_operation_token
# 访问令牌有效期，使用 ISO 8601 时长；PT30M 表示 30 分钟。
SESSION_ACCESS_TTL=PT30M
# 刷新令牌有效期，使用 ISO 8601 时长；P30D 表示 30 天。
SESSION_REFRESH_TTL=P30D
# 情侣配对邀请码有效期，使用 ISO 8601 时长；PT24H 表示 24 小时。
INVITATION_TTL=PT24H
# 网页管理端会话的空闲超时时间；20m 表示连续 20 分钟无操作后过期。
ADMIN_SESSION_TIMEOUT=20m
# 应用优雅关闭时每个关闭阶段的最长等待时间；25s 表示 25 秒。
SHUTDOWN_TIMEOUT=25s
# 后台定时任务线程池大小，过小可能使定时任务排队。
SCHEDULING_POOL_SIZE=2
# 单张图片允许的最大字节数；20971520 为 20 MiB，调整时同步核对小程序限制。
IMAGE_MAX_BYTES=20971520
# 单个视频允许的最大字节数；209715200 为 200 MiB，调整时同步核对小程序限制。
VIDEO_MAX_BYTES=209715200
# 单个视频允许的最长时长，单位秒；调整时同步核对小程序限制。
VIDEO_MAX_DURATION_SECONDS=60
# 媒体上传临时凭证有效期，单位秒；1800 为 30 分钟。
UPLOAD_CREDENTIAL_TTL_SECONDS=1800
# 媒体处理任务每轮执行完成后的等待间隔，单位毫秒；5000 为 5 秒。
MEDIA_PROCESSING_POLL_MS=5000
# 是否启用管理端媒体修复任务的后台执行器；关闭后排队任务不会自动执行。
ADMIN_MEDIA_WORKER_ENABLED=true
# 管理端媒体修复任务每轮执行完成后的等待间隔，单位毫秒；1000 为 1 秒。
ADMIN_MEDIA_POLL_MS=1000
# 媒体清理任务每轮执行完成后的等待间隔，单位毫秒；3600000 为 1 小时。
MEDIA_CLEANUP_POLL_MS=3600000
# 宠物交互日志清理任务每轮执行完成后的等待间隔，单位毫秒；86400000 为 1 天。
PET_LOG_CLEANUP_POLL_MS=86400000
# 每对情侣每天通过关系活动获得的宠物成长值上限，不包含直接喂食、玩耍的成长值。
LOVE_NOTES_PET_RELATIONSHIP_DAILY_CAP=20
# 发布符合条件的双方可见记录所奖励的宠物成长值，受关系活动每日上限约束。
LOVE_NOTES_PET_MOMENT_GROWTH=6
# 对方回应记录所奖励的宠物成长值，受关系活动每日上限约束。
LOVE_NOTES_PET_REACTION_GROWTH=4
# 双方当天均活跃时奖励的宠物成长值，受关系活动每日上限约束。
LOVE_NOTES_PET_BOTH_ACTIVE_GROWTH=6
# 宠物成长规则版本，记录在成长流水中并参与去重；调整规则时统一维护，避免随意修改。
LOVE_NOTES_PET_RULE_VERSION=1
# 宠物按顺序解锁的奖励名称，使用英文逗号分隔；每升 2 级解锁一项。
LOVE_NOTES_PET_UNLOCKS=云朵围巾,星星抱枕,晚安动作,纪念相框,双人烟花
# 账号注销处理任务每轮执行完成后的等待间隔，单位毫秒；600000 为 10 分钟。
ACCOUNT_DELETION_POLL_MS=600000
# 已删除媒体在回收站的保留天数；到期后可被清理任务永久删除。
MEDIA_TRASH_RETENTION_DAYS=30
# 已上传但未关联业务记录的孤立媒体保留时长，单位小时；到期后可被清理。
MEDIA_ORPHAN_RETENTION_HOURS=24
